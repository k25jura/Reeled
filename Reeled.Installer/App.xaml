<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Reeled.Installer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <Color x:Key="AppAccentColor">#FF7B54</Color>
                            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
                            <Color x:Key="BannerBackgroundColor">#121214</Color>
                            <SolidColorBrush x:Key="BannerBackgroundBrush" Color="{StaticResource BannerBackgroundColor}" />
                            <Color x:Key="CardBackground">#1C1C20</Color>
                            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}" />
                            <Color x:Key="CardBorder">#2C2C32</Color>
                            <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorder}" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <Color x:Key="AppAccentColor">#E05638</Color>
                            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
                            <Color x:Key="BannerBackgroundColor">#F3F3F5</Color>
                            <SolidColorBrush x:Key="BannerBackgroundBrush" Color="{StaticResource BannerBackgroundColor}" />
                            <Color x:Key="CardBackground">#FFFFFF</Color>
                            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}" />
                            <Color x:Key="CardBorder">#E5E5EA</Color>
                            <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorder}" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
