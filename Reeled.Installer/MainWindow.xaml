<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Reeled.Installer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Reeled Setup">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <!-- Left Hero Banner -->
            <ColumnDefinition Width="220" />
            <!-- Right Content Pane -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Custom TitleBar drag region (extends across top, leaving right 140px for OS caption buttons) -->
        <Border x:Name="AppTitleBar" 
                Grid.ColumnSpan="2"
                Height="36" 
                VerticalAlignment="Top" 
                HorizontalAlignment="Stretch" 
                Background="Transparent" 
                Margin="0,0,140,0" 
                Canvas.ZIndex="10" />

        <!-- 1. LEFT HERO BANNER -->
        <Border Grid.Column="0" 
                Background="{ThemeResource BannerBackgroundBrush}" 
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" 
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Branding Header -->
                <StackPanel Grid.Row="0" Margin="24,36,24,20" Spacing="10">
                    <Image Source="ms-appx:///Assets/reeled.png" 
                           Width="44" Height="44" 
                           HorizontalAlignment="Left" />
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="BannerAppTitle" 
                                   Text="Reeled" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="BannerVersionText" 
                                   Text="v1.0.0" 
                                   FontSize="12" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Root with Sliding Active Handle Animation -->
                <Grid x:Name="StepsNavRoot" Grid.Row="1" Margin="16,8,16,0" VerticalAlignment="Top">
                    <!-- Sliding Active Selection Indicator Pill (Matching main page and settings sidebar) -->
                    <Border x:Name="ActiveIndicatorPill"
                            Width="3"
                            Height="18"
                            CornerRadius="1.5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="IndicatorTranslation" Y="0" />
                                <ScaleTransform x:Name="IndicatorScale" ScaleY="0" CenterY="9" />
                            </TransformGroup>
                        </Border.RenderTransform>
                    </Border>

                    <!-- Steps Stack -->
                    <StackPanel x:Name="StepsStackPanel" Spacing="4" Margin="10,0,0,0">
                        <!-- Step 1: Welcome -->
                        <Grid x:Name="StepRow1" Height="36" Padding="6,0" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="StepIcon1" Glyph="&#xE80F;" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock x:Name="StepLabel1" Grid.Column="1" Text="Welcome" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>

                        <!-- Step 2: Options -->
                        <Grid x:Name="StepRow2" Height="36" Padding="6,0" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="StepIcon2" Glyph="&#xE713;" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock x:Name="StepLabel2" Grid.Column="1" Text="Options" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>

                        <!-- Step 3: Installing -->
                        <Grid x:Name="StepRow3" Height="36" Padding="6,0" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="StepIcon3" Glyph="&#xE896;" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock x:Name="StepLabel3" Grid.Column="1" Text="Installing" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>

                        <!-- Step 4: Finished -->
                        <Grid x:Name="StepRow4" Height="36" Padding="6,0" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="StepIcon4" Glyph="&#xE73E;" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock x:Name="StepLabel4" Grid.Column="1" Text="Finished" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Left Footer Note -->
                <TextBlock Grid.Row="2" 
                           Margin="24,0,24,20" 
                           Text="Reeled by k25jura" 
                           FontSize="11" 
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Border>

        <!-- 2. RIGHT CONTENT PANE -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Titlebar / Header -->
                <RowDefinition Height="Auto" />
                <!-- Step Content Body -->
                <RowDefinition Height="*" />
                <!-- Bottom Action Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Step Header (Title & Subtitle + Theme Toggle in top-right) -->
            <Grid Grid.Row="0" Margin="32,32,24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="StepHeaderTitle" 
                               Text="Welcome to Reeled" 
                               FontSize="20" 
                               FontWeight="SemiBold" 
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="StepHeaderSubtitle" 
                               Text="A local player and library manager for gameplay clips and recordings." 
                               FontSize="13" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Theme Toggle Button -->
                <Button x:Name="ThemeToggleButton" 
                        Grid.Column="1" 
                        Click="OnThemeToggleClicked" 
                        ToolTipService.ToolTip="Toggle Theme" 
                        Style="{ThemeResource SubtleButtonStyle}" 
                        Padding="6" 
                        CornerRadius="6"
                        VerticalAlignment="Top" 
                        Margin="8,0,0,0">
                    <FontIcon x:Name="ThemeIcon" Glyph="&#xE708;" FontSize="14" />
                </Button>
            </Grid>

            <!-- Step Views Container (with RenderTransform for Apple-like smooth bezier glide) -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="32,0,32,12">
                <Grid x:Name="StepContentContainer">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="StepContentTransform" Y="0" />
                    </Grid.RenderTransform>

                    <!-- STEP 1: WELCOME & ONBOARDING -->
                    <StackPanel x:Name="WelcomeStepPanel" Visibility="Visible" Spacing="10">
                        <!-- Card 1: Library (Settings container style from main app, no icon background) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="Feature1Title" Text="Library &amp; Folders" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="13.5" />
                                    <TextBlock x:Name="Feature1Desc" Text="Watches your recording folders and organizes clips with quick date filtering and search." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 2: Player (Settings container style from main app, no icon background) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="Feature2Title" Text="Direct3D11 Player" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="13.5" />
                                    <TextBlock x:Name="Feature2Desc" Text="Hardware-accelerated playback with timeline scrubbing, audio track mixing, and frame stepping." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 3: Moments (Settings container style from main app, no icon background) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7C1;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="Feature3Title" Text="Clip Bookmarks" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="13.5" />
                                    <TextBlock x:Name="Feature3Desc" Text="Pin timestamps on the timeline to bookmark moments and jump between them in the drawer." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Language Selector Row -->
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="LanguageLabel" Text="Language:" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="LanguageComboBox" Width="150" CornerRadius="6" SelectionChanged="OnLanguageSelectionChanged">
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="Українська" Tag="uk" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- STEP 2: INSTALL OPTIONS -->
                    <StackPanel x:Name="OptionsStepPanel" Visibility="Collapsed" Spacing="16">
                        <!-- Destination Directory -->
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="DestinationFolderLabel" Text="Destination Folder:" FontSize="13" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox x:Name="InstallPathTextBox" CornerRadius="6" TextChanged="OnInstallPathTextChanged" VerticalAlignment="Center" />
                                <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." CornerRadius="6" Click="OnBrowseClicked" VerticalAlignment="Center" />
                            </Grid>
                            <!-- Disk Space Indicator -->
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="2,4,0,0">
                                <TextBlock x:Name="SpaceRequiredText" Text="Space required: ~220 MB" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="SpaceAvailableText" Text="Space available: 100 GB" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- System Integration Checkboxes (Restored rounded WinUI 3 checkboxes) -->
                        <StackPanel Spacing="10" Margin="0,4,0,0">
                            <CheckBox x:Name="DesktopShortcutCheckBox" 
                                      Content="Create a Desktop shortcut" 
                                      IsChecked="True" />
                            <CheckBox x:Name="StartMenuShortcutCheckBox" 
                                      Content="Add to Start Menu" 
                                      IsChecked="True" />
                            <CheckBox x:Name="VideoAssociationCheckBox" 
                                      Content="Register in Windows 'Open with' context menu for video files" 
                                      IsChecked="True" />
                        </StackPanel>
                    </StackPanel>

                    <!-- STEP 3: INSTALLING PROGRESS -->
                    <Grid x:Name="InstallingStepPanel" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,40,0,0">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                                <ProgressRing x:Name="InstallProgressRing" IsActive="True" Width="24" Height="24" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="InstallingStatusText" 
                                           Text="Preparing installation..." 
                                           FontSize="13" 
                                           VerticalAlignment="Center" 
                                           TextWrapping="Wrap"
                                           MaxWidth="460"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>

                            <!-- Smooth Progress Bar -->
                            <ProgressBar x:Name="InstallProgressBar" 
                                         Maximum="100" 
                                         Value="0" 
                                         Height="6" 
                                         CornerRadius="3" 
                                         Foreground="{ThemeResource AccentFillColorDefaultBrush}" 
                                         Margin="24,0" />

                            <TextBlock x:Name="InstallPercentageText" 
                                       Text="0%" 
                                       FontSize="12" 
                                       HorizontalAlignment="Center" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- STEP 4: FINISHED -->
                    <Grid x:Name="FinishedStepPanel" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,28,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                            <!-- Success Badge -->
                            <Border Width="48" Height="48" 
                                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="24" 
                                    HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock x:Name="FinishedTitleText" 
                                           Text="Installation Complete" 
                                           FontSize="18" 
                                           FontWeight="SemiBold" 
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="FinishedSubtitleText" 
                                           Text="Reeled has been successfully installed on your computer." 
                                           FontSize="13" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <CheckBox x:Name="LaunchAppCheckBox" 
                                      Content="Launch Reeled now" 
                                      IsChecked="True" 
                                      HorizontalAlignment="Center" 
                                      Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- Bottom Action Bar -->
            <Border Grid.Row="2" 
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" 
                    BorderThickness="0,1,0,0" 
                    Padding="32,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button x:Name="BackButton" 
                                Content="&lt; Back" 
                                Click="OnBackClicked" 
                                IsEnabled="False" 
                                MinWidth="90" 
                                Padding="14,6" 
                                CornerRadius="6" />
                        <Button x:Name="NextButton" 
                                Content="Next &gt;" 
                                Click="OnNextClicked" 
                                Style="{ThemeResource AccentButtonStyle}" 
                                MinWidth="100" 
                                Padding="16,6" 
                                CornerRadius="6" />
                        <Button x:Name="CancelButton" 
                                Content="Cancel" 
                                Click="OnCancelClicked" 
                                MinWidth="100" 
                                Padding="16,6" 
                                CornerRadius="6" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
