<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Reeled.Installer.Views.UninstallWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Reeled Uninstaller">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- Content Area -->
            <RowDefinition Height="*" />
            <!-- Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main Body -->
        <Grid Grid.Row="0" Margin="32,28,32,16">

            <!-- Confirmation Panel (Step 1) -->
            <StackPanel x:Name="ConfirmPanel" Spacing="16" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Image Source="ms-appx:///Assets/reeled.png" Width="48" Height="48" VerticalAlignment="Center" />
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="Uninstall Reeled" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="SubtitleText" Text="Are you sure you want to completely remove Reeled from your computer?" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <Border Background="{ThemeResource CardBackgroundBrush}" 
                        BorderBrush="{ThemeResource CardBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="16,12" 
                        Margin="0,8,0,0">
                    <CheckBox x:Name="WipeUserDataCheckBox" 
                              Content="Remove application settings and clip metadata cache" 
                              IsChecked="False" />
                </Border>
            </StackPanel>

            <!-- Progress Panel (Step 2) -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Spacing="16" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <ProgressRing IsActive="True" Width="24" Height="24" Foreground="{ThemeResource AppAccentBrush}" />
                    <TextBlock x:Name="ProgressStatusText" Text="Removing files..." FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
                <ProgressBar x:Name="UninstallProgressBar" Maximum="100" Value="0" Height="8" CornerRadius="4" Foreground="{ThemeResource AppAccentBrush}" Margin="16,0" />
            </StackPanel>

            <!-- Finished Panel (Step 3) -->
            <StackPanel x:Name="FinishedPanel" Visibility="Collapsed" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="56" Height="56" Background="{ThemeResource AppAccentBrush}" CornerRadius="28" HorizontalAlignment="Center" Opacity="0.15">
                    <FontIcon Glyph="&#xE73E;" FontSize="24" Foreground="{ThemeResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock x:Name="DoneTitleText" Text="Uninstallation Complete" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="DoneSubtitleText" Text="Reeled has been successfully removed from your computer." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="1" 
                BorderBrush="{ThemeResource CardBorderBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="32,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="UninstallButton" 
                        Content="Uninstall" 
                        Click="OnUninstallClicked" 
                        Style="{ThemeResource AccentButtonStyle}" 
                        Width="96" />
                <Button x:Name="CancelButton" 
                        Content="Cancel" 
                        Click="OnCancelClicked" 
                        Width="84" />
                <Button x:Name="CloseButton" 
                        Content="Close" 
                        Click="OnCloseClicked" 
                        Visibility="Collapsed" 
                        Width="84" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
