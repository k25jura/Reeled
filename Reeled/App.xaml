<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Reeled.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Reeled.Converters"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    xmlns:local="using:Reeled">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 1. Default WinUI Controls Resources -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!-- 2. Custom Theme Overrides (Must be merged AFTER XamlControlsResources so they take precedence) -->
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <!-- Update indicator: always Windows blue, independent of the accent colour -->
                            <SolidColorBrush x:Key="UpdateAccentBrush" Color="#4CC2FF" />
                            <Color x:Key="SolidBackgroundFillColorBase">#101010</Color>
                            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource SolidBackgroundFillColorBase}" />

                            <Color x:Key="ApplicationPageBackgroundThemeColor">#101010</Color>
                            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource ApplicationPageBackgroundThemeColor}" />

                            <Color x:Key="LayerFillColorDefault">#161616</Color>
                            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource LayerFillColorDefault}" />

                            <Color x:Key="LayerFillColorAlt">#121212</Color>
                            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource LayerFillColorAlt}" />

                            <Color x:Key="CardBackgroundFillColorDefault">#1C1C1C</Color>
                            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource CardBackgroundFillColorDefault}" />

                            <Color x:Key="CardBackgroundFillColorSecondary">#222222</Color>
                            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource CardBackgroundFillColorSecondary}" />

                            <Color x:Key="CardStrokeColorDefault">#282828</Color>
                            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource CardStrokeColorDefault}" />

                            <Color x:Key="DividerStrokeColorDefault">#242424</Color>
                            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource DividerStrokeColorDefault}" />

                            <Color x:Key="ControlFillColorDefault">#1C1C1C</Color>
                            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource ControlFillColorDefault}" />

                            <Color x:Key="ControlFillColorSecondary">#222222</Color>
                            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource ControlFillColorSecondary}" />

                            <Color x:Key="ControlStrokeColorDefault">#2A2A2A</Color>
                            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource ControlStrokeColorDefault}" />

                            <Color x:Key="SubtleFillColorSecondary">#222222</Color>
                            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource SubtleFillColorSecondary}" />

                            <Color x:Key="SubtleFillColorTertiary">#2A2A2A</Color>
                            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource SubtleFillColorTertiary}" />

                            <Color x:Key="TextFillColorPrimary">#EDEDED</Color>
                            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextFillColorPrimary}" />

                            <Color x:Key="TextFillColorSecondary">#8E8E93</Color>
                            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextFillColorSecondary}" />

                            <Color x:Key="TextFillColorTertiary">#666666</Color>
                            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource TextFillColorTertiary}" />

                            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/DidactGothic-Regular.ttf#Didact Gothic, Segoe UI Variable Text, Segoe UI</FontFamily>
                        </ResourceDictionary>

                        <ResourceDictionary x:Key="Dark">
                            <!-- Update indicator: always Windows blue, independent of the accent colour -->
                            <SolidColorBrush x:Key="UpdateAccentBrush" Color="#4CC2FF" />
                            <Color x:Key="SolidBackgroundFillColorBase">#101010</Color>
                            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource SolidBackgroundFillColorBase}" />

                            <Color x:Key="ApplicationPageBackgroundThemeColor">#101010</Color>
                            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource ApplicationPageBackgroundThemeColor}" />

                            <Color x:Key="LayerFillColorDefault">#161616</Color>
                            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource LayerFillColorDefault}" />

                            <Color x:Key="LayerFillColorAlt">#121212</Color>
                            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource LayerFillColorAlt}" />

                            <Color x:Key="CardBackgroundFillColorDefault">#1C1C1C</Color>
                            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource CardBackgroundFillColorDefault}" />

                            <Color x:Key="CardBackgroundFillColorSecondary">#222222</Color>
                            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource CardBackgroundFillColorSecondary}" />

                            <Color x:Key="CardStrokeColorDefault">#282828</Color>
                            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource CardStrokeColorDefault}" />

                            <Color x:Key="DividerStrokeColorDefault">#242424</Color>
                            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource DividerStrokeColorDefault}" />

                            <Color x:Key="ControlFillColorDefault">#1C1C1C</Color>
                            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource ControlFillColorDefault}" />

                            <Color x:Key="ControlFillColorSecondary">#222222</Color>
                            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource ControlFillColorSecondary}" />

                            <Color x:Key="ControlStrokeColorDefault">#2A2A2A</Color>
                            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource ControlStrokeColorDefault}" />

                            <Color x:Key="SubtleFillColorSecondary">#222222</Color>
                            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource SubtleFillColorSecondary}" />

                            <Color x:Key="SubtleFillColorTertiary">#2A2A2A</Color>
                            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource SubtleFillColorTertiary}" />

                            <Color x:Key="TextFillColorPrimary">#EDEDED</Color>
                            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextFillColorPrimary}" />

                            <Color x:Key="TextFillColorSecondary">#8E8E93</Color>
                            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextFillColorSecondary}" />

                            <Color x:Key="TextFillColorTertiary">#666666</Color>
                            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource TextFillColorTertiary}" />

                            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/DidactGothic-Regular.ttf#Didact Gothic, Segoe UI Variable Text, Segoe UI</FontFamily>
                        </ResourceDictionary>

                        <ResourceDictionary x:Key="Light">
                            <!-- Update indicator: always Windows blue, independent of the accent colour -->
                            <SolidColorBrush x:Key="UpdateAccentBrush" Color="#005FB8" />
                            <Color x:Key="SolidBackgroundFillColorBase">#F0F0F3</Color>
                            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource SolidBackgroundFillColorBase}" />

                            <Color x:Key="ApplicationPageBackgroundThemeColor">#F4F4F6</Color>
                            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource ApplicationPageBackgroundThemeColor}" />

                            <Color x:Key="LayerFillColorDefault">#FFFFFF</Color>
                            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource LayerFillColorDefault}" />

                            <Color x:Key="LayerFillColorAlt">#F8F8FA</Color>
                            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource LayerFillColorAlt}" />

                            <Color x:Key="CardBackgroundFillColorDefault">#FFFFFF</Color>
                            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource CardBackgroundFillColorDefault}" />

                            <Color x:Key="CardBackgroundFillColorSecondary">#F8F8FA</Color>
                            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource CardBackgroundFillColorSecondary}" />

                            <Color x:Key="CardStrokeColorDefault">#E5E5EA</Color>
                            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource CardStrokeColorDefault}" />

                            <Color x:Key="DividerStrokeColorDefault">#E5E5EA</Color>
                            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource DividerStrokeColorDefault}" />

                            <Color x:Key="ControlFillColorDefault">#FFFFFF</Color>
                            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource ControlFillColorDefault}" />

                            <Color x:Key="ControlFillColorSecondary">#F4F4F6</Color>
                            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource ControlFillColorSecondary}" />

                            <Color x:Key="ControlStrokeColorDefault">#E5E5EA</Color>
                            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource ControlStrokeColorDefault}" />

                            <Color x:Key="SubtleFillColorSecondary">#EFEFF2</Color>
                            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource SubtleFillColorSecondary}" />

                            <Color x:Key="SubtleFillColorTertiary">#E4E4E8</Color>
                            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource SubtleFillColorTertiary}" />

                            <Color x:Key="TextFillColorPrimary">#1A1A1A</Color>
                            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextFillColorPrimary}" />

                            <Color x:Key="TextFillColorSecondary">#5C5C60</Color>
                            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextFillColorSecondary}" />

                            <Color x:Key="TextFillColorTertiary">#8A8A8E</Color>
                            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource TextFillColorTertiary}" />

                            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/DidactGothic-Regular.ttf#Didact Gothic, Segoe UI Variable Text, Segoe UI</FontFamily>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Global font: Didact Gothic (OFL, Latin and Cyrillic); Segoe UI covers anything it lacks -->
            <FontFamily x:Key="AppFontFamily">ms-appx:///Assets/Fonts/DidactGothic-Regular.ttf#Didact Gothic, Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/DidactGothic-Regular.ttf#Didact Gothic, Segoe UI Variable Text, Segoe UI</FontFamily>

            <!-- Standard Typography Styles using Didact Gothic -->
            <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <!-- Re-declared here because this style replaces the WinUI one, which carries the primary text colour -->
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="{StaticResource BodyTextBlockFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineStackingStrategy" Value="MaxHeight" />
                <Setter Property="TextLineBounds" Value="Full" />
            </Style>
            <Style x:Key="HeaderTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="46" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SubheaderTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="34" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource TitleTextBlockFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="TitleLargeTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource TitleLargeTextBlockFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource SubtitleTextBlockFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource BodyStrongTextBlockFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style x:Key="DisplayTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource DisplayTextBlockFontSize}" />
            </Style>

            <!-- Implicit Styles for the app font -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
            <Style TargetType="Page">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <!-- Text without its own colour inherits it from the page, so it follows the page's theme -->
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style TargetType="RichTextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>

            <!-- One menu look everywhere (sort, view, context, text-box menus): app font, roomy rows,
                 Windows 11 radii. Code-built presenter styles derive from ReeledMenuFlyoutPresenterStyle. -->
            <Style x:Key="ReeledMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="MinWidth" Value="180" />
            </Style>
            <Style TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource ReeledMenuFlyoutPresenterStyle}" />
            <Style TargetType="MenuFlyoutItem" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="11,8,11,9" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style TargetType="ToggleMenuFlyoutItem" BasedOn="{StaticResource DefaultToggleMenuFlyoutItemStyle}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="11,8,11,9" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style TargetType="MenuFlyoutSubItem" BasedOn="{StaticResource DefaultMenuFlyoutSubItemStyle}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="11,8,11,9" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:PlayPauseGlyphConverter x:Key="PlayPauseGlyphConverter" />
            <converters:VolumeGlyphConverter x:Key="VolumeGlyphConverter" />
            <converters:FavoriteGlyphConverter x:Key="FavoriteGlyphConverter" />
            <converters:FavoriteOpacityConverter x:Key="FavoriteOpacityConverter" />
            <converters:FavoriteForegroundConverter x:Key="FavoriteForegroundConverter" />
            <converters:FavoriteHostOpacityConverter x:Key="FavoriteHostOpacityConverter" />
            <converters:SectionActiveBackgroundConverter x:Key="SectionActiveBackgroundConverter" />
            <converters:SectionActiveForegroundConverter x:Key="SectionActiveForegroundConverter" />
            <converters:SectionActiveFontWeightConverter x:Key="SectionActiveFontWeightConverter" />
            <converters:SliderTimestampTooltipConverter x:Key="SliderTimestampTooltipConverter" />
            <converters:HexToBrushConverter x:Key="HexToBrushConverter" />

            <!-- SplitView Custom Animation Durations for Smooth Windows 11 Transitions -->
            <x:String x:Key="SplitViewPaneAnimationOpenDuration">00:00:00.3</x:String>
            <x:String x:Key="SplitViewPaneAnimationOpenPreDuration">00:00:00.29999</x:String>
            <x:String x:Key="SplitViewPaneAnimationCloseDuration">00:00:00.3</x:String>

            <!-- LibVLCSharp VideoView Default Style for Unpackaged WinUI 3 -->
            <Style x:Key="VideoViewDefaultStyle" TargetType="vlc:VideoView">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="vlc:VideoView">
                            <SwapChainPanel x:Name="SwapChainPanel" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="vlc:VideoView" BasedOn="{StaticResource VideoViewDefaultStyle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
