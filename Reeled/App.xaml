<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Reeled.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Reeled.Converters"
    xmlns:local="using:Reeled">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:PlayPauseGlyphConverter x:Key="PlayPauseGlyphConverter" />
            <converters:VolumeGlyphConverter x:Key="VolumeGlyphConverter" />
            <converters:FavoriteGlyphConverter x:Key="FavoriteGlyphConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
