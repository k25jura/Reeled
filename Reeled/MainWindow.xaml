<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Reeled.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Reeled"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Reeled.Views"
    Title="Reeled"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid MinWidth="760" MinHeight="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Reeled">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Library / Settings Content Frame -->
        <Frame x:Name="RootFrame" Grid.Row="1" />

        <!-- Telegram-style In-App Media Player Overlay (Persistent so DirectX SwapChain & LibVLC are never destroyed) -->
        <Grid x:Name="PlayerOverlayContainer" Grid.Row="1" Visibility="Collapsed">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="40" />
                </TransitionCollection>
            </Grid.ChildrenTransitions>
            <views:PlayerPage x:Name="PlayerViewControl" />
        </Grid>
    </Grid>
</Window>
