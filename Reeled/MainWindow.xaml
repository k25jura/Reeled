<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Reeled.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Reeled"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Reeled.Views"
    Title="Reeled"
    mc:Ignorable="d">

    <!-- Zoom host: the whole interface is scaled inside it (Ctrl + / Ctrl - / Ctrl 0, see ApplyZoom) -->
    <Grid x:Name="ZoomHost" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" SizeChanged="OnZoomHostSizeChanged">
    <Grid x:Name="RootWindowGrid" 
          MinWidth="760" 
          MinHeight="500" 
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          AllowDrop="True"
          DragEnter="OnRootWindowDragEnter"
          DragLeave="OnRootWindowDragLeave"
          Drop="OnRootWindowDrop">
        <!-- Solid background transition layer for video playback -->
        <Border x:Name="PlayerBackdropLayer" 
                Background="#101010" 
                Opacity="0" 
                IsHitTestVisible="False" />

        <!-- Library / Settings Content Frame (fills the entire window so sidebar extends fully upwards) -->
        <Frame x:Name="RootFrame" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <!-- Integrated TitleBar drag region (leaves top-left 48px free for sidebar hamburger button and top-right 140px for OS caption buttons) -->
        <Border x:Name="AppTitleBar" 
                VerticalAlignment="Top" 
                Background="Transparent" 
                Height="36" 
                Margin="48,0,140,0" />

        <!-- Telegram-style In-App Media Player Overlay (Spans entire window, always Dark theme) -->
        <Grid x:Name="PlayerOverlayContainer" 
              RequestedTheme="Dark"
              Visibility="Collapsed" 
              Opacity="0">
            <views:PlayerPage x:Name="PlayerViewControl" RequestedTheme="Dark" Foreground="White" />
        </Grid>

        <!-- Drag and drop dimming and dashed frame overlay -->
        <Grid x:Name="DropOverlayContainer"
              Canvas.ZIndex="999"
              Visibility="Collapsed"
              Opacity="0"
              AllowDrop="True"
              Background="#D9000000"
              DragEnter="OnRootWindowDragEnter"
              DragLeave="OnRootWindowDragLeave"
              Drop="OnRootWindowDrop">
            <!-- Two drop zones: Open (play it) and Add to library. Brushes are set in code (accent / success tones, animated) -->
            <StackPanel x:Name="DropContentCard"
                        Orientation="Horizontal"
                        Spacing="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="DropContentScale" ScaleX="0.94" ScaleY="0.94" />
                </StackPanel.RenderTransform>

                <Grid x:Name="OpenZone" Width="270" Height="220">
                    <Rectangle x:Name="OpenZoneRect" RadiusX="18" RadiusY="18" StrokeThickness="2" StrokeDashArray="5,3.5"
                               Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                    <Border x:Name="OpenZoneTint" CornerRadius="18" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Padding="24">
                        <Border x:Name="OpenZoneBadge" Width="60" Height="60" CornerRadius="30" HorizontalAlignment="Center">
                            <FontIcon x:Name="OpenZoneIcon" Glyph="&#xE768;" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock x:Name="OpenZoneTitle" Text="Open" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="OpenZoneSubtitle" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="210" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid x:Name="AddZone" Width="270" Height="220">
                    <Rectangle x:Name="AddZoneRect" RadiusX="18" RadiusY="18" StrokeThickness="2" StrokeDashArray="5,3.5"
                               Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                    <Border x:Name="AddZoneTint" CornerRadius="18" />
                    <StackPanel x:Name="AddZoneContent" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Padding="24">
                        <Border x:Name="AddZoneBadge" Width="60" Height="60" CornerRadius="30" HorizontalAlignment="Center">
                            <FontIcon x:Name="AddZoneIcon" Glyph="&#xE710;" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock x:Name="AddZoneTitle" Text="Add to library" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="AddZoneSubtitle" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="210" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Floating drag caption that follows the pointer (replaces the system caption while over the window) -->
        <Grid x:Name="DragPillHost"
              Canvas.ZIndex="1000"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              IsHitTestVisible="False"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="DragPillMove" />
            </Grid.RenderTransform>
            <Border x:Name="DragPill"
                    CornerRadius="10"
                    Padding="10,7,14,7"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    Opacity="0"
                    RenderTransformOrigin="0,0">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="DragPillScale" ScaleX="0.9" ScaleY="0.9" />
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="DragPillIcon" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock x:Name="DragPillText" FontSize="13" MaxWidth="320" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

    <!-- Zoom level indicator (Ctrl + / Ctrl -), outside the scaled tree so it keeps its size -->
    <Border x:Name="ZoomIndicator"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,44,0,0"
            Padding="16,6,6,6"
            CornerRadius="8"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            Visibility="Collapsed"
            Opacity="0"
            PointerEntered="OnZoomIndicatorPointerEntered"
            PointerExited="OnZoomIndicatorPointerExited">
        <Border.RenderTransform>
            <TranslateTransform x:Name="ZoomIndicatorTranslation" Y="-8" />
        </Border.RenderTransform>
        <StackPanel Orientation="Horizontal" Spacing="4">
            <FontIcon Glyph="&#xE71E;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock x:Name="ZoomIndicatorText" Text="100%" FontSize="13" FontWeight="SemiBold" MinWidth="42" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <Button x:Name="ZoomOutIndicatorButton" Click="OnZoomOutIndicatorClick" Style="{ThemeResource SubtleButtonStyle}" Width="30" Height="28" Padding="0">
                <FontIcon Glyph="&#xE738;" FontSize="11" />
            </Button>
            <Button x:Name="ZoomInIndicatorButton" Click="OnZoomInIndicatorClick" Style="{ThemeResource SubtleButtonStyle}" Width="30" Height="28" Padding="0">
                <FontIcon Glyph="&#xE710;" FontSize="11" />
            </Button>
            <Button x:Name="ZoomResetIndicatorButton" Click="OnZoomResetIndicatorClick" Padding="10,4" FontSize="12" Margin="4,0,0,0" Content="Reset" />
        </StackPanel>
    </Border>
    </Grid>
</Window>
