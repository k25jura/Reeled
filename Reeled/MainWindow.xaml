<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Reeled.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Reeled"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Reeled.Views"
    Title="Reeled"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootWindowGrid" MinWidth="760" MinHeight="500">
        <!-- Solid background transition layer for video playback -->
        <Border x:Name="PlayerBackdropLayer" 
                Background="#08080A" 
                Opacity="0" 
                IsHitTestVisible="False" />

        <!-- Library / Settings Content Frame (fills the entire window so sidebar extends fully upwards) -->
        <Frame x:Name="RootFrame" />

        <!-- Integrated TitleBar drag region (leaves top-left 48px free for sidebar hamburger button and top-right 140px for OS caption buttons) -->
        <Border x:Name="AppTitleBar" 
                VerticalAlignment="Top" 
                Background="Transparent" 
                Height="36" 
                Margin="48,0,140,0" />

        <!-- Telegram-style In-App Media Player Overlay (Spans entire window) -->
        <Grid x:Name="PlayerOverlayContainer" 
              Visibility="Collapsed" 
              Opacity="0">
            <views:PlayerPage x:Name="PlayerViewControl" />
        </Grid>
    </Grid>
</Window>
