<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Reeled.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Reeled"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Reeled.Views"
    Title="Reeled"
    mc:Ignorable="d">

    <Grid x:Name="RootWindowGrid" 
          MinWidth="760" 
          MinHeight="500" 
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          AllowDrop="True"
          DragEnter="OnRootWindowDragEnter"
          DragOver="OnRootWindowDragOver"
          DragLeave="OnRootWindowDragLeave"
          Drop="OnRootWindowDrop">
        <!-- Solid background transition layer for video playback -->
        <Border x:Name="PlayerBackdropLayer" 
                Background="#101010" 
                Opacity="0" 
                IsHitTestVisible="False" />

        <!-- Library / Settings Content Frame (fills the entire window so sidebar extends fully upwards) -->
        <Frame x:Name="RootFrame" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <!-- Integrated TitleBar drag region (leaves top-left 48px free for sidebar hamburger button and top-right 140px for OS caption buttons) -->
        <Border x:Name="AppTitleBar" 
                VerticalAlignment="Top" 
                Background="Transparent" 
                Height="36" 
                Margin="48,0,140,0" />

        <!-- Telegram-style In-App Media Player Overlay (Spans entire window, always Dark theme) -->
        <Grid x:Name="PlayerOverlayContainer" 
              RequestedTheme="Dark"
              Visibility="Collapsed" 
              Opacity="0">
            <views:PlayerPage x:Name="PlayerViewControl" RequestedTheme="Dark" />
        </Grid>

        <!-- Drag and drop dimming and dashed frame overlay -->
        <Grid x:Name="DropOverlayContainer"
              Canvas.ZIndex="999"
              Visibility="Collapsed"
              Opacity="0"
              AllowDrop="True"
              Background="#D9000000"
              DragEnter="OnRootWindowDragEnter"
              DragOver="OnRootWindowDragOver"
              DragLeave="OnRootWindowDragLeave"
              Drop="OnRootWindowDrop">
            <Grid x:Name="DropContentCard"
                  Width="480"
                  Height="230"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="DropContentScale" ScaleX="0.94" ScaleY="0.94" />
                </Grid.RenderTransform>

                <!-- Dashed border frame with solid card fill -->
                <Rectangle RadiusX="18" RadiusY="18"
                           Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                           StrokeThickness="2"
                           StrokeDashArray="5,3.5"
                           Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}" />

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Padding="32">
                    <!-- Icon badge with subtle accent background -->
                    <Border Width="60" Height="60"
                            CornerRadius="30"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Opacity="0.15"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8E5;"
                                  FontSize="26"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock x:Name="DropOverlayTitleText"
                                   Text="Drop files here"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="DropOverlaySubtitleText"
                                   Text="Drop video files to play immediately, or folders to add to library"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="380"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
