<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Reeled.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Reeled.Models"
    xmlns:viewmodels="using:Reeled.ViewModels"
    xmlns:controls="using:Reeled.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Smooth Navigation Tab Button Style -->
        <Style x:Key="NavTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="6">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition From="Normal" To="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuarticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                        <VisualTransition From="PointerOver" To="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuarticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Target="HoverBorder.Opacity" Value="0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverBorder.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverBorder.Opacity" Value="0.7" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <!-- Hover highlight matching folder tree -->
                            <Border x:Name="HoverBorder"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6"
                                    Opacity="0"
                                    IsHitTestVisible="False" />

                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Windows 11 TreeViewItem Style with Smooth Selection Indicator & Background Transitions -->
        <Style x:Key="CustomTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid x:Name="ContentPresenterGrid"
                               Background="Transparent"
                               CornerRadius="6"
                               MinHeight="0"
                               Margin="0,0,16,0"
                               Padding="0"
                               PointerPressed="OnFolderRowPointerPressed"
                               PointerReleased="OnFolderRowPointerReset"
                               PointerCanceled="OnFolderRowPointerReset">

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition From="Normal" To="Selected">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectedBackgroundBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SelectionIndicatorScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.20">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                        <VisualTransition From="PointerOver" To="Selected">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectedBackgroundBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SelectionIndicatorScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.20">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                        <VisualTransition From="Selected" To="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectedBackgroundBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SelectionIndicatorScale" Storyboard.TargetProperty="ScaleY" To="0.0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                        <VisualTransition From="Selected" To="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectedBackgroundBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SelectionIndicatorScale" Storyboard.TargetProperty="ScaleY" To="0.0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                        <VisualTransition From="Normal" To="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBackgroundBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualTransition>
                                        <VisualTransition From="PointerOver" To="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBackgroundBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>

                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Target="SelectedBackgroundBorder.Opacity" Value="0" />
                                            <Setter Target="HoverBackgroundBorder.Opacity" Value="0" />
                                            <Setter Target="SelectionIndicator.Opacity" Value="0" />
                                            <Setter Target="SelectionIndicatorScale.ScaleY" Value="0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="SelectedBackgroundBorder.Opacity" Value="0" />
                                            <Setter Target="HoverBackgroundBorder.Opacity" Value="1" />
                                            <Setter Target="SelectionIndicator.Opacity" Value="0" />
                                            <Setter Target="SelectionIndicatorScale.ScaleY" Value="0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="SelectedBackgroundBorder.Opacity" Value="0" />
                                            <Setter Target="HoverBackgroundBorder.Opacity" Value="0.8" />
                                            <Setter Target="SelectionIndicator.Opacity" Value="0" />
                                            <Setter Target="SelectionIndicatorScale.ScaleY" Value="0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="SelectedBackgroundBorder.Opacity" Value="1" />
                                            <Setter Target="HoverBackgroundBorder.Opacity" Value="0" />
                                            <Setter Target="SelectionIndicator.Opacity" Value="1" />
                                            <Setter Target="SelectionIndicatorScale.ScaleY" Value="1.0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="SelectedBackgroundBorder.Opacity" Value="1" />
                                            <Setter Target="HoverBackgroundBorder.Opacity" Value="0.4" />
                                            <Setter Target="SelectionIndicator.Opacity" Value="1" />
                                            <Setter Target="SelectionIndicatorScale.ScaleY" Value="1.0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="SelectedBackgroundBorder.Opacity" Value="1" />
                                            <Setter Target="HoverBackgroundBorder.Opacity" Value="0.6" />
                                            <Setter Target="SelectionIndicator.Opacity" Value="1" />
                                            <Setter Target="SelectionIndicatorScale.ScaleY" Value="1.0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>

                                <VisualStateGroup x:Name="ExpansionStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition From="Collapsed" To="Expanded">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ChevronRotateTransform"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 To="90"
                                                                 Duration="0:0:0.20">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                        <VisualTransition From="Expanded" To="Collapsed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ChevronRotateTransform"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 To="0"
                                                                 Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>

                                    <VisualState x:Name="Collapsed">
                                        <VisualState.Setters>
                                            <Setter Target="ChevronRotateTransform.Angle" Value="0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Expanded">
                                        <VisualState.Setters>
                                            <Setter Target="ChevronRotateTransform.Angle" Value="90" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <!-- Hover background highlight -->
                            <Border x:Name="HoverBackgroundBorder" 
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                                    CornerRadius="6" 
                                    Opacity="0" 
                                    IsHitTestVisible="False" />

                            <!-- Selected background highlight -->
                            <Border x:Name="SelectedBackgroundBorder" 
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                                    CornerRadius="6" 
                                    Opacity="0" 
                                    IsHitTestVisible="False" />

                            <!-- Static SelectionIndicator hidden in favor of unified sliding ActiveIndicatorPill -->
                            <Rectangle x:Name="SelectionIndicator" 
                                       Visibility="Collapsed"
                                       Width="3" 
                                       Height="16" 
                                       Fill="{ThemeResource AccentFillColorDefaultBrush}" 
                                       Opacity="0" 
                                       HorizontalAlignment="Left" 
                                       VerticalAlignment="Center" 
                                       RadiusX="1.5" 
                                       RadiusY="1.5"
                                       RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="SelectionIndicatorScale" ScaleY="0.0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>

                            <!-- Row Layout: Indentation + Chevron + Content -->
                            <Grid MinHeight="36" Padding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.Indentation}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Chevron button with animated rotation and auto-hide when no subfolders -->
                                <Grid x:Name="ExpandCollapseChevron" 
                                      Grid.Column="0" 
                                      Padding="10,0,6,0" 
                                      Width="28" 
                                      VerticalAlignment="Center"
                                      Background="Transparent"
                                      PointerPressed="OnChevronPointerPressed">
                                    <FontIcon x:Name="ChevronIcon"
                                              Glyph="&#xE972;"
                                              FontSize="9"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5"
                                              Visibility="{Binding DataContext.HasSubDirectories, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <FontIcon.RenderTransform>
                                            <RotateTransform x:Name="ChevronRotateTransform" Angle="0" />
                                        </FontIcon.RenderTransform>
                                    </FontIcon>
                                </Grid>

                                <!-- ContentPresenter -->
                                <ContentPresenter x:Name="ContentPresenter" 
                                                  Grid.Column="1" 
                                                  Content="{TemplateBinding Content}" 
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" 
                                                  ContentTransitions="{TemplateBinding ContentTransitions}" 
                                                  Foreground="{TemplateBinding Foreground}" 
                                                  HorizontalAlignment="Stretch" 
                                                  VerticalAlignment="Center" 
                                                  Margin="0" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CollectionViewSource for fluid Google Photos-style Date Grouping -->
        <CollectionViewSource x:Name="ClipsGroupedSource" IsSourceGrouped="True" />

        <!-- Library list row (Explorer "Details" style). Folder and date columns fold into a subtitle when narrow. -->
        <DataTemplate x:Key="ClipListRowTemplate" x:DataType="models:GameClip">
            <Grid Height="52" ColumnSpacing="14" Background="Transparent" RightTapped="OnClipCardRightTapped"
                  PointerEntered="OnClipRowPointerEntered" PointerExited="OnClipRowPointerExited"
                  Loaded="OnClipRowLoaded" Unloaded="OnClipRowUnloaded">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="84" />
                </Grid.ColumnDefinitions>

                <Grid Width="64" Height="36" CornerRadius="4" Background="{ThemeResource LayerFillColorAltBrush}" VerticalAlignment="Center">
                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="560"
                                   ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneWay}" />
                        <FontIcon Glyph="&#xEB52;" FontSize="11" Foreground="#FF6B81" VerticalAlignment="Center"
                                  Visibility="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                    Visibility="{x:Bind ShowBookmarkBadge, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE8A4;" FontSize="10" Foreground="#FFD700" />
                            <TextBlock Text="{x:Bind BookmarkCount, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind TagsPreview, Mode=OneWay}" IsTabStop="False" VerticalAlignment="Center"
                                      Visibility="{x:Bind HasTags, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="5,0,5,1">
                                        <TextBlock Text="{x:Bind}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   MaxWidth="120" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock x:Name="RowSubtitle" Text="{x:Bind FolderName, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                </StackPanel>

                <TextBlock x:Name="RowFolder" Grid.Column="2" Text="{x:Bind FolderName, Mode=OneWay}" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="RowDate" Grid.Column="3" Text="{x:Bind FormattedDate, Mode=OneWay}" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" Text="{x:Bind FormattedDuration, Mode=OneWay}" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Text="{x:Bind FormattedFileSize, Mode=OneWay}" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <Grid x:Name="MainRootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" SizeChanged="OnPageSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
            <ColumnDefinition x:Name="MainContentColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Layout-only spacer that reserves the sidebar's column. Its width changes in a single step;
             the visible sidebar below slides over it on the compositor, so the clip grid relayouts once
             per open/close instead of on every animation frame. -->
        <Border x:Name="SidebarSpacer" Grid.Column="0" Width="316" />


        <!-- Horizontal navigation: the sidebar docked to the top (as the title bar) or the bottom edge.
             Items are built in code (HomePage.Layout.cs); the footer buttons are moved in here. -->
        <Grid x:Name="HorizontalNavBar"
              Grid.ColumnSpan="2"
              VerticalAlignment="Top"
              Height="48"
              Visibility="Collapsed"
              Canvas.ZIndex="2"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image x:Name="HorizontalNavLogo" Grid.Column="0" Height="20" Margin="18,0,14,0" VerticalAlignment="Center" Stretch="Uniform">
                <Image.Source>
                    <SvgImageSource x:Name="HorizontalNavLogoSvg" UriSource="ms-appx:///Assets/light-banner.svg" RasterizePixelHeight="60" />
                </Image.Source>
            </Image>

            <ScrollViewer x:Name="HorizontalNavScroller"
                          Grid.Column="1"
                          HorizontalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          PointerWheelChanged="OnHorizontalNavWheel">
                <Grid x:Name="HorizontalNavItemsHost" HorizontalAlignment="Left">
                    <StackPanel x:Name="HorizontalNavItems" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Padding="0,0,8,0" />
                    <Border x:Name="HorizontalNavIndicator"
                            Width="16" Height="3" CornerRadius="1.5"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="0,0,0,5"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                </Grid>
            </ScrollViewer>

            <Border x:Name="HorizontalNavFooterHost" Grid.Column="2" Padding="8,0,10,0" VerticalAlignment="Center" />
            <!-- Room for the window's caption buttons when the bar is the title bar -->
            <Border x:Name="HorizontalNavCaptionSpacer" Grid.Column="3" Width="0" />
        </Grid>

        <!-- Left Navigation Sidebar (overlay spanning both columns, drawn above the main content) -->
        <Grid Grid.ColumnSpan="2"
              x:Name="SidebarContainer"
              Width="316"
              HorizontalAlignment="Left"
              Canvas.ZIndex="1"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SidebarTranslate" X="0" />
            </Grid.RenderTransform>
            <Border x:Name="SidebarContentBorder"
                    HorizontalAlignment="Left"
                    Width="316"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="0,0,1,0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid x:Name="SidebarRootGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: App Header & Collapse Button -->
                <Grid Grid.Row="0" x:Name="SidebarHeaderRow" Margin="14,10,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                            x:Name="CollapseSidebarButton"
                            ToolTipService.ToolTip="Collapse Sidebar"
                            Click="OnToggleSidebarClick"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Margin="0,0,8,0"
                            Padding="6"
                            PointerPressed="OnItemPointerPressed"
                            PointerReleased="OnItemPointerReleased"
                            PointerCanceled="OnItemPointerCanceled">
                        <FontIcon Glyph="&#xE700;" FontSize="14" />
                    </Button>

                    <Image Grid.Column="1" 
                           x:Name="SidebarLogoImage"
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center"
                           Height="24"
                           Stretch="Uniform">
                        <Image.Source>
                            <SvgImageSource x:Name="SidebarLogoSvg" UriSource="ms-appx:///Assets/light-banner.svg" RasterizePixelHeight="72" />
                        </Image.Source>
                    </Image>
                </Grid>

                <!-- Row 1: Top Navigation Tabs (Home, Favorites, Saved Moments) -->
                <Grid Grid.Row="1" Margin="10,0,10,8" x:Name="TopNavContainer">
                    <StackPanel Spacing="3">
                        <!-- Home Tab -->
                        <Button x:Name="HomeNavButton"
                                Click="OnHomeTabClick"
                                Style="{StaticResource NavTabButtonStyle}"
                                PointerPressed="OnItemPointerPressed">
                            <Grid Height="38">
                                <Border x:Name="HomeSelectedBg"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <Grid Padding="14,0,12,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <FontIcon x:Name="HomeNavIcon" Grid.Column="0" Glyph="&#xE80F;" FontSize="16" Margin="0,0,12,0" />

                                    <!-- Label -->
                                    <TextBlock x:Name="HomeNavText" Grid.Column="1" Text="Home" FontSize="13" VerticalAlignment="Center" />

                                    <!-- Counter (Clean text, brightened) -->
                                    <controls:RollingCounter Grid.Column="2" 
                                               Value="{x:Bind ViewModel.AllClipsCount, Mode=OneWay}" 
                                               FontSize="12" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{x:Bind ViewModel.AllClipsCount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Grid>
                        </Button>

                        <!-- Favorites Tab -->
                        <Button x:Name="FavoritesNavButton"
                                Click="OnFavoritesTabClick"
                                Style="{StaticResource NavTabButtonStyle}"
                                PointerPressed="OnItemPointerPressed">
                            <Grid Height="38">
                                <Border x:Name="FavoritesSelectedBg"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <Grid Padding="14,0,12,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Heart Icon (EB52 = HeartFill) -->
                                    <FontIcon x:Name="FavoritesNavIcon" Grid.Column="0" Glyph="&#xEB52;" FontSize="16" Margin="0,0,12,0" />

                                    <!-- Label -->
                                    <TextBlock x:Name="FavoritesNavText" Grid.Column="1" Text="Favorites" FontSize="13" VerticalAlignment="Center" />

                                    <!-- Counter (Clean text, brightened) -->
                                    <controls:RollingCounter Grid.Column="2" 
                                               Value="{x:Bind ViewModel.FavoritesCount, Mode=OneWay}" 
                                               FontSize="12" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{x:Bind ViewModel.FavoritesCount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Grid>
                        </Button>

                        <!-- Saved Moments Tab -->
                        <Button x:Name="SavedMomentsNavButton"
                                Click="OnSavedMomentsTabClick"
                                Style="{StaticResource NavTabButtonStyle}"
                                PointerPressed="OnItemPointerPressed">
                            <Grid Height="38">
                                <Border x:Name="SavedMomentsSelectedBg"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <Grid Padding="14,0,12,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <FontIcon x:Name="SavedMomentsNavIcon" Grid.Column="0" Glyph="&#xE8A4;" FontSize="16" Margin="0,0,12,0" />

                                    <!-- Label -->
                                    <TextBlock x:Name="SavedMomentsNavText" Grid.Column="1" Text="Saved Moments" FontSize="13" VerticalAlignment="Center" />

                                    <!-- Counter (Clean text, brightened) -->
                                    <controls:RollingCounter Grid.Column="2" 
                                               Value="{x:Bind ViewModel.SavedMomentsCount, Mode=OneWay}" 
                                               FontSize="12" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{x:Bind ViewModel.SavedMomentsCount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Separator -->
                <MenuFlyoutSeparator Grid.Row="2" Margin="14,2,14,8" />

                <!-- Row 3: Folders Header -->
                <Grid Grid.Row="3" Margin="16,0,14,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FoldersHeaderNavText"
                               Grid.Column="0" 
                               Text="Folders" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1" 
                            x:Name="AddWatchFolderButton"
                            ToolTipService.ToolTip="Add Watch Folder"
                            Click="OnAddFolderClick"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="6,3"
                            PointerPressed="OnItemPointerPressed"
                            PointerReleased="OnItemPointerReleased"
                            PointerCanceled="OnItemPointerCanceled">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                            <TextBlock x:Name="FoldersAddNavText" Text="Add" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Row 4: Folders TreeView -->
                <Grid Grid.Row="4" Margin="10,0,6,0">
                    <TreeView x:Name="DirectoriesTreeView"
                              ItemsSource="{x:Bind ViewModel.Directories, Mode=OneWay}"
                              ItemInvoked="OnDirectoryTreeItemInvoked"
                              Expanding="OnDirectoryExpanding"
                              Collapsed="OnDirectoryCollapsed"
                              Loaded="OnDirectoriesTreeViewLoaded"
                              SelectionMode="Single"
                              Padding="0,0,2,0"
                              ItemContainerStyle="{StaticResource CustomTreeViewItemStyle}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind ViewModel.HasDirectories, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="models:DirectoryNode">
                                <TreeViewItem ItemsSource="{x:Bind SubDirectories, Mode=OneWay}"
                                              IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                              Loading="OnTreeViewItemLoading"
                                              RightTapped="OnFolderRowRightTapped"
                                              Style="{StaticResource CustomTreeViewItemStyle}">
                                    <Grid Margin="0,0,8,0" ColumnSpacing="8" VerticalAlignment="Center"
                                          Loaded="OnFolderItemGridLoaded">
                                        <Grid.RenderTransform>
                                            <TranslateTransform />
                                        </Grid.RenderTransform>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" 
                                                  Glyph="{x:Bind IconGlyph, Mode=OneWay}" 
                                                  FontSize="15" 
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                  VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1" 
                                                   Text="{x:Bind DisplayName}" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   VerticalAlignment="Center" 
                                                   ToolTipService.ToolTip="{x:Bind FullPath}" />

                                        <controls:RollingCounter Grid.Column="2" 
                                                   Value="{x:Bind ClipCount, Mode=OneWay}" 
                                                   FontSize="12" 
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                                   VerticalAlignment="Center" 
                                                   Margin="0,0,2,0" 
                                                   Visibility="{x:Bind ClipCount, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- Fallback Prompt if No Folders -->
                    <StackPanel Visibility="{x:Bind ViewModel.HasDirectories, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                Spacing="8" Margin="8,24,8,8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="FoldersFallbackTitleText" Text="No folders added" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="FoldersFallbackSubtitleText" Text="Add your captures folder to index game clips." 
                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center" />
                        <Button x:Name="FoldersFallbackButton" Content="Choose Folder" HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnAddFolderClick"
                                PointerPressed="OnItemPointerPressed"
                                PointerReleased="OnItemPointerReleased"
                                PointerCanceled="OnItemPointerCanceled" />
                    </StackPanel>
                </Grid>

                <!-- Row 5: Bottom Settings & Refresh (Integrated with Sidebar Background) -->
                <Border Grid.Row="5"
                        x:Name="SidebarFooterBorder"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" 
                        BorderThickness="0,1,0,0" 
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Padding="14,10">
                    <Grid x:Name="SidebarFooterGrid" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                x:Name="SettingsNavButton"
                                HorizontalAlignment="Left" 
                                HorizontalContentAlignment="Left"
                                Command="{x:Bind ViewModel.OpenSettingsCommand}"
                                Style="{ThemeResource SubtleButtonStyle}"
                                PointerPressed="OnItemPointerPressed"
                                PointerReleased="OnItemPointerReleased"
                                PointerCanceled="OnItemPointerCanceled">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE713;" FontSize="16" />
                                <TextBlock x:Name="SettingsNavText" Text="Settings" VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Update available: accent icon that pops in when a new version is found -->
                        <Button Grid.Column="1"
                                x:Name="UpdateAvailableButton"
                                Visibility="Collapsed"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5"
                                Click="OnUpdateAvailableButtonClick"
                                Style="{ThemeResource SubtleButtonStyle}"
                                PointerPressed="OnItemPointerPressed"
                                PointerReleased="OnItemPointerReleased"
                                PointerCanceled="OnItemPointerCanceled">
                            <Button.RenderTransform>
                                <ScaleTransform x:Name="UpdateButtonScale" ScaleX="0.6" ScaleY="0.6" />
                            </Button.RenderTransform>
                            <Grid>
                                <FontIcon x:Name="UpdateButtonIcon" Glyph="&#xE896;" FontSize="14" Foreground="{ThemeResource UpdateAccentBrush}" />
                                <Ellipse Width="6" Height="6"
                                         HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Margin="0,-3,-4,0"
                                         Fill="{ThemeResource UpdateAccentBrush}" />
                            </Grid>
                        </Button>

                        <Button Grid.Column="2"
                                x:Name="FeedbackButton"
                                Click="OnFeedbackClick"
                                Style="{ThemeResource SubtleButtonStyle}"
                                PointerPressed="OnItemPointerPressed"
                                PointerReleased="OnItemPointerReleased"
                                PointerCanceled="OnItemPointerCanceled">
                            <FontIcon Glyph="&#xED15;" FontSize="14" />
                        </Button>

                        <Button Grid.Column="3"
                                x:Name="RefreshClipsButton"
                                ToolTipService.ToolTip="Refresh Clips"
                                Command="{x:Bind ViewModel.RefreshClipsCommand}"
                                Style="{ThemeResource SubtleButtonStyle}"
                                PointerPressed="OnItemPointerPressed"
                                PointerReleased="OnItemPointerReleased"
                                PointerCanceled="OnItemPointerCanceled">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Windows 11 Sliding Active Selection Indicator (Unified for Tabs & Folders) -->
                <Border x:Name="ActiveIndicatorPill"
                        Grid.RowSpan="6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Width="3"
                        Height="16"
                        CornerRadius="1.5"
                        Margin="10,0,0,0"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        IsHitTestVisible="False"
                        Opacity="1"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="IndicatorScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="IndicatorTranslation" X="0" Y="48" />
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Border>

        <!-- Interactive Resize Handle on right edge of sidebar container -->
        <Border x:Name="SidebarResizeHandle"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Width="10"
                Margin="0,0,-5,0"
                Background="Transparent"
                Canvas.ZIndex="10"
                PointerEntered="OnSidebarResizeHandlePointerEntered"
                PointerExited="OnSidebarResizeHandlePointerExited"
                PointerPressed="OnSidebarResizeHandlePointerPressed"
                PointerMoved="OnSidebarResizeHandlePointerMoved"
                PointerReleased="OnSidebarResizeHandlePointerReleased"
                PointerCanceled="OnSidebarResizeHandlePointerCanceled">
            <!-- Visual highlight line on hover/drag -->
            <Rectangle x:Name="ResizeHighlightLine" 
                       Width="2" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Stretch" 
                       Fill="{ThemeResource AccentFillColorDefaultBrush}" 
                       Opacity="0" />
        </Border>
    </Grid>

    <!-- Column 1: Right Main View (Clip Grid & Header) -->
    <Grid Grid.Column="1" x:Name="MainContentRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="MainContentTranslate" X="0" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: title with live library stats on the left, search / sort / view on the right -->
            <Border Grid.Row="0" x:Name="LibraryHeaderBorder" Padding="24,32,24,10" BorderThickness="0">
                <Grid x:Name="LibraryHeaderGrid" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar expand button; its width animates with the sidebar so the title glides instead of jumping -->
                    <Grid Grid.Column="0"
                          x:Name="ShowSidebarContainer"
                          Width="0"
                          Opacity="0"
                          Visibility="Collapsed"
                          Margin="0,0,-12,0"
                          VerticalAlignment="Center">
                        <Button x:Name="ShowSidebarButton"
                                Click="OnToggleSidebarClick"
                                ToolTipService.ToolTip="Show Sidebar"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Padding="6"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE700;" FontSize="16" />
                        </Button>
                    </Grid>

                    <!-- Title and stats -->
                    <StackPanel Grid.Column="1" x:Name="HeaderTitlePanel" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.CurrentDirectoryTitle, Mode=OneWay}"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Every piece sits in the same 17px centred slot the rolling counters use, so numbers and
                             words share one baseline -->
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <controls:RollingCounter Value="{x:Bind ViewModel.TotalClipsCount, Mode=OneWay}"
                                                         FontSize="12.5"
                                                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid Height="17">
                                    <TextBlock Text="{x:Bind ViewModel.ClipsUnitLabel, Mode=OneWay}" FontSize="12.5"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                            <Grid Height="17">
                                <TextBlock Text="·" FontSize="12.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <controls:RollingCounter Value="{x:Bind ViewModel.TotalStorageScaled, Mode=OneWay}"
                                                         DecimalPlaces="{x:Bind ViewModel.TotalStorageDecimals, Mode=OneWay}"
                                                         FontSize="12.5"
                                                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid Height="17">
                                    <TextBlock Text="{x:Bind ViewModel.TotalStorageUnit, Mode=OneWay}" FontSize="12.5"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                            <Grid Height="17" Visibility="{x:Bind ViewModel.CurrentDirectoryPath, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="·" FontSize="12.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Folder path opens File Explorer (folder views) -->
                            <HyperlinkButton x:Name="ExplorerHyperlinkButton"
                                             Height="17" Padding="0" Margin="0" MinHeight="0" MinWidth="0"
                                             VerticalContentAlignment="Center"
                                             Command="{x:Bind ViewModel.OpenCurrentDirectoryCommand}"
                                             ToolTipService.ToolTip="Open folder in File Explorer"
                                             Visibility="{x:Bind ViewModel.CanOpenDirectoryInExplorer, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.CurrentDirectoryPath, Mode=OneWay}"
                                               FontSize="12.5"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               MaxWidth="420" />
                                </StackPanel>
                            </HyperlinkButton>

                            <!-- Informational subtitle (Home, Favorites, Saved Moments) -->
                            <Grid Height="17" Visibility="{x:Bind ViewModel.CanOpenDirectoryInExplorer, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind ViewModel.CurrentDirectoryPath, Mode=OneWay}"
                                           FontSize="12.5"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- Toolbar. Counter-translated during sidebar transitions so it stays pinned to the window edge -->
                    <StackPanel Grid.Column="2" x:Name="HeaderToolbar" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="HeaderToolbarTranslate" X="0" />
                        </StackPanel.RenderTransform>

                        <!-- Open a video file that isn't in the library (Ctrl+O) -->
                        <Button x:Name="OpenFileHeaderButton"
                                Click="OnOpenVideoFileClick"
                                Width="34" Height="32"
                                Padding="0"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Open video file">
                            <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                        </Button>

                        <!-- Search: a button that morphs into a field (width opens, then the text fades in) -->
                        <Grid x:Name="SearchHost" Width="34" Height="32" VerticalAlignment="Center">
                            <Border x:Name="SearchChrome"
                                    CornerRadius="4"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1" />
                            <TextBox x:Name="ClipsSearchBox"
                                     Margin="28,0,2,0"
                                     Padding="4,5,4,5"
                                     MinHeight="0"
                                     MinWidth="0"
                                     FontSize="12.5"
                                     VerticalAlignment="Center"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Opacity="0"
                                     IsHitTestVisible="False"
                                     IsTabStop="False"
                                     PlaceholderText="Search clips..."
                                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnSearchKeyDown"
                                     LostFocus="OnSearchLostFocus">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </TextBox.Resources>
                            </TextBox>
                            <Button x:Name="SearchToggleButton"
                                    HorizontalAlignment="Left"
                                    Width="32" Height="30" Margin="1,0,0,0"
                                    Padding="0"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Click="OnSearchToggleClick">
                                <FontIcon Glyph="&#xE721;" FontSize="13" />
                            </Button>
                        </Grid>

                        <!-- Tags filter: the user's tags and games; the label carries the active filter count -->
                        <DropDownButton x:Name="TagsFilterButton"
                                        Padding="12,5,10,6"
                                        VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon x:Name="TagsFilterIcon" Glyph="&#xE1CB;" FontSize="13" />
                                <TextBlock x:Name="TagsFilterText" Text="Tags" FontSize="12.5" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="TagsFilterFlyout" Placement="BottomEdgeAlignedRight" Opening="OnTagsFilterOpening" Opened="OnFlyoutOpened" />
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <!-- Sort DropDown Button -->
                        <DropDownButton x:Name="SortOptionsButton"
                                        Padding="12,5,10,6"
                                        SizeChanged="OnSortButtonSizeChanged"
                                        VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon x:Name="CurrentSortIcon" Glyph="&#xE787;" FontSize="13" />
                                <TextBlock x:Name="CurrentSortText" Text="Newest Date" FontSize="12.5" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="SortMenuFlyout" Placement="BottomEdgeAlignedRight" Opening="OnFlyoutOpening" Opened="OnFlyoutOpened">
                                    <MenuFlyoutItem x:Name="SortNewestItem" Click="OnSortMenuItemClick" Tag="0">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE787;" FontSize="14" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="SortOldestItem" Click="OnSortMenuItemClick" Tag="1">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE787;" FontSize="14" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="SortNameAZItem" Click="OnSortMenuItemClick" Tag="2">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" FontSize="14" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="SortNameZAItem" Click="OnSortMenuItemClick" Tag="3">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" FontSize="14" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="SortDurationItem" Click="OnSortMenuItemClick" Tag="4">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE916;" FontSize="14" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="SortDurationShortestItem" Click="OnSortMenuItemClick" Tag="6">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE916;" FontSize="14" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="SortFileSizeItem" Click="OnSortMenuItemClick" Tag="5">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74C;" FontSize="14" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="SortFileSizeSmallestItem" Click="OnSortMenuItemClick" Tag="7">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74C;" FontSize="14" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <!-- View Options DropDown Button -->
                        <DropDownButton x:Name="ViewOptionsButton"
                                        Padding="12,5,10,6"
                                        VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74C;" FontSize="13" />
                                <TextBlock x:Name="ViewOptionsText" Text="View" FontSize="12.5" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="ViewMenuFlyout" Placement="BottomEdgeAlignedRight" Opening="OnFlyoutOpening" Opened="OnFlyoutOpened">
                                    <MenuFlyoutItem x:Name="ViewDensityHeader" Text="Card Size" IsEnabled="False" />
                                    <ToggleMenuFlyoutItem x:Name="ViewDensityComfortableItem" Click="OnViewDensityItemClick" Tag="0">
                                        <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE790;" FontSize="14" /></ToggleMenuFlyoutItem.Icon>
                                    </ToggleMenuFlyoutItem>
                                    <ToggleMenuFlyoutItem x:Name="ViewDensityCompactItem" Click="OnViewDensityItemClick" Tag="1">
                                        <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE74C;" FontSize="14" /></ToggleMenuFlyoutItem.Icon>
                                    </ToggleMenuFlyoutItem>
                                    <ToggleMenuFlyoutItem x:Name="ViewDensityLargeItem" Click="OnViewDensityItemClick" Tag="2">
                                        <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B9;" FontSize="14" /></ToggleMenuFlyoutItem.Icon>
                                    </ToggleMenuFlyoutItem>
                                    <MenuFlyoutSeparator x:Name="ViewDensitySeparator" />
                                    <MenuFlyoutItem x:Name="ViewGroupingHeader" Text="Group by Date" IsEnabled="False" />
                                    <ToggleMenuFlyoutItem x:Name="ViewGroupingNoneItem" Click="OnViewGroupingItemClick" Tag="0">
                                        <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" FontSize="14" /></ToggleMenuFlyoutItem.Icon>
                                    </ToggleMenuFlyoutItem>
                                    <ToggleMenuFlyoutItem x:Name="ViewGroupingDayItem" Click="OnViewGroupingItemClick" Tag="1">
                                        <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE787;" FontSize="14" /></ToggleMenuFlyoutItem.Icon>
                                    </ToggleMenuFlyoutItem>
                                    <ToggleMenuFlyoutItem x:Name="ViewGroupingMonthItem" Click="OnViewGroupingItemClick" Tag="2">
                                        <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE787;" FontSize="14" /></ToggleMenuFlyoutItem.Icon>
                                    </ToggleMenuFlyoutItem>
                                    <ToggleMenuFlyoutItem x:Name="ViewGroupingYearItem" Click="OnViewGroupingItemClick" Tag="3">
                                        <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xEC92;" FontSize="14" /></ToggleMenuFlyoutItem.Icon>
                                    </ToggleMenuFlyoutItem>
                                    <MenuFlyoutSeparator x:Name="ViewMetadataSeparator" />
                                    <ToggleMenuFlyoutItem x:Name="ViewMetadataHoverItem" Click="OnViewMetadataHoverToggleClick">
                                        <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE890;" FontSize="14" /></ToggleMenuFlyoutItem.Icon>
                                    </ToggleMenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Clip Cards Grid Container (fades/slides in when the sidebar view changes) -->
            <Grid Grid.Row="1" x:Name="ClipsHost">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ClipsHostTranslate" Y="0" />
                </Grid.RenderTransform>
                <!-- GridView of Clips with Date Grouping and Responsive Edge-to-Edge Wrapping -->
                <!-- Visibility of the grid, list and skeletons is driven from code (HomePage.Transitions.cs) so loading crossfades -->
                <GridView x:Name="ClipsGridView"
                          ItemClick="OnClipItemClick"
                          IsItemClickEnabled="True"
                          ContainerContentChanging="OnClipContainerContentChanging"
                          SelectionMode="None"
                          Padding="24,14,24,24"
                          SizeChanged="OnClipsGridViewSizeChanged"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          UseSystemFocusVisuals="False"
                          IsTabStop="False">
                    <GridView.RenderTransform>
                        <TranslateTransform x:Name="ClipsGridTranslate" Y="0" />
                    </GridView.RenderTransform>

                    <!-- No item transitions: a RepositionThemeTransition on every card made each resize,
                         sidebar toggle and re-sort glide all cards ~300ms behind the layout (the "lag").
                         View changes get one composition fade on the whole host instead. -->
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection />
                    </GridView.ItemContainerTransitions>

                    <GridView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderContainerStyle>
                                <Style TargetType="GridViewHeaderItem">
                                    <Setter Property="Transitions">
                                        <Setter.Value>
                                            <TransitionCollection />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                </Style>
                            </GroupStyle.HeaderContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="models:ClipGroup">
                                    <!-- Date heading (Google Photos style): the date carries the row, the stats stay quiet -->
                                    <StackPanel Margin="2,20,0,4" Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12.5" Margin="0,0,0,1.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" 
                                                   HorizontalAlignment="Stretch" 
                                                   ItemWidth="280" 
                                                   ItemHeight="158" 
                                                   MaximumRowsOrColumns="-1" />
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                        </GroupStyle>
                    </GridView.GroupStyle>

                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" 
                                           HorizontalAlignment="Stretch" 
                                           ItemWidth="280" 
                                           ItemHeight="158" 
                                           MaximumRowsOrColumns="-1" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="UseSystemFocusVisuals" Value="False" />
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="FocusVisualPrimaryBrush" Value="Transparent" />
                            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
                            <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                            <Setter Property="Margin" Value="6" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="10" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewItem">
                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GridView.ItemContainerStyle>

                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:GameClip">
                            <Grid x:Name="CardRootGrid"
                                  CornerRadius="10"
                                  Background="{ThemeResource LayerFillColorAltBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="1"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  RenderTransformOrigin="0.5,0.5"
                                  Loaded="OnClipCardLoaded"
                                  Unloaded="OnClipCardUnloaded"
                                  PointerEntered="OnClipCardPointerEntered"
                                  PointerExited="OnClipCardPointerExited"
                                  PointerPressed="OnClipCardPointerPressed"
                                  PointerReleased="OnClipCardPointerReleased"
                                  PointerCanceled="OnClipCardPointerReleased"
                                  RightTapped="OnClipCardRightTapped">

                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0" />
                                </Grid.RenderTransform>

                                <!-- 1. Fullscreen Thumbnail Image -->
                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" 
                                       Stretch="UniformToFill" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" />

                                <!-- Fallback Graphic if Thumbnail Loading -->
                                <Grid Background="{ThemeResource LayerFillColorAltBrush}"
                                      Visibility="{x:Bind Thumbnail, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}">
                                    <FontIcon Glyph="&#xE714;" FontSize="32" 
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" />
                                </Grid>

                                <!-- 2. Top Scrim Gradient Overlay for Badges & Favorite -->
                                <Border VerticalAlignment="Top" Height="48" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#88000000" Offset="0.0" />
                                            <GradientStop Color="#00000000" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Top Badges Row -->
                                <Grid VerticalAlignment="Top" Margin="8,8,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Saved Moments Frosted Badge, then the clip's tags (at most two and a "+N") -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left" Margin="0,0,6,0">
                                        <Border VerticalAlignment="Top"
                                                Background="#80000000"
                                                BorderBrush="#33FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="6,2"
                                                Visibility="{x:Bind ShowBookmarkBadge, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE8A4;" FontSize="10" Foreground="#FFD700" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind FormattedBookmarkCount, Mode=OneWay}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="#FFF0A0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{x:Bind TagsPreview, Mode=OneWay}"
                                                      IsTabStop="False"
                                                      VerticalAlignment="Top"
                                                      Visibility="{x:Bind HasTags, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border Background="#59000000" CornerRadius="4" Padding="5,1,5,2">
                                                        <TextBlock Text="{x:Bind}" FontSize="11" FontWeight="SemiBold" Foreground="White"
                                                                   MaxWidth="84" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Right: Glassmorphic Favorite Button with Pulse Ring & Sparkles -->
                                    <!-- Shown on hover, or always once the clip is a favorite -->
                                    <Grid Grid.Column="1" x:Name="FavoriteHost" Width="28" Height="28" HorizontalAlignment="Right" RequestedTheme="Dark"
                                          Opacity="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource FavoriteHostOpacityConverter}}">
                                        <!-- Pulse Expansion Ring on Favorite -->
                                        <Border x:Name="FavoritePulseRing"
                                                x:Load="False"
                                                Width="28" Height="28" CornerRadius="14"
                                                BorderBrush="#FFE57F" BorderThickness="1.5"
                                                Opacity="0" IsHitTestVisible="False"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="FavoritePulseScale" ScaleX="0.8" ScaleY="0.8" />
                                            </Border.RenderTransform>
                                        </Border>

                                        <!-- Sparkle Particles Canvas -->
                                        <Canvas x:Name="FavoriteSparklesCanvas" x:Load="False" Width="28" Height="28" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                            <Canvas.RenderTransform>
                                                <ScaleTransform x:Name="FavoriteSparklesScale" ScaleX="0.8" ScaleY="0.8" />
                                            </Canvas.RenderTransform>
                                            <Ellipse Canvas.Left="2" Canvas.Top="3" Width="3" Height="3" Fill="#FFE082" />
                                            <Ellipse Canvas.Left="23" Canvas.Top="4" Width="2.5" Height="2.5" Fill="#FFD54F" />
                                            <Ellipse Canvas.Left="1" Canvas.Top="21" Width="2.5" Height="2.5" Fill="#FFCA28" />
                                            <Ellipse Canvas.Left="22" Canvas.Top="20" Width="3" Height="3" Fill="#FFE082" />
                                        </Canvas>

                                        <Button x:Name="FavoriteButton"
                                                Style="{ThemeResource SubtleButtonStyle}" 
                                                Padding="0" Width="28" Height="28"
                                                CornerRadius="14"
                                                Background="#55000000"
                                                BorderBrush="#25FFFFFF"
                                                BorderThickness="1"
                                                Click="OnFavoriteClick"
                                                Loaded="OnFavoriteButtonLoaded"
                                                Tag="{x:Bind}"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Button.RenderTransform>
                                                <ScaleTransform x:Name="FavoriteScale" ScaleX="1.0" ScaleY="1.0" />
                                            </Button.RenderTransform>
                                            <FontIcon x:Name="FavoriteIcon"
                                                      Glyph="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource FavoriteGlyphConverter}}" 
                                                      FontSize="12" 
                                                      Foreground="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource FavoriteForegroundConverter}}"
                                                      Opacity="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource FavoriteOpacityConverter}}" />
                                        </Button>
                                    </Grid>
                                </Grid>

                                <!-- 3. Center Play Overlay Icon (Scale & Fade on hover) -->
                                <Border x:Name="PlayOverlay"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="#80000000"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="24" Width="48" Height="48"
                                        Opacity="0"
                                        IsHitTestVisible="False"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="PlayOverlayScale" ScaleX="0.8" ScaleY="0.8" />
                                    </Border.RenderTransform>
                                    <FontIcon Glyph="&#xE768;" FontSize="20" Foreground="White" Margin="3,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- 4. Bottom Scrim Gradient Overlay for Title & Metadata -->
                                <Border VerticalAlignment="Bottom" Height="86" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#00000000" Offset="0.0" />
                                            <GradientStop Color="#80000000" Offset="0.3" />
                                            <GradientStop Color="#EE000000" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- 5. Bottom info: title with the duration beside it, then a quiet date · size line -->
                                <Grid VerticalAlignment="Bottom" Padding="11,0,10,9">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" ColumnSpacing="8">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="TitleTransform" Y="0" />
                                        </Grid.RenderTransform>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ClipTitleText"
                                                   Text="{x:Bind DisplayName, Mode=OneWay}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   MaxLines="1"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneWay}" />
                                        <Border Grid.Column="1"
                                                Background="#59000000"
                                                CornerRadius="4"
                                                Padding="5,1,5,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FormattedDuration, Mode=OneWay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="White" />
                                        </Border>
                                    </Grid>

                                    <!-- Date on the left, size aligned to the right edge -->
                                    <Grid x:Name="MetadataRow" Grid.Row="1" Margin="0,3,0,0" Opacity="0.85" ColumnSpacing="8">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="MetadataTransform" Y="0" />
                                        </Grid.RenderTransform>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind FormattedDate, Mode=OneWay}" FontSize="11" Foreground="#D9FFFFFF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind FormattedFileSize, Mode=OneWay}" FontSize="11" Foreground="#D9FFFFFF" />
                                    </Grid>
                                </Grid>

                                <!-- Accent Outline on Hover -->
                                <Border x:Name="HoverHighlightBorder"
                                        CornerRadius="10"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="1.5"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- List view: column headers (click to sort) over a details list -->
                <Grid x:Name="ClipsListHost" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="ListHeaderRow" Margin="32,8,40,4" ColumnSpacing="14" Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="84" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ListSortName" Grid.Column="1" Tag="name" Click="OnListHeaderClick" Style="{ThemeResource SubtleButtonStyle}" Padding="6,3" Margin="-6,0,0,0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="ListHeaderNameText" Text="Name" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <FontIcon x:Name="ListSortNameGlyph" Glyph="&#xE70D;" FontSize="9" Opacity="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="ListHeaderFolderText" Grid.Column="2" Text="Folder" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <Button x:Name="ListSortDate" Grid.Column="3" Tag="date" Click="OnListHeaderClick" Style="{ThemeResource SubtleButtonStyle}" Padding="6,3" Margin="-6,0,0,0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="ListHeaderDateText" Text="Date" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <FontIcon x:Name="ListSortDateGlyph" Glyph="&#xE70D;" FontSize="9" Opacity="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ListSortDuration" Grid.Column="4" Tag="duration" Click="OnListHeaderClick" Style="{ThemeResource SubtleButtonStyle}" Padding="6,3" Margin="0,0,-6,0" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="ListSortDurationGlyph" Glyph="&#xE70D;" FontSize="9" Opacity="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ListHeaderDurationText" Text="Length" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ListSortSize" Grid.Column="5" Tag="size" Click="OnListHeaderClick" Style="{ThemeResource SubtleButtonStyle}" Padding="6,3" Margin="0,0,2,0" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="ListSortSizeGlyph" Glyph="&#xE70D;" FontSize="9" Opacity="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ListHeaderSizeText" Text="Size" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Margin="30,0,34,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <ListView x:Name="ClipsListView"
                              Grid.Row="1"
                              ItemTemplate="{StaticResource ClipListRowTemplate}"
                              ItemClick="OnClipItemClick"
                              IsItemClickEnabled="True"
                              SelectionMode="None"
                              ContainerContentChanging="OnClipContainerContentChanging"
                              Padding="24,4,24,24"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              IsTabStop="False">
                        <ListView.RenderTransform>
                            <TranslateTransform x:Name="ClipsListTranslate" Y="0" />
                        </ListView.RenderTransform>
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding" Value="8,0,8,0" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderContainerStyle>
                                    <Style TargetType="ListViewHeaderItem">
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Padding" Value="8,0,0,0" />
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </GroupStyle.HeaderContainerStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="models:ClipGroup">
                                        <StackPanel Margin="2,18,0,2" Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                                            <TextBlock Text="{x:Bind Subtitle}" FontSize="12.5" Margin="0,0,0,1.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                    </ListView>

                    <!-- List skeleton: rows shaped like the list rows, same shimmer as the card skeleton -->
                    <ScrollViewer x:Name="ListSkeletonScrollViewer"
                                  Grid.Row="1"
                                  Visibility="Collapsed"
                                  Padding="24,4,24,24"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsHitTestVisible="False">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SkeletonPlaceholders, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="52" Margin="8,1" ColumnSpacing="14" Loaded="OnSkeletonRowLoaded" Unloaded="OnSkeletonRowUnloaded">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="84" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="64" Height="36" CornerRadius="4" VerticalAlignment="Center"
                                                Background="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.18" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                            <Border Height="12" Width="220" HorizontalAlignment="Left" CornerRadius="4"
                                                    Background="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.28" />
                                            <Border x:Name="SkeletonSubtitle" Height="9" Width="90" HorizontalAlignment="Left" CornerRadius="3" Visibility="Collapsed"
                                                    Background="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.16" />
                                        </StackPanel>

                                        <Border x:Name="SkeletonFolder" Grid.Column="2" Height="10" Width="96" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="3"
                                                Background="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.2" />
                                        <Border x:Name="SkeletonDate" Grid.Column="3" Height="10" Width="86" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="3"
                                                Background="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.2" />
                                        <Border Grid.Column="4" Height="10" Width="40" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="3"
                                                Background="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.2" />
                                        <Border Grid.Column="5" Height="10" Width="48" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="3" Margin="0,0,8,0"
                                                Background="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.2" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Skeleton Loading Grid View (Shown when loading and skeleton loading enabled) -->
                <ScrollViewer x:Name="SkeletonScrollViewer"
                              Visibility="Collapsed"
                              Padding="24,14,24,24"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              IsHitTestVisible="False">
                    <ItemsControl x:Name="SkeletonItemsControl" ItemsSource="{x:Bind ViewModel.SkeletonPlaceholders, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Left" ItemWidth="280" ItemHeight="158" MaximumRowsOrColumns="-1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid CornerRadius="10" Margin="6"
                                      Background="{ThemeResource LayerFillColorAltBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      BorderThickness="1"
                                      Loaded="OnSkeletonCardLoaded">

                                    <!-- Center Placeholder Video Icon -->
                                    <FontIcon Glyph="&#xE714;" FontSize="28" 
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                              Opacity="0.25"
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" />

                                    <!-- Top-Right Placeholder Circle -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                            Width="26" Height="26" CornerRadius="13"
                                            Background="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.12" />

                                    <!-- Bottom Scrim Gradient -->
                                    <Border VerticalAlignment="Bottom" Height="70" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#00000000" Offset="0.0" />
                                                <GradientStop Color="#40000000" Offset="0.4" />
                                                <GradientStop Color="#90000000" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- Bottom Placeholder Info Bars -->
                                    <Grid VerticalAlignment="Bottom" Padding="10,0,10,10">
                                        <StackPanel Spacing="6">
                                            <!-- Title Bar Placeholder -->
                                            <Border Height="12" Width="140" HorizontalAlignment="Left" CornerRadius="4" 
                                                    Background="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.28" />

                                            <!-- Metadata Row Placeholders -->
                                            <Grid>
                                                <!-- Duration pill placeholder -->
                                                <Border Height="14" Width="46" HorizontalAlignment="Left" CornerRadius="4" 
                                                        Background="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.2" />
                                                <!-- Size placeholder -->
                                                <Border Height="10" Width="38" HorizontalAlignment="Right" CornerRadius="3" 
                                                        Background="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.16" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Classic Circular ProgressRing (Shown when skeleton loading disabled in settings) -->
                <Grid Visibility="{x:Bind ViewModel.ShowProgressRingLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Border Width="56" Height="56" 
                            CornerRadius="28"
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressRing IsActive="{x:Bind ViewModel.ShowProgressRingLoading, Mode=OneWay}" 
                                      Width="34" Height="34" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Empty State View (Shown only when loading is complete and no clips) -->
                <StackPanel Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="{x:Bind ViewModel.EmptyStateGlyph, Mode=OneWay}" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyStateSubtitle, Mode=OneWay}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               HorizontalAlignment="Center" />
                    <Button x:Name="EmptyStateOpenFileButton"
                            Click="OnOpenVideoFileClick"
                            HorizontalAlignment="Center"
                            Margin="0,6,0,0"
                            PointerPressed="OnItemPointerPressed"
                            PointerReleased="OnItemPointerReleased"
                            PointerCanceled="OnItemPointerCanceled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                            <TextBlock x:Name="EmptyStateOpenFileText" Text="Open Video File" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Invisible Warmup Container for Preloading & JIT Compilation of Storyboards -->
        <Canvas x:Name="AnimationWarmupCanvas" 
                Width="0" Height="0" 
                Opacity="0" 
                IsHitTestVisible="False" 
                Visibility="Visible" />

        <!-- Middle-Click Pan Autoscroll Indicator Overlay -->
        <Canvas x:Name="AutoscrollCanvas" IsHitTestVisible="False" Visibility="Collapsed">
            <Grid x:Name="AutoscrollIndicator" Width="36" Height="36" Margin="-18,-18,0,0">
                <Ellipse Fill="#E6181818" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="1.5" />
                <FontIcon Glyph="&#xE70E;" FontSize="10" Foreground="#C0C0C0" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" />
                <Ellipse Width="6" Height="6" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="#C0C0C0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" />
            </Grid>
        </Canvas>
    
    <!-- Update prompt: anchored to the sidebar update icon (falls back to a corner when the sidebar is hidden) -->
    <TeachingTip x:Name="UpdateTeachingTip"
                 Grid.ColumnSpan="2"
                 PreferredPlacement="RightBottom"
                 IsLightDismissEnabled="True"
                 ActionButtonStyle="{ThemeResource AccentButtonStyle}"
                 ActionButtonClick="OnUpdateTipActionClick"
                 CloseButtonClick="OnUpdateTipCloseClick">
        <TeachingTip.IconSource>
            <FontIconSource Glyph="&#xE896;" Foreground="{ThemeResource UpdateAccentBrush}" />
        </TeachingTip.IconSource>
    </TeachingTip>
</Grid>
</Page>
