<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Reeled.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Reeled.Models"
    xmlns:viewmodels="using:Reeled.ViewModels"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="220" MaxWidth="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="0,0,1,0" 
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid Margin="12,16,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Library Header & Add Folder Button -->
                <Grid Grid.Row="0" Margin="4,0,4,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B9;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Clip Folders" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>

                    <Button Grid.Column="1" 
                            ToolTipService.ToolTip="Add Watch Folder"
                            Click="OnAddFolderClick"
                            Style="{ThemeResource SubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Add" FontSize="13" />
                        </StackPanel>
                    </Button>
                </Grid>

                <MenuFlyoutSeparator Grid.Row="1" Margin="0,0,0,8" />

                <!-- Folders Tree / List -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4">
                        <ListView ItemsSource="{x:Bind ViewModel.Directories, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedDirectory, Mode=TwoWay}"
                                  SelectionChanged="OnDirectorySelectionChanged"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DirectoryNode">
                                    <Grid Margin="0,4" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" 
                                                  Glyph="{x:Bind IconGlyph}" 
                                                  FontSize="16" 
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                                        <TextBlock Grid.Column="1" 
                                                   Text="{x:Bind Name}" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   VerticalAlignment="Center" 
                                                   ToolTipService.ToolTip="{x:Bind FullPath}" />

                                        <Border Grid.Column="2" 
                                                Background="{ThemeResource LayerFillColorAltBrush}" 
                                                CornerRadius="10" 
                                                Padding="6,2" 
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ClipCount, Mode=OneWay}" 
                                                       FontSize="11" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Fallback Prompt if No Folders -->
                        <StackPanel Visibility="{x:Bind ViewModel.Directories.Count, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                    Spacing="8" Margin="8,24,8,8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="No folders added" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="Add your captures folder to index game clips." 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap" 
                                       TextAlignment="Center" />
                            <Button Content="Choose Folder" HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnAddFolderClick" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Settings & Refresh -->
                <Grid Grid.Row="3" Margin="0,12,0,0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Left"
                            Command="{x:Bind ViewModel.OpenSettingsCommand}"
                            Style="{ThemeResource SubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock Text="Settings &amp; Storage" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" 
                            ToolTipService.ToolTip="Refresh Clips"
                            Command="{x:Bind ViewModel.RefreshClipsCommand}"
                            Style="{ThemeResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Right Main View (Clip Grid & Header) -->
        <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header & Search / Sort Toolbar -->
            <Border Grid.Row="0" 
                    Padding="24,18,24,14" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Folder Title and Count Info -->
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.SelectedDirectory.Name, Mode=OneWay, FallbackValue='Gameplay Library'}" 
                                   Style="{ThemeResource TitleTextBlockStyle}" 
                                   FontSize="22" 
                                   FontWeight="SemiBold" 
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.TotalClipsCount, Mode=OneWay}" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="clips" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="•" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalStorageUsedFormatted, Mode=OneWay}" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Search Box -->
                    <AutoSuggestBox Grid.Column="1" 
                                    Width="240" 
                                    PlaceholderText="Search clips..." 
                                    QueryIcon="Find"
                                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                    VerticalAlignment="Center" />

                    <!-- Sort Dropdown -->
                    <ComboBox Grid.Column="2" 
                              SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" 
                              VerticalAlignment="Center" 
                              Width="150">
                        <ComboBoxItem Content="Newest Date" />
                        <ComboBoxItem Content="Oldest Date" />
                        <ComboBoxItem Content="Name A-Z" />
                        <ComboBoxItem Content="Longest Duration" />
                        <ComboBoxItem Content="Largest Size" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Clip Cards Grid -->
            <ScrollViewer Grid.Row="1" Padding="20,16,20,16">
                <Grid>
                    <!-- GridView of Clips -->
                    <GridView ItemsSource="{x:Bind ViewModel.FilteredClips, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedClip, Mode=TwoWay}"
                              ItemClick="OnClipItemClick"
                              IsItemClickEnabled="True"
                              SelectionMode="Single">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="-1" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>

                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:GameClip">
                                <Grid Width="250" Height="220" Margin="6" CornerRadius="8"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      BorderThickness="1"
                                      RightTapped="OnClipCardRightTapped">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Video Thumbnail Area -->
                                    <Grid Grid.Row="0" CornerRadius="8,8,0,0">
                                        <!-- Thumbnail Image -->
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" 
                                               Stretch="UniformToFill" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" />

                                        <!-- Fallback Graphic if Thumbnail Loading -->
                                        <Grid Background="{ThemeResource LayerFillColorAltBrush}"
                                              Visibility="{x:Bind Thumbnail, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}">
                                            <FontIcon Glyph="&#xE714;" FontSize="36" 
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Hover Play Overlay Pill -->
                                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="#80000000" CornerRadius="20" Width="40" Height="40">
                                            <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="White" Margin="3,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Duration Badge (Bottom Right) -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Background="#B3000000" CornerRadius="4" Margin="0,0,8,8" Padding="6,2">
                                            <TextBlock Text="{x:Bind FormattedDuration, Mode=OneWay}" 
                                                       FontSize="11" FontWeight="Bold" Foreground="White" />
                                        </Border>

                                        <!-- Resolution Badge (Top Left) -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="#80000000" CornerRadius="4" Margin="8,8,0,0" Padding="5,2">
                                            <TextBlock Text="{x:Bind FormattedQuality, Mode=OneWay}" 
                                                       FontSize="10" FontWeight="SemiBold" Foreground="#E0E0E0" />
                                        </Border>

                                        <!-- Star / Favorite Badge (Top Right) -->
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="Transparent" BorderThickness="0" Margin="4,4,4,0"
                                                Click="OnFavoriteClick"
                                                Tag="{x:Bind}">
                                            <FontIcon Glyph="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource FavoriteGlyphConverter}}" 
                                                      FontSize="14" 
                                                      Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </Button>
                                    </Grid>

                                    <!-- Card Info Section -->
                                    <Grid Grid.Row="1" Padding="10,8,10,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Clip Title -->
                                        <TextBlock Grid.Row="0" 
                                                   Text="{x:Bind FileName, Mode=OneWay}" 
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" 
                                                   FontSize="13" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   ToolTipService.ToolTip="{x:Bind FileName, Mode=OneWay}" />

                                        <!-- Metadata Subline (Size and Date) -->
                                        <Grid Grid.Row="1" VerticalAlignment="Bottom">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" 
                                                       Text="{x:Bind FormattedDate, Mode=OneWay}" 
                                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="1" 
                                                       Text="{x:Bind FormattedFileSize, Mode=OneWay}" 
                                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- Loading Indicator -->
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                                  Width="48" Height="48" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <!-- Empty State View -->
                    <StackPanel Visibility="{x:Bind ViewModel.FilteredClips.Count, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <FontIcon Glyph="&#xE8B7;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No clips to show" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Choose another folder or add MP4/MKV video files to this directory." 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="2" Padding="16,6" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                               Style="{ThemeResource CaptionTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
