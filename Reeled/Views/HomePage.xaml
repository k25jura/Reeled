<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Reeled.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Reeled.Models"
    xmlns:viewmodels="using:Reeled.ViewModels"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <SplitView x:Name="MainSplitView"
               IsPaneOpen="{x:Bind ViewModel.IsSidebarOpen, Mode=TwoWay}"
               DisplayMode="Inline"
               OpenPaneLength="290"
               CompactPaneLength="0"
               PaneBackground="{ThemeResource LayerFillColorDefaultBrush}">
        <SplitView.Pane>
            <!-- Left Navigation Sidebar -->
            <Border Width="290"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: App Header & Collapse Button -->
                <Grid Grid.Row="0" Margin="14,14,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                            ToolTipService.ToolTip="Collapse Sidebar"
                            Click="OnToggleSidebarClick"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Margin="0,0,8,0"
                            Padding="6"
                            PointerPressed="OnItemPointerPressed"
                            PointerReleased="OnItemPointerReleased"
                            PointerCanceled="OnItemPointerCanceled">
                        <FontIcon Glyph="&#xE700;" FontSize="14" />
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Reeled" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>

                <!-- Row 1: Top Navigation Tabs (Home, Favorites, Saved Moments) -->
                <Grid Grid.Row="1" Margin="10,0,10,8" x:Name="TopNavContainer">
                    <StackPanel Spacing="3">
                        <!-- Home Tab -->
                        <Button x:Name="HomeNavButton"
                                Click="OnHomeTabClick"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="0"
                                Height="38"
                                CornerRadius="6"
                                BorderThickness="0"
                                Background="{x:Bind ViewModel.IsHomeSelected, Mode=OneWay, Converter={StaticResource SectionActiveBackgroundConverter}}"
                                Style="{ThemeResource SubtleButtonStyle}"
                                PointerPressed="OnItemPointerPressed">
                            <Grid Padding="14,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <FontIcon Grid.Column="0" Glyph="&#xE80F;" FontSize="16" 
                                          Foreground="{x:Bind ViewModel.IsHomeSelected, Mode=OneWay, Converter={StaticResource SectionActiveForegroundConverter}}" 
                                          Margin="0,0,12,0" />

                                <!-- Label -->
                                <TextBlock Grid.Column="1" Text="Home" FontSize="13" VerticalAlignment="Center"
                                           FontWeight="{x:Bind ViewModel.IsHomeSelected, Mode=OneWay, Converter={StaticResource SectionActiveFontWeightConverter}}"
                                           Foreground="{x:Bind ViewModel.IsHomeSelected, Mode=OneWay, Converter={StaticResource SectionActiveForegroundConverter}}" />

                                <!-- Counter (Clean text, no pill background) -->
                                <TextBlock Grid.Column="2" 
                                           Text="{x:Bind ViewModel.AllClipsCount, Mode=OneWay}" 
                                           FontSize="12" 
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind ViewModel.AllClipsCount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Button>

                        <!-- Favorites Tab -->
                        <Button x:Name="FavoritesNavButton"
                                Click="OnFavoritesTabClick"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="0"
                                Height="38"
                                CornerRadius="6"
                                BorderThickness="0"
                                Background="{x:Bind ViewModel.IsFavoritesSelected, Mode=OneWay, Converter={StaticResource SectionActiveBackgroundConverter}}"
                                Style="{ThemeResource SubtleButtonStyle}"
                                PointerPressed="OnItemPointerPressed">
                            <Grid Padding="14,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Heart Icon (EB52 = HeartFill) -->
                                <FontIcon Grid.Column="0" Glyph="&#xEB52;" FontSize="16" 
                                          Foreground="{x:Bind ViewModel.IsFavoritesSelected, Mode=OneWay, Converter={StaticResource SectionActiveForegroundConverter}}" 
                                          Margin="0,0,12,0" />

                                <!-- Label -->
                                <TextBlock Grid.Column="1" Text="Favorites" FontSize="13" VerticalAlignment="Center"
                                           FontWeight="{x:Bind ViewModel.IsFavoritesSelected, Mode=OneWay, Converter={StaticResource SectionActiveFontWeightConverter}}"
                                           Foreground="{x:Bind ViewModel.IsFavoritesSelected, Mode=OneWay, Converter={StaticResource SectionActiveForegroundConverter}}" />

                                <!-- Counter (Clean text, no pill background) -->
                                <TextBlock Grid.Column="2" 
                                           Text="{x:Bind ViewModel.FavoritesCount, Mode=OneWay}" 
                                           FontSize="12" 
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind ViewModel.FavoritesCount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Button>

                        <!-- Saved Moments Tab -->
                        <Button x:Name="SavedMomentsNavButton"
                                Click="OnSavedMomentsTabClick"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="0"
                                Height="38"
                                CornerRadius="6"
                                BorderThickness="0"
                                Background="{x:Bind ViewModel.IsSavedMomentsSelected, Mode=OneWay, Converter={StaticResource SectionActiveBackgroundConverter}}"
                                Style="{ThemeResource SubtleButtonStyle}"
                                PointerPressed="OnItemPointerPressed">
                            <Grid Padding="14,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <FontIcon Grid.Column="0" Glyph="&#xE8A4;" FontSize="16" 
                                          Foreground="{x:Bind ViewModel.IsSavedMomentsSelected, Mode=OneWay, Converter={StaticResource SectionActiveForegroundConverter}}" 
                                          Margin="0,0,12,0" />

                                <!-- Label -->
                                <TextBlock Grid.Column="1" Text="Saved Moments" FontSize="13" VerticalAlignment="Center"
                                           FontWeight="{x:Bind ViewModel.IsSavedMomentsSelected, Mode=OneWay, Converter={StaticResource SectionActiveFontWeightConverter}}"
                                           Foreground="{x:Bind ViewModel.IsSavedMomentsSelected, Mode=OneWay, Converter={StaticResource SectionActiveForegroundConverter}}" />

                                <!-- Counter (Clean text, no pill background) -->
                                <TextBlock Grid.Column="2" 
                                           Text="{x:Bind ViewModel.SavedMomentsCount, Mode=OneWay}" 
                                           FontSize="12" 
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind ViewModel.SavedMomentsCount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Windows 11 Settings Style Sliding Active Selection Indicator -->
                    <Border x:Name="ActiveIndicatorPill"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="3"
                            Height="16"
                            CornerRadius="1.5"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            IsHitTestVisible="False"
                            Opacity="1"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="IndicatorTranslation" X="0" Y="11" />
                                <ScaleTransform x:Name="IndicatorScale" ScaleX="1" ScaleY="1" />
                            </TransformGroup>
                        </Border.RenderTransform>
                    </Border>
                </Grid>

                <!-- Row 2: Separator -->
                <MenuFlyoutSeparator Grid.Row="2" Margin="14,2,14,8" />

                <!-- Row 3: Folders Header -->
                <Grid Grid.Row="3" Margin="16,0,14,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="FOLDERS" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               CharacterSpacing="60"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1" 
                            ToolTipService.ToolTip="Add Watch Folder"
                            Click="OnAddFolderClick"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="6,3"
                            PointerPressed="OnItemPointerPressed"
                            PointerReleased="OnItemPointerReleased"
                            PointerCanceled="OnItemPointerCanceled">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                            <TextBlock Text="Add" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Row 4: Folders TreeView -->
                <Grid Grid.Row="4" Margin="10,0,10,0">
                    <TreeView x:Name="DirectoriesTreeView"
                              ItemsSource="{x:Bind ViewModel.Directories, Mode=OneWay}"
                              ItemInvoked="OnDirectoryTreeItemInvoked"
                              Expanding="OnDirectoryExpanding"
                              Collapsed="OnDirectoryCollapsed"
                              SelectionMode="Single"
                              Padding="0,0,6,0"
                              Visibility="{x:Bind ViewModel.HasDirectories, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="MinHeight" Value="36" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="models:DirectoryNode">
                                <TreeViewItem ItemsSource="{x:Bind SubDirectories, Mode=OneWay}"
                                              IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                              MinHeight="36"
                                              CornerRadius="6"
                                              Margin="0,1">
                                    <Grid Margin="0,2,8,2" ColumnSpacing="8" VerticalAlignment="Center"
                                          PointerPressed="OnFolderPointerPressed"
                                          PointerExited="OnFolderPointerReset">
                                        <Grid.ChildrenTransitions>
                                            <TransitionCollection>
                                                <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="8" />
                                                <RepositionThemeTransition />
                                            </TransitionCollection>
                                        </Grid.ChildrenTransitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" 
                                                  Glyph="{x:Bind IconGlyph, Mode=OneWay}" 
                                                  FontSize="15" 
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" 
                                                  VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1" 
                                                   Text="{x:Bind DisplayName}" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   VerticalAlignment="Center" 
                                                   ToolTipService.ToolTip="{x:Bind FullPath}" />

                                        <TextBlock Grid.Column="2" 
                                                   Text="{x:Bind ClipCount, Mode=OneWay}" 
                                                   FontSize="12" 
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"
                                                   Visibility="{x:Bind ClipCount, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- Fallback Prompt if No Folders -->
                    <StackPanel Visibility="{x:Bind ViewModel.HasDirectories, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                Spacing="8" Margin="8,24,8,8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No folders added" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Add your captures folder to index game clips." 
                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center" />
                        <Button Content="Choose Folder" HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnAddFolderClick"
                                PointerPressed="OnItemPointerPressed"
                                PointerReleased="OnItemPointerReleased"
                                PointerCanceled="OnItemPointerCanceled" />
                    </StackPanel>
                </Grid>

                <!-- Row 5: Bottom Settings & Refresh (Separated Container with Card Background & Border) -->
                <Border Grid.Row="5" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="0,1,0,0" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="14,10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Left"
                                Command="{x:Bind ViewModel.OpenSettingsCommand}"
                                Style="{ThemeResource SubtleButtonStyle}"
                                PointerPressed="OnItemPointerPressed"
                                PointerReleased="OnItemPointerReleased"
                                PointerCanceled="OnItemPointerCanceled">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE713;" FontSize="16" />
                                <TextBlock Text="Settings &amp; Storage" VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" 
                                ToolTipService.ToolTip="Refresh Clips"
                                Command="{x:Bind ViewModel.RefreshClipsCommand}"
                                Style="{ThemeResource SubtleButtonStyle}"
                                PointerPressed="OnItemPointerPressed"
                                PointerReleased="OnItemPointerReleased"
                                PointerCanceled="OnItemPointerCanceled">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </SplitView.Pane>

    <SplitView.Content>
        <!-- Right Main View (Clip Grid & Header) -->
        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header & Search / Sort Toolbar -->
            <Border Grid.Row="0" 
                    Padding="24,14,24,14" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar Expand Button (Shown only when sidebar is collapsed) -->
                    <Button Grid.Column="0" 
                            Click="OnToggleSidebarClick"
                            ToolTipService.ToolTip="Show Sidebar"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsSidebarCollapsed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Padding="6" Margin="0,0,4,0"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE700;" FontSize="16" />
                    </Button>

                    <!-- Folder Title and Count Info -->
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.CurrentDirectoryTitle, Mode=OneWay}" 
                                   Style="{ThemeResource TitleTextBlockStyle}" 
                                   FontSize="22" 
                                   FontWeight="SemiBold" 
                                   TextTrimming="CharacterEllipsis" />
                        
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ClipsCountSummary, Mode=OneWay}" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="•" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalStorageUsedFormatted, Mode=OneWay}" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="•" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind ViewModel.CurrentDirectoryPath, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
                            
                            <!-- Clickable Breadcrumb Path to Open in File Explorer (when Folder section) -->
                            <HyperlinkButton Padding="0" Margin="0" MinHeight="0" MinWidth="0"
                                             Command="{x:Bind ViewModel.OpenCurrentDirectoryCommand}"
                                             ToolTipService.ToolTip="Open folder in File Explorer"
                                             Visibility="{x:Bind ViewModel.CanOpenDirectoryInExplorer, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEC50;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.CurrentDirectoryPath, Mode=OneWay}" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="450" />
                                </StackPanel>
                            </HyperlinkButton>

                            <!-- Informational subtitle (when Home, Favorites, or Saved Moments) -->
                            <TextBlock Text="{x:Bind ViewModel.CurrentDirectoryPath, Mode=OneWay}" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind ViewModel.CanOpenDirectoryInExplorer, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Search Box -->
                    <AutoSuggestBox Grid.Column="2" 
                                    Width="240" 
                                    PlaceholderText="Search clips..." 
                                    QueryIcon="Find"
                                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                    VerticalAlignment="Center" />

                    <!-- Sort Dropdown -->
                    <ComboBox Grid.Column="3" 
                              SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" 
                              VerticalAlignment="Center" 
                              Width="150">
                        <ComboBoxItem Content="Newest Date" />
                        <ComboBoxItem Content="Oldest Date" />
                        <ComboBoxItem Content="Name A-Z" />
                        <ComboBoxItem Content="Longest Duration" />
                        <ComboBoxItem Content="Largest Size" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Clip Cards Grid Container -->
            <Grid Grid.Row="1">
                <!-- GridView of Clips with Fluid Windows 11 Animations and Centered Layout -->
                <GridView ItemsSource="{x:Bind ViewModel.FilteredClips, Mode=OneWay}"
                          ItemClick="OnClipItemClick"
                          IsItemClickEnabled="True"
                          SelectionMode="None"
                          Padding="24,18,24,24">
                    
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="30" />
                            <AddDeleteThemeTransition />
                            <ReorderThemeTransition />
                        </TransitionCollection>
                    </GridView.ItemContainerTransitions>

                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Center" MaximumRowsOrColumns="-1" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="6" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewItem">
                                        <ContentPresenter ContentTransitions="{TemplateBinding ContentTransitions}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GridView.ItemContainerStyle>

                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:GameClip">
                            <Grid Width="254" Height="236" CornerRadius="8"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="1"
                                  PointerEntered="OnClipCardPointerEntered"
                                  PointerExited="OnClipCardPointerExited"
                                  PointerPressed="OnClipCardPointerPressed"
                                  PointerReleased="OnClipCardPointerReleased"
                                  PointerCanceled="OnClipCardPointerReleased"
                                  Tapped="OnClipCardTapped"
                                  DoubleTapped="OnClipCardDoubleTapped"
                                  RightTapped="OnClipCardRightTapped">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="142" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Video Thumbnail Area -->
                                <Grid Grid.Row="0" CornerRadius="8,8,0,0">
                                    <!-- Thumbnail Image -->
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" 
                                           Stretch="UniformToFill" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" />

                                    <!-- Fallback Graphic if Thumbnail Loading -->
                                    <Grid Background="{ThemeResource LayerFillColorAltBrush}"
                                          Visibility="{x:Bind Thumbnail, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}">
                                        <FontIcon Glyph="&#xE714;" FontSize="36" 
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Saved Moments Badge (Top Left Pill) -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Background="#D0000000" CornerRadius="12" Margin="8,8,0,0" Padding="7,3"
                                            Visibility="{x:Bind HasBookmarks, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8A4;" FontSize="11" Foreground="#FFD700" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind FormattedBookmarkCount, Mode=OneWay}" 
                                                       FontSize="11" FontWeight="Normal" Foreground="White" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Hover Play Overlay Pill (Animated on Hover) -->
                                    <Border x:Name="PlayOverlay"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="#99000000" CornerRadius="20" Width="40" Height="40"
                                            Opacity="0"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="PlayOverlayScale" ScaleX="0.8" ScaleY="0.8" />
                                        </Border.RenderTransform>
                                        <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="White" Margin="3,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Duration Badge (Bottom Right Pill) -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Background="#B3000000" CornerRadius="12" Margin="0,0,8,8" Padding="8,3">
                                        <TextBlock Text="{x:Bind FormattedDuration, Mode=OneWay}" 
                                                   FontSize="12" FontWeight="Normal" Foreground="White" />
                                    </Border>
                                </Grid>

                                <!-- Card Info Section -->
                                <Grid Grid.Row="1" Padding="12,8,10,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Clip Title & White Favorite Star Button -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                   Text="{x:Bind FileName, Mode=OneWay}" 
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" 
                                                   FontSize="13" 
                                                   MaxLines="2"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" 
                                                   ToolTipService.ToolTip="{x:Bind FileName, Mode=OneWay}" />

                                        <Button Grid.Column="1" 
                                                Style="{ThemeResource SubtleButtonStyle}" 
                                                Padding="4" Margin="4,0,0,0"
                                                ToolTipService.ToolTip="Toggle Favorite"
                                                Click="OnFavoriteClick"
                                                Tag="{x:Bind}">
                                            <FontIcon Glyph="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource FavoriteGlyphConverter}}" 
                                                      FontSize="14" 
                                                      Foreground="White"
                                                      Opacity="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource FavoriteOpacityConverter}}" />
                                        </Button>
                                    </Grid>

                                    <!-- Metadata Subline (Revealed on Hover with Fluid Slide & Fade) -->
                                    <Grid x:Name="MetadataRow" Grid.Row="1" VerticalAlignment="Bottom" Margin="0,4,0,0"
                                          Opacity="0">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="MetadataTransform" Y="4" />
                                        </Grid.RenderTransform>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                   Text="{x:Bind FormattedDate, Mode=OneWay}" 
                                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Background="{ThemeResource LayerFillColorAltBrush}" 
                                                    CornerRadius="4" Padding="5,1">
                                                <TextBlock Text="{x:Bind FormattedQuality, Mode=OneWay}" 
                                                           FontSize="10" 
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind FormattedFileSize, Mode=OneWay}" 
                                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- Loading Indicator with Solid Circular Background -->
                <Grid Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Border Width="56" Height="56" 
                            CornerRadius="28"
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                                      Width="34" Height="34" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Empty State View (Shown only when loading is complete and no clips) -->
                <StackPanel Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="{x:Bind ViewModel.EmptyStateGlyph, Mode=OneWay}" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyStateSubtitle, Mode=OneWay}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </SplitView.Content>
</SplitView>
</Page>
