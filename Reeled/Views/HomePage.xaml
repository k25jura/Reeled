<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Reeled.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Reeled.Models"
    xmlns:viewmodels="using:Reeled.ViewModels"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Smooth Navigation Tab Button Style -->
        <Style x:Key="NavTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="6">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition From="Normal" To="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuarticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                        <VisualTransition From="PointerOver" To="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuarticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Target="HoverBorder.Opacity" Value="0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverBorder.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverBorder.Opacity" Value="0.7" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <!-- Hover highlight matching folder tree -->
                            <Border x:Name="HoverBorder"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6"
                                    Opacity="0"
                                    IsHitTestVisible="False" />

                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Windows 11 TreeViewItem Style with Smooth Selection Indicator & Background Transitions -->
        <Style x:Key="CustomTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid x:Name="ContentPresenterGrid"
                               Background="Transparent"
                               CornerRadius="6"
                               MinHeight="0"
                               Margin="0,0,16,0"
                               Padding="0"
                               PointerPressed="OnFolderRowPointerPressed"
                               PointerReleased="OnFolderRowPointerReset"
                               PointerCanceled="OnFolderRowPointerReset">

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition From="Normal" To="Selected">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectedBackgroundBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SelectionIndicatorScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.20">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                        <VisualTransition From="PointerOver" To="Selected">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectedBackgroundBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SelectionIndicatorScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.20">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                        <VisualTransition From="Selected" To="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectedBackgroundBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SelectionIndicatorScale" Storyboard.TargetProperty="ScaleY" To="0.0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                        <VisualTransition From="Selected" To="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectedBackgroundBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SelectionIndicatorScale" Storyboard.TargetProperty="ScaleY" To="0.0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                        <VisualTransition From="Normal" To="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBackgroundBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualTransition>
                                        <VisualTransition From="PointerOver" To="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBackgroundBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>

                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Target="SelectedBackgroundBorder.Opacity" Value="0" />
                                            <Setter Target="HoverBackgroundBorder.Opacity" Value="0" />
                                            <Setter Target="SelectionIndicator.Opacity" Value="0" />
                                            <Setter Target="SelectionIndicatorScale.ScaleY" Value="0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="SelectedBackgroundBorder.Opacity" Value="0" />
                                            <Setter Target="HoverBackgroundBorder.Opacity" Value="1" />
                                            <Setter Target="SelectionIndicator.Opacity" Value="0" />
                                            <Setter Target="SelectionIndicatorScale.ScaleY" Value="0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="SelectedBackgroundBorder.Opacity" Value="0" />
                                            <Setter Target="HoverBackgroundBorder.Opacity" Value="0.8" />
                                            <Setter Target="SelectionIndicator.Opacity" Value="0" />
                                            <Setter Target="SelectionIndicatorScale.ScaleY" Value="0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="SelectedBackgroundBorder.Opacity" Value="1" />
                                            <Setter Target="HoverBackgroundBorder.Opacity" Value="0" />
                                            <Setter Target="SelectionIndicator.Opacity" Value="1" />
                                            <Setter Target="SelectionIndicatorScale.ScaleY" Value="1.0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="SelectedBackgroundBorder.Opacity" Value="1" />
                                            <Setter Target="HoverBackgroundBorder.Opacity" Value="0.4" />
                                            <Setter Target="SelectionIndicator.Opacity" Value="1" />
                                            <Setter Target="SelectionIndicatorScale.ScaleY" Value="1.0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="SelectedBackgroundBorder.Opacity" Value="1" />
                                            <Setter Target="HoverBackgroundBorder.Opacity" Value="0.6" />
                                            <Setter Target="SelectionIndicator.Opacity" Value="1" />
                                            <Setter Target="SelectionIndicatorScale.ScaleY" Value="1.0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenterGrid.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>

                                <VisualStateGroup x:Name="ExpansionStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition From="Collapsed" To="Expanded">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ChevronRotateTransform"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 To="90"
                                                                 Duration="0:0:0.20">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                        <VisualTransition From="Expanded" To="Collapsed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ChevronRotateTransform"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 To="0"
                                                                 Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>

                                    <VisualState x:Name="Collapsed">
                                        <VisualState.Setters>
                                            <Setter Target="ChevronRotateTransform.Angle" Value="0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Expanded">
                                        <VisualState.Setters>
                                            <Setter Target="ChevronRotateTransform.Angle" Value="90" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <!-- Hover background highlight -->
                            <Border x:Name="HoverBackgroundBorder" 
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                                    CornerRadius="6" 
                                    Opacity="0" 
                                    IsHitTestVisible="False" />

                            <!-- Selected background highlight -->
                            <Border x:Name="SelectedBackgroundBorder" 
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                                    CornerRadius="6" 
                                    Opacity="0" 
                                    IsHitTestVisible="False" />

                            <!-- Static SelectionIndicator hidden in favor of unified sliding ActiveIndicatorPill -->
                            <Rectangle x:Name="SelectionIndicator" 
                                       Visibility="Collapsed"
                                       Width="3" 
                                       Height="16" 
                                       Fill="{ThemeResource AccentFillColorDefaultBrush}" 
                                       Opacity="0" 
                                       HorizontalAlignment="Left" 
                                       VerticalAlignment="Center" 
                                       RadiusX="1.5" 
                                       RadiusY="1.5"
                                       RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="SelectionIndicatorScale" ScaleY="0.0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>

                            <!-- Row Layout: Indentation + Chevron + Content -->
                            <Grid MinHeight="36" Padding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.Indentation}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Chevron button with animated rotation and auto-hide when no subfolders -->
                                <Grid x:Name="ExpandCollapseChevron" 
                                      Grid.Column="0" 
                                      Padding="10,0,6,0" 
                                      Width="28" 
                                      VerticalAlignment="Center"
                                      Background="Transparent"
                                      PointerPressed="OnChevronPointerPressed">
                                    <FontIcon x:Name="ChevronIcon"
                                              Glyph="&#xE972;"
                                              FontSize="9"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5"
                                              Visibility="{Binding DataContext.HasSubDirectories, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <FontIcon.RenderTransform>
                                            <RotateTransform x:Name="ChevronRotateTransform" Angle="0" />
                                        </FontIcon.RenderTransform>
                                    </FontIcon>
                                </Grid>

                                <!-- ContentPresenter -->
                                <ContentPresenter x:Name="ContentPresenter" 
                                                  Grid.Column="1" 
                                                  Content="{TemplateBinding Content}" 
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" 
                                                  ContentTransitions="{TemplateBinding ContentTransitions}" 
                                                  Foreground="{TemplateBinding Foreground}" 
                                                  HorizontalAlignment="Stretch" 
                                                  VerticalAlignment="Center" 
                                                  Margin="0" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="MainRootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" SizeChanged="OnPageSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
            <ColumnDefinition x:Name="MainContentColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Column 0: Left Navigation Sidebar Container -->
        <Grid Grid.Column="0" 
              x:Name="SidebarContainer" 
              Width="316"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <!-- Inner content clipped and translated during collapse/expand -->
            <Border x:Name="SidebarContentBorder"
                    HorizontalAlignment="Left"
                    Width="316"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="0,0,1,0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SidebarTranslate" X="0" />
                </Border.RenderTransform>
            <Grid x:Name="SidebarRootGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: App Header & Collapse Button -->
                <Grid Grid.Row="0" Margin="14,10,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                            ToolTipService.ToolTip="Collapse Sidebar"
                            Click="OnToggleSidebarClick"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Margin="0,0,8,0"
                            Padding="6"
                            PointerPressed="OnItemPointerPressed"
                            PointerReleased="OnItemPointerReleased"
                            PointerCanceled="OnItemPointerCanceled">
                        <FontIcon Glyph="&#xE700;" FontSize="14" />
                    </Button>

                    <Image Grid.Column="1" 
                           x:Name="SidebarLogoImage"
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center"
                           Height="24"
                           Stretch="Uniform">
                        <Image.Source>
                            <SvgImageSource x:Name="SidebarLogoSvg" UriSource="ms-appx:///Assets/light-banner.svg" RasterizePixelHeight="72" />
                        </Image.Source>
                    </Image>
                </Grid>

                <!-- Row 1: Top Navigation Tabs (Home, Favorites, Saved Moments) -->
                <Grid Grid.Row="1" Margin="10,0,10,8" x:Name="TopNavContainer">
                    <StackPanel Spacing="3">
                        <!-- Home Tab -->
                        <Button x:Name="HomeNavButton"
                                Click="OnHomeTabClick"
                                Style="{StaticResource NavTabButtonStyle}"
                                PointerPressed="OnItemPointerPressed">
                            <Grid Height="38">
                                <Border x:Name="HomeSelectedBg"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <Grid Padding="14,0,12,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <FontIcon x:Name="HomeNavIcon" Grid.Column="0" Glyph="&#xE80F;" FontSize="16" Margin="0,0,12,0" />

                                    <!-- Label -->
                                    <TextBlock x:Name="HomeNavText" Grid.Column="1" Text="Home" FontSize="13" VerticalAlignment="Center" />

                                    <!-- Counter (Clean text, brightened) -->
                                    <TextBlock Grid.Column="2" 
                                               Text="{x:Bind ViewModel.AllClipsCount, Mode=OneWay}" 
                                               FontSize="12" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{x:Bind ViewModel.AllClipsCount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Grid>
                        </Button>

                        <!-- Favorites Tab -->
                        <Button x:Name="FavoritesNavButton"
                                Click="OnFavoritesTabClick"
                                Style="{StaticResource NavTabButtonStyle}"
                                PointerPressed="OnItemPointerPressed">
                            <Grid Height="38">
                                <Border x:Name="FavoritesSelectedBg"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <Grid Padding="14,0,12,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Heart Icon (EB52 = HeartFill) -->
                                    <FontIcon x:Name="FavoritesNavIcon" Grid.Column="0" Glyph="&#xEB52;" FontSize="16" Margin="0,0,12,0" />

                                    <!-- Label -->
                                    <TextBlock x:Name="FavoritesNavText" Grid.Column="1" Text="Favorites" FontSize="13" VerticalAlignment="Center" />

                                    <!-- Counter (Clean text, brightened) -->
                                    <TextBlock Grid.Column="2" 
                                               Text="{x:Bind ViewModel.FavoritesCount, Mode=OneWay}" 
                                               FontSize="12" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{x:Bind ViewModel.FavoritesCount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Grid>
                        </Button>

                        <!-- Saved Moments Tab -->
                        <Button x:Name="SavedMomentsNavButton"
                                Click="OnSavedMomentsTabClick"
                                Style="{StaticResource NavTabButtonStyle}"
                                PointerPressed="OnItemPointerPressed">
                            <Grid Height="38">
                                <Border x:Name="SavedMomentsSelectedBg"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <Grid Padding="14,0,12,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <FontIcon x:Name="SavedMomentsNavIcon" Grid.Column="0" Glyph="&#xE8A4;" FontSize="16" Margin="0,0,12,0" />

                                    <!-- Label -->
                                    <TextBlock x:Name="SavedMomentsNavText" Grid.Column="1" Text="Saved Moments" FontSize="13" VerticalAlignment="Center" />

                                    <!-- Counter (Clean text, brightened) -->
                                    <TextBlock Grid.Column="2" 
                                               Text="{x:Bind ViewModel.SavedMomentsCount, Mode=OneWay}" 
                                               FontSize="12" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{x:Bind ViewModel.SavedMomentsCount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Separator -->
                <MenuFlyoutSeparator Grid.Row="2" Margin="14,2,14,8" />

                <!-- Row 3: Folders Header -->
                <Grid Grid.Row="3" Margin="16,0,14,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="Folders" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1" 
                            ToolTipService.ToolTip="Add Watch Folder"
                            Click="OnAddFolderClick"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="6,3"
                            PointerPressed="OnItemPointerPressed"
                            PointerReleased="OnItemPointerReleased"
                            PointerCanceled="OnItemPointerCanceled">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                            <TextBlock Text="Add" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Row 4: Folders TreeView -->
                <Grid Grid.Row="4" Margin="10,0,6,0">
                    <TreeView x:Name="DirectoriesTreeView"
                              ItemsSource="{x:Bind ViewModel.Directories, Mode=OneWay}"
                              ItemInvoked="OnDirectoryTreeItemInvoked"
                              Expanding="OnDirectoryExpanding"
                              Collapsed="OnDirectoryCollapsed"
                              Loaded="OnDirectoriesTreeViewLoaded"
                              SelectionMode="Single"
                              Padding="0,0,2,0"
                              ItemContainerStyle="{StaticResource CustomTreeViewItemStyle}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind ViewModel.HasDirectories, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="models:DirectoryNode">
                                <TreeViewItem ItemsSource="{x:Bind SubDirectories, Mode=OneWay}"
                                              IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                              Loading="OnTreeViewItemLoading"
                                              Style="{StaticResource CustomTreeViewItemStyle}">
                                    <Grid Margin="0,0,8,0" ColumnSpacing="8" VerticalAlignment="Center"
                                          Loaded="OnFolderItemGridLoaded">
                                        <Grid.RenderTransform>
                                            <TranslateTransform />
                                        </Grid.RenderTransform>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" 
                                                  Glyph="{x:Bind IconGlyph, Mode=OneWay}" 
                                                  FontSize="15" 
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                  VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1" 
                                                   Text="{x:Bind DisplayName}" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   VerticalAlignment="Center" 
                                                   ToolTipService.ToolTip="{x:Bind FullPath}" />

                                        <TextBlock Grid.Column="2" 
                                                   Text="{x:Bind ClipCount, Mode=OneWay}" 
                                                   FontSize="12" 
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,2,0"
                                                   Visibility="{x:Bind ClipCount, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- Fallback Prompt if No Folders -->
                    <StackPanel Visibility="{x:Bind ViewModel.HasDirectories, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                Spacing="8" Margin="8,24,8,8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No folders added" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Add your captures folder to index game clips." 
                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center" />
                        <Button Content="Choose Folder" HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnAddFolderClick"
                                PointerPressed="OnItemPointerPressed"
                                PointerReleased="OnItemPointerReleased"
                                PointerCanceled="OnItemPointerCanceled" />
                    </StackPanel>
                </Grid>

                <!-- Row 5: Bottom Settings & Refresh (Integrated with Sidebar Background) -->
                <Border Grid.Row="5" 
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" 
                        BorderThickness="0,1,0,0" 
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Padding="14,10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                HorizontalAlignment="Left" 
                                HorizontalContentAlignment="Left"
                                Command="{x:Bind ViewModel.OpenSettingsCommand}"
                                Style="{ThemeResource SubtleButtonStyle}"
                                PointerPressed="OnItemPointerPressed"
                                PointerReleased="OnItemPointerReleased"
                                PointerCanceled="OnItemPointerCanceled">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE713;" FontSize="16" />
                                <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" 
                                ToolTipService.ToolTip="Refresh Clips"
                                Command="{x:Bind ViewModel.RefreshClipsCommand}"
                                Style="{ThemeResource SubtleButtonStyle}"
                                PointerPressed="OnItemPointerPressed"
                                PointerReleased="OnItemPointerReleased"
                                PointerCanceled="OnItemPointerCanceled">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Windows 11 Sliding Active Selection Indicator (Unified for Tabs & Folders) -->
                <Border x:Name="ActiveIndicatorPill"
                        Grid.RowSpan="6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Width="3"
                        Height="16"
                        CornerRadius="1.5"
                        Margin="10,0,0,0"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        IsHitTestVisible="False"
                        Opacity="1"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="IndicatorScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="IndicatorTranslation" X="0" Y="48" />
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Border>

        <!-- Interactive Resize Handle on right edge of sidebar container -->
        <Border x:Name="SidebarResizeHandle"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Width="10"
                Margin="0,0,-5,0"
                Background="Transparent"
                Canvas.ZIndex="10"
                PointerEntered="OnSidebarResizeHandlePointerEntered"
                PointerExited="OnSidebarResizeHandlePointerExited"
                PointerPressed="OnSidebarResizeHandlePointerPressed"
                PointerMoved="OnSidebarResizeHandlePointerMoved"
                PointerReleased="OnSidebarResizeHandlePointerReleased"
                PointerCanceled="OnSidebarResizeHandlePointerCanceled">
            <!-- Visual highlight line on hover/drag -->
            <Rectangle x:Name="ResizeHighlightLine" 
                       Width="2" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Stretch" 
                       Fill="{ThemeResource AccentFillColorDefaultBrush}" 
                       Opacity="0" />
        </Border>
    </Grid>

    <!-- Column 1: Right Main View (Clip Grid & Header) -->
    <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header & Search / Sort Toolbar -->
            <Border Grid.Row="0" 
                    Padding="24,36,24,12" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar Expand Button (Shown only when sidebar is collapsed) -->
                    <Button Grid.Column="0" 
                            Click="OnToggleSidebarClick"
                            ToolTipService.ToolTip="Show Sidebar"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsSidebarCollapsed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Padding="6" Margin="0,0,4,0"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE700;" FontSize="16" />
                    </Button>

                    <!-- Folder Title and Count Info -->
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.CurrentDirectoryTitle, Mode=OneWay}" 
                                   Style="{ThemeResource TitleTextBlockStyle}" 
                                   FontSize="22" 
                                   FontWeight="SemiBold" 
                                   TextTrimming="CharacterEllipsis" />
                        
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ClipsCountSummary, Mode=OneWay}" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="•" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalStorageUsedFormatted, Mode=OneWay}" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="•" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind ViewModel.CurrentDirectoryPath, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
                            
                            <!-- Clickable Breadcrumb Path to Open in File Explorer (when Folder section) -->
                            <HyperlinkButton Padding="0" Margin="0" MinHeight="0" MinWidth="0"
                                             Command="{x:Bind ViewModel.OpenCurrentDirectoryCommand}"
                                             ToolTipService.ToolTip="Open folder in File Explorer"
                                             Visibility="{x:Bind ViewModel.CanOpenDirectoryInExplorer, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEC50;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.CurrentDirectoryPath, Mode=OneWay}" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="450" />
                                </StackPanel>
                            </HyperlinkButton>

                            <!-- Informational subtitle (when Home, Favorites, or Saved Moments) -->
                            <TextBlock Text="{x:Bind ViewModel.CurrentDirectoryPath, Mode=OneWay}" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind ViewModel.CanOpenDirectoryInExplorer, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Search Box -->
                    <AutoSuggestBox Grid.Column="2" 
                                    Width="240" 
                                    PlaceholderText="Search clips..." 
                                    QueryIcon="Find"
                                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                    VerticalAlignment="Center" />

                    <!-- Sort Dropdown -->
                    <ComboBox Grid.Column="3" 
                              SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" 
                              VerticalAlignment="Center" 
                              Width="150">
                        <ComboBoxItem Content="Newest Date" />
                        <ComboBoxItem Content="Oldest Date" />
                        <ComboBoxItem Content="Name A-Z" />
                        <ComboBoxItem Content="Longest Duration" />
                        <ComboBoxItem Content="Largest Size" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Clip Cards Grid Container -->
            <Grid Grid.Row="1">
                <!-- GridView of Clips with Fluid Windows 11 Animations and Centered Layout -->
                <GridView x:Name="ClipsGridView"
                          ItemsSource="{x:Bind ViewModel.FilteredClips, Mode=OneWay}"
                          ItemClick="OnClipItemClick"
                          IsItemClickEnabled="True"
                          ContainerContentChanging="OnClipContainerContentChanging"
                          SelectionMode="None"
                          Padding="24,18,24,24"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="30" />
                            <AddDeleteThemeTransition />
                        </TransitionCollection>
                    </GridView.ItemContainerTransitions>

                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Center" MaximumRowsOrColumns="-1" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="6" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewItem">
                                        <ContentPresenter ContentTransitions="{TemplateBinding ContentTransitions}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GridView.ItemContainerStyle>

                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:GameClip">
                            <Grid Width="254" Height="236" CornerRadius="8"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="1"
                                  PointerEntered="OnClipCardPointerEntered"
                                  PointerExited="OnClipCardPointerExited"
                                  PointerPressed="OnClipCardPointerPressed"
                                  PointerReleased="OnClipCardPointerReleased"
                                  PointerCanceled="OnClipCardPointerReleased"
                                  Tapped="OnClipCardTapped"
                                  DoubleTapped="OnClipCardDoubleTapped"
                                  RightTapped="OnClipCardRightTapped">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="142" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Video Thumbnail Area -->
                                <Grid Grid.Row="0" CornerRadius="8,8,0,0">
                                    <!-- Thumbnail Image -->
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" 
                                           Stretch="UniformToFill" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" />

                                    <!-- Fallback Graphic if Thumbnail Loading -->
                                    <Grid Background="{ThemeResource LayerFillColorAltBrush}"
                                          Visibility="{x:Bind Thumbnail, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}">
                                        <FontIcon Glyph="&#xE714;" FontSize="36" 
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Saved Moments Badge (Bottom Left Pill) -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Background="#B3000000" CornerRadius="12" Margin="8,0,0,8" Padding="8,3"
                                            Visibility="{x:Bind HasBookmarks, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8A4;" FontSize="11" Foreground="#FFD700" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind FormattedBookmarkCount, Mode=OneWay}" 
                                                       FontSize="11" FontWeight="SemiBold" Foreground="#FFD700" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Hover Play Overlay Pill (Animated on Hover) -->
                                    <Border x:Name="PlayOverlay"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="#99000000" CornerRadius="20" Width="40" Height="40"
                                            Opacity="0"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="PlayOverlayScale" ScaleX="0.8" ScaleY="0.8" />
                                        </Border.RenderTransform>
                                        <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="White" Margin="3,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Duration Badge (Bottom Right Pill) -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Background="#B3000000" CornerRadius="12" Margin="0,0,8,8" Padding="8,3">
                                        <TextBlock Text="{x:Bind FormattedDuration, Mode=OneWay}" 
                                                   FontSize="12" FontWeight="Normal" Foreground="White" />
                                    </Border>
                                </Grid>

                                <!-- Card Info Section -->
                                <Grid Grid.Row="1" Padding="12,8,10,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Clip Title & White Favorite Star Button -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                   Text="{x:Bind FileName, Mode=OneWay}" 
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" 
                                                   FontSize="13" 
                                                   MaxLines="2"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" 
                                                   ToolTipService.ToolTip="{x:Bind FileName, Mode=OneWay}" />

                                        <Button Grid.Column="1" 
                                                Style="{ThemeResource SubtleButtonStyle}" 
                                                Padding="4" Margin="4,0,0,0"
                                                ToolTipService.ToolTip="Toggle Favorite"
                                                Click="OnFavoriteClick"
                                                Tag="{x:Bind}">
                                            <FontIcon Glyph="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource FavoriteGlyphConverter}}" 
                                                      FontSize="14" 
                                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                      Opacity="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource FavoriteOpacityConverter}}" />
                                        </Button>
                                    </Grid>

                                    <!-- Metadata Subline (Revealed on Hover with Fluid Slide & Fade) -->
                                    <Grid x:Name="MetadataRow" Grid.Row="1" VerticalAlignment="Bottom" Margin="0,4,0,0"
                                          Opacity="0">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="MetadataTransform" Y="4" />
                                        </Grid.RenderTransform>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                   Text="{x:Bind FormattedDate, Mode=OneWay}" 
                                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FormattedFileSize, Mode=OneWay}" 
                                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- Skeleton Loading Grid View (Shown when loading and skeleton loading enabled) -->
                <ScrollViewer Visibility="{x:Bind ViewModel.ShowSkeletonLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              Padding="24,18,24,24"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              IsHitTestVisible="False">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SkeletonPlaceholders, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Center" MaximumRowsOrColumns="-1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="254" Height="236" CornerRadius="8" Margin="6"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      BorderThickness="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="142" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Video Thumbnail Placeholder Area -->
                                    <Grid Grid.Row="0" CornerRadius="8,8,0,0" Background="{ThemeResource LayerFillColorAltBrush}">
                                        <FontIcon Glyph="&#xE714;" FontSize="32" 
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                                  Opacity="0.4"
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center" />
                                        <!-- Duration placeholder pill -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Background="#33000000" CornerRadius="9" Margin="0,0,8,8" Width="44" Height="18" />
                                    </Grid>

                                    <!-- Info Placeholder Area -->
                                    <Grid Grid.Row="1" Padding="12,12,10,10">
                                        <StackPanel Spacing="8" VerticalAlignment="Top">
                                            <Border Height="12" Width="160" HorizontalAlignment="Left" CornerRadius="4" 
                                                    Background="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.3" />
                                            <Border Height="10" Width="100" HorizontalAlignment="Left" CornerRadius="3" 
                                                    Background="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.2" />
                                        </StackPanel>

                                        <Grid VerticalAlignment="Bottom">
                                            <Border Height="9" Width="64" HorizontalAlignment="Left" CornerRadius="3" 
                                                    Background="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.15" />
                                            <Border Height="9" Width="42" HorizontalAlignment="Right" CornerRadius="3" 
                                                    Background="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.15" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Classic Circular ProgressRing (Shown when skeleton loading disabled in settings) -->
                <Grid Visibility="{x:Bind ViewModel.ShowProgressRingLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False">
                    <Border Width="56" Height="56" 
                            CornerRadius="28"
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressRing IsActive="{x:Bind ViewModel.ShowProgressRingLoading, Mode=OneWay}" 
                                      Width="34" Height="34" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Empty State View (Shown only when loading is complete and no clips) -->
                <StackPanel Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="{x:Bind ViewModel.EmptyStateGlyph, Mode=OneWay}" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyStateSubtitle, Mode=OneWay}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Invisible Warmup Container for Preloading & JIT Compilation of Storyboards -->
        <Canvas x:Name="AnimationWarmupCanvas" 
                Width="0" Height="0" 
                Opacity="0" 
                IsHitTestVisible="False" 
                Visibility="Visible" />
    </Grid>
</Page>
