<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Reeled.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    xmlns:models="using:Reeled.Models"
    xmlns:viewmodels="using:Reeled.ViewModels"
    mc:Ignorable="d"
    Background="#0F0F12"
    NavigationCacheMode="Required"
    KeyDown="OnPageKeyDown"
    PointerMoved="OnPagePointerMoved">

    <Grid x:Name="RootContainer">
        <!-- Main Video Viewport (Centered) -->
        <Grid Background="Black">
            <!-- LibVLCSharp WinUI VideoView -->
            <vlc:VideoView x:Name="PlayerVideoView" 
                           HorizontalAlignment="Stretch" 
                           VerticalAlignment="Stretch" 
                           Style="{StaticResource VideoViewDefaultStyle}"
                           Initialized="OnVideoViewInitialized" />

            <!-- Pause / Play Big Overlay Indicator on Click -->
            <Button Background="Transparent" 
                    BorderThickness="0" 
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch" 
                    Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                    Style="{ThemeResource SubtleButtonStyle}" />
        </Grid>

        <!-- Centered HUD Toast Notification (e.g. +5s, 1.5x, Muted) -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Background="#B3000000" 
                CornerRadius="8" 
                Padding="20,12" 
                Visibility="{x:Bind ViewModel.StatusToast, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{x:Bind ViewModel.StatusToast, Mode=OneWay}" 
                       FontSize="18" 
                       FontWeight="SemiBold" 
                       Foreground="White" 
                       HorizontalAlignment="Center" />
        </Border>

        <!-- Top Header Overlay (Telegram style) -->
        <Border VerticalAlignment="Top" 
                Background="#D916161A" 
                BorderBrush="#2A2A30" 
                BorderThickness="0,0,0,1" 
                Padding="16,10,16,10"
                Visibility="{x:Bind ViewModel.IsControlsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0" 
                        Command="{x:Bind ViewModel.BackToHomeCommand}" 
                        ToolTipService.ToolTip="Back to Library (Esc)"
                        Style="{ThemeResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" Foreground="White" />
                        <TextBlock Text="Library" FontSize="13" Foreground="White" />
                    </StackPanel>
                </Button>

                <!-- Clip Info (Title & Badges) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.CurrentClip.FileName, Mode=OneWay}" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="White" 
                               TextTrimming="CharacterEllipsis" 
                               MaxWidth="600" />

                    <Border Background="#33FFFFFF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.CurrentClip.FormattedQuality, Mode=OneWay}" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="#DDD" />
                    </Border>
                </StackPanel>

                <!-- Top Right Options -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button ToolTipService.ToolTip="Timeline Bookmarks / Moments"
                            Click="OnBookmarksButtonClick"
                            Style="{ThemeResource SubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE734;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Bookmarks.Count, Mode=OneWay}" FontSize="12" Foreground="White" />
                        </StackPanel>
                    </Button>

                    <Button ToolTipService.ToolTip="Clip Queue / Playlist"
                            Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                            Style="{ThemeResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE90B;" FontSize="14" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom Floating Control Bar (Telegram style) -->
        <Border VerticalAlignment="Bottom" 
                HorizontalAlignment="Center" 
                Margin="0,0,0,24" 
                Background="#E61A1A20" 
                BorderBrush="#383842" 
                BorderThickness="1" 
                CornerRadius="16" 
                Padding="16,10,16,12" 
                MinWidth="640" 
                MaxWidth="880"
                Visibility="{x:Bind ViewModel.IsControlsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 1: Scrubbing Slider & Visual Timeline Bookmark Pins -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Interactive Scrubbing Slider -->
                    <Slider x:Name="TimelineSlider" 
                            Grid.Row="0"
                            Minimum="0" 
                            Maximum="100" 
                            Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                            ValueChanged="OnTimelineSliderValueChanged"
                            Margin="0,0,0,-4" />

                    <!-- Timestamp Indicators (Current / Total) -->
                    <Grid Grid.Row="1" Margin="2,0,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="{x:Bind ViewModel.FormattedCurrentTime, Mode=OneWay}" 
                                   FontSize="12" 
                                   FontFamily="Consolas, Segoe UI" 
                                   Foreground="#C0C0C0" />

                        <!-- Active Bookmark Chip Indicator (if near a mark) -->
                        <TextBlock Grid.Column="1" 
                                   HorizontalAlignment="Center" 
                                   Text="{x:Bind ViewModel.CurrentClip.FormattedDuration, Mode=OneWay}" 
                                   FontSize="11" 
                                   Foreground="#808080" />

                        <TextBlock Grid.Column="2" 
                                   Text="{x:Bind ViewModel.FormattedTotalTime, Mode=OneWay}" 
                                   FontSize="12" 
                                   FontFamily="Consolas, Segoe UI" 
                                   Foreground="#C0C0C0" />
                    </Grid>
                </Grid>

                <!-- Row 2: Media Action Controls -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Previous, Play/Pause, Next, Skip -5s/+5s -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Prev Clip -->
                        <Button ToolTipService.ToolTip="Previous Clip"
                                IsEnabled="{x:Bind ViewModel.HasPreviousClip, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PlayPreviousCommand}"
                                Style="{ThemeResource SubtleButtonStyle}">
                            <FontIcon Glyph="&#xE892;" FontSize="13" Foreground="White" />
                        </Button>

                        <!-- Skip -5s -->
                        <Button ToolTipService.ToolTip="Skip 5s Back (Left Arrow)"
                                Command="{x:Bind ViewModel.SkipBackwardCommand}"
                                Style="{ThemeResource SubtleButtonStyle}">
                            <FontIcon Glyph="&#xE7A6;" FontSize="13" Foreground="White" />
                        </Button>

                        <!-- Big Play/Pause Toggle -->
                        <Button ToolTipService.ToolTip="Play / Pause (Space)"
                                Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                                Width="42" Height="42" CornerRadius="21"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="0"
                                Padding="0">
                            <FontIcon Glyph="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource PlayPauseGlyphConverter}}" 
                                      FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <!-- Skip +5s -->
                        <Button ToolTipService.ToolTip="Skip 5s Forward (Right Arrow)"
                                Command="{x:Bind ViewModel.SkipForwardCommand}"
                                Style="{ThemeResource SubtleButtonStyle}">
                            <FontIcon Glyph="&#xE7A7;" FontSize="13" Foreground="White" />
                        </Button>

                        <!-- Next Clip -->
                        <Button ToolTipService.ToolTip="Next Clip"
                                IsEnabled="{x:Bind ViewModel.HasNextClip, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PlayNextCommand}"
                                Style="{ThemeResource SubtleButtonStyle}">
                            <FontIcon Glyph="&#xE893;" FontSize="13" Foreground="White" />
                        </Button>
                    </StackPanel>

                    <!-- Center: Add Timeline Marker Button -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center">
                        <Button ToolTipService.ToolTip="Mark Moment (B)"
                                Click="OnAddMarkerClick"
                                Style="{ThemeResource SubtleButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7C1;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Mark Moment" FontSize="12" Foreground="White" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right: Volume, Speed, Fullscreen -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Volume Button with Flyout Slider -->
                        <DropDownButton ToolTipService.ToolTip="Volume (Up/Down Arrow)"
                                        Style="{ThemeResource SubtleButtonStyle}">
                            <FontIcon Glyph="{x:Bind ViewModel.IsMuted, Mode=OneWay, Converter={StaticResource VolumeGlyphConverter}}" 
                                      FontSize="14" Foreground="White" />
                            <DropDownButton.Flyout>
                                <Flyout>
                                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,4" Width="180">
                                        <Button Command="{x:Bind ViewModel.ToggleMuteCommand}" Style="{ThemeResource SubtleButtonStyle}">
                                            <FontIcon Glyph="{x:Bind ViewModel.IsMuted, Mode=OneWay, Converter={StaticResource VolumeGlyphConverter}}" FontSize="13" />
                                        </Button>
                                        <Slider Minimum="0" Maximum="100" 
                                                Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" 
                                                ValueChanged="OnVolumeSliderValueChanged"
                                                Width="120" />
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <!-- Speed Button with Dropdown -->
                        <DropDownButton ToolTipService.ToolTip="Playback Speed" Style="{ThemeResource SubtleButtonStyle}">
                            <TextBlock Text="{x:Bind ViewModel.FormattedPlaybackRate, Mode=OneWay}" 
                                       FontSize="12" FontWeight="SemiBold" Foreground="White" />
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="0.5x" Click="OnSpeedItemClick" Tag="0.5" />
                                    <MenuFlyoutItem Text="0.75x" Click="OnSpeedItemClick" Tag="0.75" />
                                    <MenuFlyoutItem Text="1.0x (Normal)" Click="OnSpeedItemClick" Tag="1.0" />
                                    <MenuFlyoutItem Text="1.25x" Click="OnSpeedItemClick" Tag="1.25" />
                                    <MenuFlyoutItem Text="1.5x" Click="OnSpeedItemClick" Tag="1.5" />
                                    <MenuFlyoutItem Text="2.0x" Click="OnSpeedItemClick" Tag="2.0" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <!-- Fullscreen Toggle -->
                        <Button ToolTipService.ToolTip="Fullscreen (F)"
                                Command="{x:Bind ViewModel.ToggleFullscreenCommand}"
                                Click="OnFullscreenButtonClick"
                                Style="{ThemeResource SubtleButtonStyle}">
                            <FontIcon Glyph="{x:Bind ViewModel.FullscreenGlyph, Mode=OneWay}" 
                                      FontSize="13" Foreground="White" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Collapsible Playlist Queue Sidebar (Slide-in Right) -->
        <Border HorizontalAlignment="Right" 
                Width="320" 
                Background="#F216161B" 
                BorderBrush="#2E2E36" 
                BorderThickness="1,0,0,0"
                Visibility="{x:Bind ViewModel.IsSidebarOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Padding="12,16,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,4,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Folder Clips" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="16" Foreground="White" />

                    <Button Grid.Column="1" 
                            Command="{x:Bind ViewModel.ToggleSidebarCommand}" 
                            Style="{ThemeResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="White" />
                    </Button>
                </Grid>

                <ListView Grid.Row="1" 
                          ItemsSource="{x:Bind ViewModel.Playlist, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.CurrentClip, Mode=OneWay}"
                          SelectionChanged="OnPlaylistSelectionChanged"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:GameClip">
                            <Grid Margin="0,4" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail Preview -->
                                <Grid Grid.Column="0" Height="42" CornerRadius="4">
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#B3000000" CornerRadius="3" Padding="3,1" Margin="0,0,2,2">
                                        <TextBlock Text="{x:Bind FormattedDuration, Mode=OneWay}" FontSize="9" Foreground="White" />
                                    </Border>
                                </Grid>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind FileName, Mode=OneWay}" 
                                               FontSize="12" FontWeight="SemiBold" Foreground="White" 
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind FormattedFileSize, Mode=OneWay}" 
                                               FontSize="11" Foreground="#999" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
