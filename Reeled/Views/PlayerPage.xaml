<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Reeled.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    xmlns:models="using:Reeled.Models"
    xmlns:viewmodels="using:Reeled.ViewModels"
    mc:Ignorable="d"
    Background="#0F0F12"
    KeyDown="OnPageKeyDown"
    PointerMoved="OnPagePointerMoved"
    PointerWheelChanged="OnPlayerPointerWheelChanged"
    PointerPressed="OnPlayerPagePointerPressed">

    <Page.Resources>
        <Style x:Key="CleanMediaOverlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid x:Name="RootContainer">
        <!-- Main Video Viewport (Centered) -->
        <Grid Background="Black">
            <!-- LibVLCSharp WinUI VideoView -->
            <vlc:VideoView x:Name="PlayerVideoView" 
                           HorizontalAlignment="Stretch" 
                           VerticalAlignment="Stretch" 
                           Style="{StaticResource VideoViewDefaultStyle}"
                           Initialized="OnVideoViewInitialized" />

            <!-- Pause / Play Big Overlay Indicator on Click -->
            <Button HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch" 
                    Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                    DoubleTapped="OnVideoOverlayDoubleTapped"
                    Style="{StaticResource CleanMediaOverlayButtonStyle}" />
        </Grid>

        <!-- VLC-style OSD Notification in Top Right Corner with solid black outline stroke -->
        <Grid x:Name="OsdToastContainer" 
              HorizontalAlignment="Right" 
              VerticalAlignment="Top" 
              Margin="0,48,48,0" 
              IsHitTestVisible="False"
              Visibility="Collapsed"
              Opacity="0">
            <!-- 8-Directional Black Outline Layers for solid 2px stroke -->
            <TextBlock Text="{x:Bind ViewModel.StatusToast, Mode=OneWay}" FontSize="64" FontWeight="Normal" Foreground="Black" Margin="-2,-2,2,2" />
            <TextBlock Text="{x:Bind ViewModel.StatusToast, Mode=OneWay}" FontSize="64" FontWeight="Normal" Foreground="Black" Margin="2,-2,-2,2" />
            <TextBlock Text="{x:Bind ViewModel.StatusToast, Mode=OneWay}" FontSize="64" FontWeight="Normal" Foreground="Black" Margin="-2,2,2,-2" />
            <TextBlock Text="{x:Bind ViewModel.StatusToast, Mode=OneWay}" FontSize="64" FontWeight="Normal" Foreground="Black" Margin="2,2,-2,-2" />
            <TextBlock Text="{x:Bind ViewModel.StatusToast, Mode=OneWay}" FontSize="64" FontWeight="Normal" Foreground="Black" Margin="0,-2,0,2" />
            <TextBlock Text="{x:Bind ViewModel.StatusToast, Mode=OneWay}" FontSize="64" FontWeight="Normal" Foreground="Black" Margin="0,2,0,-2" />
            <TextBlock Text="{x:Bind ViewModel.StatusToast, Mode=OneWay}" FontSize="64" FontWeight="Normal" Foreground="Black" Margin="-2,0,2,0" />
            <TextBlock Text="{x:Bind ViewModel.StatusToast, Mode=OneWay}" FontSize="64" FontWeight="Normal" Foreground="Black" Margin="2,0,-2,0" />

            <!-- Main White Foreground Text -->
            <TextBlock x:Name="OsdToastText"
                       Text="{x:Bind ViewModel.StatusToast, Mode=OneWay}"
                       FontSize="64" 
                       FontWeight="Normal" 
                       Foreground="White" />
        </Grid>

        <!-- Top Header Overlay (Telegram style) -->
        <Border x:Name="TopHeaderBar"
                VerticalAlignment="Top" 
                Background="#D916161A" 
                BorderBrush="#2A2A30" 
                BorderThickness="0,0,0,1" 
                Padding="16,8,16,8">
            <Grid>
                <!-- Centered File Title (Dead Center of Window) -->
                <TextBlock Text="{x:Bind ViewModel.CurrentClip.FileName, Mode=OneWay}" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Foreground="White" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" 
                           MaxWidth="550" />

                <!-- Left: Back Button -->
                <Button HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.BackToHomeCommand}" 
                        ToolTipService.ToolTip="Back to Library (Esc)"
                        IsTabStop="False"
                        Style="{ThemeResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" Foreground="White" />
                        <TextBlock Text="Library" FontSize="13" Foreground="White" />
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <!-- Bottom Control Bar (Full-width edge-to-edge, VLC layout, WinUI styling) -->
        <Border x:Name="BottomControlBar"
                VerticalAlignment="Bottom" 
                HorizontalAlignment="Stretch" 
                Margin="0" 
                Background="#D916161A" 
                BorderBrush="#2A2A30" 
                BorderThickness="0,1,0,0" 
                CornerRadius="0" 
                MinHeight="82"
                Padding="16,6,16,10">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Full-Width Scrubbing Slider with Left/Right Timestamps -->
                <Grid Grid.Row="0" ColumnSpacing="10" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="{x:Bind ViewModel.FormattedCurrentTime, Mode=OneWay}" 
                               FontSize="12" 
                               Foreground="#C0C0C0" 
                               VerticalAlignment="Center" 
                               MinWidth="42" />

                    <!-- Timeline Slider with Overlaid Moments Markers -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Slider x:Name="TimelineSlider" 
                                Minimum="0" 
                                Maximum="100" 
                                ThumbToolTipValueConverter="{StaticResource SliderTimestampTooltipConverter}"
                                Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                                ValueChanged="OnTimelineSliderValueChanged"
                                SizeChanged="OnTimelineSliderSizeChanged"
                                IsTabStop="False"
                                HorizontalAlignment="Stretch"
                                Margin="0" />

                        <!-- Moments Markers Canvas (Yellow ticks on the timeline) -->
                        <Canvas x:Name="TimelineMarkersCanvas"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                    </Grid>

                    <TextBlock Grid.Column="2" 
                               Text="{x:Bind ViewModel.FormattedTotalTime, Mode=OneWay}" 
                               FontSize="12" 
                               Foreground="#C0C0C0" 
                               VerticalAlignment="Center" 
                               MinWidth="42" 
                               TextAlignment="Right" />
                </Grid>

                <!-- Row 1: Controls (Left: Playback/Actions, Right: Fullscreen/Volume) -->
                <Grid Grid.Row="1" Margin="0,0,0,2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Grouped playback/seek/moments/tools sections with AppBarSeparators -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <!-- Section 1: Playback Controls -->
                        <Button ToolTipService.ToolTip="Play / Pause (Space)"
                                Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                                Width="34" Height="34"
                                Padding="0"
                                MinWidth="0" MinHeight="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                IsTabStop="False"
                                Style="{StaticResource PlayerIconButtonStyle}">
                            <FontIcon Glyph="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource PlayPauseGlyphConverter}}" 
                                      FontSize="15" Foreground="White" />
                        </Button>

                        <Button ToolTipService.ToolTip="Previous Clip"
                                IsEnabled="{x:Bind ViewModel.HasPreviousClip, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PlayPreviousCommand}"
                                Width="32" Height="32"
                                Padding="0"
                                MinWidth="0" MinHeight="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                IsTabStop="False"
                                Style="{StaticResource PlayerIconButtonStyle}">
                            <FontIcon Glyph="&#xE892;" FontSize="13" Foreground="White" />
                        </Button>

                        <Button ToolTipService.ToolTip="Stop (S)"
                                Command="{x:Bind ViewModel.StopCommand}"
                                Width="32" Height="32"
                                Padding="0"
                                MinWidth="0" MinHeight="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                IsTabStop="False"
                                Style="{StaticResource PlayerIconButtonStyle}">
                            <FontIcon Glyph="&#xE71A;" FontSize="13" Foreground="White" />
                        </Button>

                        <Button ToolTipService.ToolTip="Next Clip"
                                IsEnabled="{x:Bind ViewModel.HasNextClip, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PlayNextCommand}"
                                Width="32" Height="32"
                                Padding="0"
                                MinWidth="0" MinHeight="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                IsTabStop="False"
                                Style="{StaticResource PlayerIconButtonStyle}">
                            <FontIcon Glyph="&#xE893;" FontSize="13" Foreground="White" />
                        </Button>

                        <Button ToolTipService.ToolTip="{x:Bind ViewModel.RepeatTooltip, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ToggleRepeatModeCommand}"
                                Width="32" Height="32"
                                Padding="0"
                                MinWidth="0" MinHeight="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                IsTabStop="False"
                                Style="{StaticResource PlayerIconButtonStyle}">
                            <FontIcon Glyph="{x:Bind ViewModel.RepeatGlyph, Mode=OneWay}" 
                                      FontSize="13" 
                                      Foreground="White"
                                      Opacity="{x:Bind ViewModel.RepeatOpacity, Mode=OneWay}" />
                        </Button>

                        <AppBarSeparator Height="20" Margin="4,0" />

                        <!-- Section 2: Seek Controls -->
                        <Button ToolTipService.ToolTip="Skip 5s Back (Left Arrow)"
                                Command="{x:Bind ViewModel.SkipBackwardCommand}"
                                Width="32" Height="32"
                                Padding="0"
                                MinWidth="0" MinHeight="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                IsTabStop="False"
                                Style="{StaticResource PlayerIconButtonStyle}">
                            <FontIcon Glyph="&#xE7A6;" FontSize="13" Foreground="White" />
                        </Button>

                        <Button ToolTipService.ToolTip="Skip 5s Forward (Right Arrow)"
                                Command="{x:Bind ViewModel.SkipForwardCommand}"
                                Width="32" Height="32"
                                Padding="0"
                                MinWidth="0" MinHeight="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                IsTabStop="False"
                                Style="{StaticResource PlayerIconButtonStyle}">
                            <FontIcon Glyph="&#xE7A7;" FontSize="13" Foreground="White" />
                        </Button>

                        <AppBarSeparator Height="20" Margin="4,0" />

                        <!-- Section 3: Moments Controls -->
                        <Button ToolTipService.ToolTip="Mark Moment (B)"
                                Click="OnAddMarkerClick"
                                Width="32" Height="32"
                                Padding="0"
                                MinWidth="0" MinHeight="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                IsTabStop="False"
                                Style="{StaticResource PlayerIconButtonStyle}">
                            <FontIcon Glyph="&#xE7C1;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Button>

                        <Button ToolTipService.ToolTip="Timeline Bookmarks / Moments"
                                IsTabStop="False"
                                Padding="6,4"
                                MinHeight="32" MinWidth="32"
                                Style="{ThemeResource SubtleButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8A4;" FontSize="13" Foreground="#FFD700" />
                                <TextBlock Text="{x:Bind ViewModel.Bookmarks.Count, Mode=OneWay}" FontSize="12" Foreground="White" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <Grid MinWidth="300" MaxWidth="360" Padding="8,6" RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Moments Flyout Header -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE8A4;" FontSize="14" Foreground="#FFD700" />
                                                <TextBlock Text="Moments" FontWeight="SemiBold" FontSize="14" Foreground="White" />
                                                <TextBlock Text="{x:Bind ViewModel.Bookmarks.Count, Mode=OneWay}" 
                                                           FontSize="12" 
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button Grid.Column="1" 
                                                    ToolTipService.ToolTip="Mark Moment at Current Time (B)"
                                                    Click="OnAddMarkerClick"
                                                    Padding="8,4"
                                                    CornerRadius="4"
                                                    Style="{ThemeResource SubtleButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="Add" FontSize="12" Foreground="White" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Empty State -->
                                        <StackPanel Grid.Row="1" 
                                                    Spacing="4" 
                                                    Padding="12,24" 
                                                    HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind ViewModel.Bookmarks.Count, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <FontIcon Glyph="&#xE8A4;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                            <TextBlock Text="No moments marked yet" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Press 'B' while watching to mark a moment" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Moments List -->
                                        <ScrollViewer Grid.Row="1" 
                                                      MaxHeight="260" 
                                                      VerticalScrollBarVisibility="Auto"
                                                      Visibility="{x:Bind ViewModel.Bookmarks.Count, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.Bookmarks, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ClipBookmark">
                                                        <Grid Margin="0,2" Padding="4,2" ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Jump Button -->
                                                            <Button Grid.Column="0"
                                                                    Click="OnJumpToBookmarkItemClick"
                                                                    Tag="{x:Bind}"
                                                                    Padding="6,4"
                                                                    CornerRadius="4"
                                                                    ToolTipService.ToolTip="Jump to this moment"
                                                                    Style="{ThemeResource SubtleButtonStyle}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <FontIcon Glyph="&#xE768;" FontSize="10" Foreground="#FFD700" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{x:Bind FormattedTimestamp, Mode=OneWay}" 
                                                                               FontSize="12" 
                                                                               Foreground="White" 
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>

                                                            <!-- Label -->
                                                            <TextBlock Grid.Column="1" 
                                                                       Text="{x:Bind Label, Mode=OneWay}" 
                                                                       FontSize="12" 
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                                       VerticalAlignment="Center" 
                                                                       TextTrimming="CharacterEllipsis" 
                                                                       ToolTipService.ToolTip="{x:Bind Label, Mode=OneWay}" />

                                                            <!-- Rename / Edit Button -->
                                                            <Button Grid.Column="2" 
                                                                    Click="OnEditBookmarkItemClick"
                                                                    Tag="{x:Bind}"
                                                                    ToolTipService.ToolTip="Rename Moment"
                                                                    Width="28" Height="28"
                                                                    Padding="0" MinWidth="0" MinHeight="0"
                                                                    CornerRadius="4"
                                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                    Style="{StaticResource PlayerIconButtonStyle}">
                                                                <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Button>

                                                            <!-- Delete / Remove Button -->
                                                            <Button Grid.Column="3" 
                                                                    Click="OnRemoveBookmarkItemClick"
                                                                    Tag="{x:Bind}"
                                                                    ToolTipService.ToolTip="Remove Moment"
                                                                    Width="28" Height="28"
                                                                    Padding="0" MinWidth="0" MinHeight="0"
                                                                    CornerRadius="4"
                                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                    Style="{StaticResource PlayerIconButtonStyle}">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#FF6B6B" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <AppBarSeparator Height="20" Margin="4,0" />

                        <!-- Section 4: Queue, Speed & Info Controls -->
                        <Button ToolTipService.ToolTip="Clip Queue (Q)"
                                Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                                Width="32" Height="32"
                                Padding="0"
                                MinWidth="0" MinHeight="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                IsTabStop="False"
                                Style="{StaticResource PlayerIconButtonStyle}">
                            <FontIcon Glyph="&#xE90B;" FontSize="13" Foreground="White" />
                        </Button>

                        <DropDownButton ToolTipService.ToolTip="Playback Speed" 
                                        Padding="6,4"
                                        MinWidth="0" MinHeight="32"
                                        IsTabStop="False"
                                        Style="{ThemeResource SubtleButtonStyle}">
                            <TextBlock Text="{x:Bind ViewModel.FormattedPlaybackRate, Mode=OneWay}" 
                                       FontSize="12" Foreground="White" />
                            <DropDownButton.Flyout>
                                <Flyout Placement="Top">
                                    <StackPanel Spacing="10" MinWidth="220" MaxWidth="260" Padding="8,6">
                                        <!-- Header & Current Value -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Playback Speed" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" 
                                                       Text="{x:Bind ViewModel.FormattedPlaybackRate, Mode=OneWay}" 
                                                       FontSize="12" 
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Speed Presets Grid (2 rows of 4) -->
                                        <Grid ColumnSpacing="4" RowSpacing="4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Row="0" Grid.Column="0" Content="0.25x" Click="OnSpeedItemClick" Tag="0.25" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11" CornerRadius="4" Style="{ThemeResource SubtleButtonStyle}" />
                                            <Button Grid.Row="0" Grid.Column="1" Content="0.5x" Click="OnSpeedItemClick" Tag="0.5" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11" CornerRadius="4" Style="{ThemeResource SubtleButtonStyle}" />
                                            <Button Grid.Row="0" Grid.Column="2" Content="0.75x" Click="OnSpeedItemClick" Tag="0.75" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11" CornerRadius="4" Style="{ThemeResource SubtleButtonStyle}" />
                                            <Button Grid.Row="0" Grid.Column="3" Content="1.0x" Click="OnSpeedItemClick" Tag="1.0" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11" CornerRadius="4" Style="{ThemeResource SubtleButtonStyle}" />

                                            <Button Grid.Row="1" Grid.Column="0" Content="1.25x" Click="OnSpeedItemClick" Tag="1.25" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11" CornerRadius="4" Style="{ThemeResource SubtleButtonStyle}" />
                                            <Button Grid.Row="1" Grid.Column="1" Content="1.5x" Click="OnSpeedItemClick" Tag="1.5" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11" CornerRadius="4" Style="{ThemeResource SubtleButtonStyle}" />
                                            <Button Grid.Row="1" Grid.Column="2" Content="1.75x" Click="OnSpeedItemClick" Tag="1.75" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11" CornerRadius="4" Style="{ThemeResource SubtleButtonStyle}" />
                                            <Button Grid.Row="1" Grid.Column="3" Content="2.0x" Click="OnSpeedItemClick" Tag="2.0" HorizontalAlignment="Stretch" Padding="0,5" FontSize="11" CornerRadius="4" Style="{ThemeResource SubtleButtonStyle}" />
                                        </Grid>

                                        <!-- Divider line -->
                                        <Border Height="1" Background="#26FFFFFF" Margin="0,2" />

                                        <!-- Custom Speed Slider & Nudge Buttons -->
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <TextBlock Text="Custom Speed" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <Button HorizontalAlignment="Right" Content="Reset" Click="OnResetSpeedClick" Padding="6,2" FontSize="10" Style="{ThemeResource SubtleButtonStyle}" />
                                            </Grid>

                                            <Slider x:Name="CustomSpeedSlider"
                                                    Minimum="0.25" Maximum="3.0"
                                                    StepFrequency="0.05"
                                                    SmallChange="0.05"
                                                    LargeChange="0.25"
                                                    Value="{x:Bind ViewModel.PlaybackRate, Mode=OneWay}"
                                                    ValueChanged="OnCustomSpeedSliderValueChanged"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0" />

                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="- 0.05x" Click="OnSpeedStepDownClick" HorizontalAlignment="Stretch" Padding="0,4" FontSize="11" CornerRadius="4" Style="{ThemeResource SubtleButtonStyle}" />
                                                <Button Grid.Column="1" Content="+ 0.05x" Click="OnSpeedStepUpClick" HorizontalAlignment="Stretch" Padding="0,4" FontSize="11" CornerRadius="4" Style="{ThemeResource SubtleButtonStyle}" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <Button ToolTipService.ToolTip="Clip Information"
                                Width="32" Height="32"
                                Padding="0"
                                MinWidth="0" MinHeight="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                IsTabStop="False"
                                Style="{StaticResource PlayerIconButtonStyle}">
                            <FontIcon Glyph="&#xE700;" FontSize="13" Foreground="White" />
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <StackPanel Spacing="10" MinWidth="260" MaxWidth="340" Padding="8,6">
                                        <TextBlock Text="Clip Information" FontWeight="SemiBold" FontSize="14" Foreground="White" />
                                        
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="File Name" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.CurrentClip.FileName, Mode=OneWay}" FontSize="12" Foreground="White" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            
                                             <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="Duration" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.FormattedTotalTime, Mode=OneWay}" FontSize="12" Foreground="White" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="Bookmarks" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.Bookmarks.Count, Mode=OneWay}" FontSize="12" Foreground="White" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Date Modified" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.CurrentClip.FormattedDate, Mode=OneWay}" FontSize="12" Foreground="White" />
                                        </StackPanel>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="File Path" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.CurrentClip.FilePath, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- Right: Audio Track Selector, Mute Button, Volume Slider, Percentage Text, Separator, Fullscreen Button (Far Right) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Video Audio Track Selector -->
                        <DropDownButton ToolTipService.ToolTip="Audio Track"
                                        Width="32" Height="32"
                                        Padding="0"
                                        MinWidth="0" MinHeight="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        IsTabStop="False"
                                        Style="{StaticResource PlayerIconButtonStyle}">
                            <FontIcon Glyph="&#xE8D4;" FontSize="13" Foreground="White" />
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="AudioTracksMenuFlyout" Opening="OnAudioTracksMenuFlyoutOpening">
                                    <MenuFlyoutItem Text="Default Audio Track" IsEnabled="False" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <Button ToolTipService.ToolTip="Mute / Unmute (M)"
                                Command="{x:Bind ViewModel.ToggleMuteCommand}"
                                Width="32" Height="32"
                                Padding="0"
                                MinWidth="0" MinHeight="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                IsTabStop="False"
                                Style="{StaticResource PlayerIconButtonStyle}">
                            <FontIcon Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}" 
                                      FontSize="14" Foreground="White" />
                        </Button>

                        <Slider x:Name="VolumeSlider" 
                                Minimum="0" Maximum="100" 
                                Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" 
                                ValueChanged="OnVolumeSliderValueChanged"
                                PointerWheelChanged="OnPlayerPointerWheelChanged"
                                IsTabStop="False"
                                Width="90" 
                                VerticalAlignment="Center"
                                Margin="0" />

                        <TextBlock Text="{x:Bind ViewModel.Volume, Mode=OneWay}" 
                                   FontSize="12" 
                                   Foreground="#C0C0C0" 
                                   VerticalAlignment="Center" 
                                   MinWidth="24" 
                                   TextAlignment="Right" />
                        <TextBlock Text="%" FontSize="11" Foreground="#808080" VerticalAlignment="Center" Margin="-4,0,0,0" />

                        <AppBarSeparator Height="20" Margin="4,0" />

                        <Button ToolTipService.ToolTip="Fullscreen (F)"
                                Click="OnFullscreenButtonClick"
                                Width="32" Height="32"
                                Padding="0"
                                MinWidth="0" MinHeight="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                IsTabStop="False"
                                Style="{StaticResource PlayerIconButtonStyle}">
                            <FontIcon Glyph="{x:Bind ViewModel.FullscreenGlyph, Mode=OneWay}" 
                                      FontSize="13" Foreground="White" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Moments Jump Suggestion Popup (Bottom-Left) -->
        <Border x:Name="MomentsJumpPopup"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="24,0,0,96"
                Width="320"
                MaxHeight="260"
                Background="#2C2C2E"
                BorderBrush="#383838"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Opacity="0"
                Visibility="Collapsed"
                PointerEntered="OnMomentsPopupPointerEntered"
                PointerExited="OnMomentsPopupPointerExited">
            <Border.RenderTransform>
                <TranslateTransform x:Name="MomentsPopupTranslation" Y="24" />
            </Border.RenderTransform>
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header: Icon + Title + Close button -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8A4;" FontSize="14" Foreground="#FFD700" />
                        <TextBlock Text="Moments in this clip" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Click="OnDismissMomentsPopupClick"
                            Width="26" Height="26"
                            Padding="0" MinWidth="0" MinHeight="0"
                            CornerRadius="4"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            ToolTipService.ToolTip="Dismiss"
                            Style="{StaticResource PlayerIconButtonStyle}">
                        <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                </Grid>

                <!-- List of Bookmarked Moments to Choose From -->
                <ScrollViewer Grid.Row="1" MaxHeight="190" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MomentsPopupItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ClipBookmark">
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Margin="0,2"
                                        Padding="8,6"
                                        CornerRadius="4"
                                        Click="OnPopupBookmarkItemClick"
                                        Tag="{x:Bind}"
                                        Style="{ThemeResource SubtleButtonStyle}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Play Glyph + Timestamp -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE768;" FontSize="10" Foreground="#FFD700" />
                                            <TextBlock Text="{x:Bind FormattedTimestamp, Mode=OneWay}" 
                                                       FontSize="12" 
                                                       Foreground="White" 
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Label -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{x:Bind Label, Mode=OneWay}" 
                                                   FontSize="12" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                   VerticalAlignment="Center" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   ToolTipService.ToolTip="{x:Bind Label, Mode=OneWay}" />

                                        <!-- Jump Arrow Glyph -->
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Collapsible Playlist Queue Sidebar (Slide-in Right) -->
        <Border x:Name="PlaylistQueueSidebar"
                HorizontalAlignment="Right" 
                Width="320" 
                Background="#F216161B" 
                BorderBrush="#2E2E36" 
                BorderThickness="1,0,0,0"
                Opacity="0"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SidebarTranslation" X="320" />
            </Border.RenderTransform>
            <Grid Padding="16,44,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header situated safely below the 36px OS titlebar / caption buttons -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE90B;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Clip Queue" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="{x:Bind ViewModel.Playlist.Count, Mode=OneWay}" FontSize="12" Foreground="#808080" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1" 
                            ToolTipService.ToolTip="Close Queue (Esc / Q)"
                            Command="{x:Bind ViewModel.ToggleSidebarCommand}" 
                            Width="32" Height="32"
                            Padding="0"
                            MinWidth="0" MinHeight="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            IsTabStop="False"
                            Style="{StaticResource PlayerIconButtonStyle}">
                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="White" />
                    </Button>
                </Grid>

                <ListView Grid.Row="1" 
                          ItemsSource="{x:Bind ViewModel.Playlist, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.CurrentClip, Mode=OneWay}"
                          SelectionChanged="OnPlaylistSelectionChanged"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:GameClip">
                            <Grid Margin="0,4" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail Preview -->
                                <Grid Grid.Column="0" Height="42" CornerRadius="4">
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#B3000000" CornerRadius="3" Padding="3,1" Margin="0,0,2,2">
                                        <TextBlock Text="{x:Bind FormattedDuration, Mode=OneWay}" FontSize="9" Foreground="White" />
                                    </Border>
                                </Grid>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind FileName, Mode=OneWay}" 
                                               FontSize="12" FontWeight="SemiBold" Foreground="White" 
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind FormattedFileSize, Mode=OneWay}" 
                                               FontSize="11" Foreground="#999" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
