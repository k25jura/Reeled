<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Reeled.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Reeled.ViewModels"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer Padding="32,24,32,32">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="24">
                <!-- Header with Back button -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                            Command="{x:Bind ViewModel.BackToHomeCommand}" 
                            Style="{ThemeResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" FontSize="24" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Manage watch directories, caching, and playback behavior" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Watch Folders Section -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Watch Folders" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="16" />
                                <TextBlock Text="Directories scanned for MP4, MKV, and AVI gameplay clips" 
                                           Style="{ThemeResource CaptionTextBlockStyle}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Button Grid.Column="1" 
                                    Click="OnAddFolderClick" 
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Add Folder" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListView ItemsSource="{x:Bind ViewModel.WatchFolders, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,4" />
                                    <Setter Property="MinHeight" Value="36" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid Margin="0,2" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2" 
                                                Click="OnRemoveFolderClick" 
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Remove Watch Folder" 
                                                Style="{ThemeResource SubtleButtonStyle}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Cache & Storage Section -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Thumbnail Cache" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="16" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Current cache storage:" 
                                           Style="{ThemeResource CaptionTextBlockStyle}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CacheSizeFormatted, Mode=OneWay}" 
                                           Style="{ThemeResource CaptionTextBlockStyle}" 
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Command="{x:Bind ViewModel.ClearCacheCommand}" 
                                Content="Clear Cache" 
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- About & Engine Section -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="About Reeled" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="16" />
                        <TextBlock Text="Reeled - Clip Player" FontWeight="Normal" />
                        <TextBlock Text="Powered by LibVLCSharp &amp; VideoLAN LibVLC 3.0 Native Engine." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Version 1.0.0 (.NET 8 Windows App SDK)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" 
                           Margin="4,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
