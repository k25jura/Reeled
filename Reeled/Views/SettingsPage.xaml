<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Reeled.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Reeled.ViewModels"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer x:Name="SettingsScrollViewer" Padding="32,48,32,32">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="24">
                <!-- Header with Back button -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                            Command="{x:Bind ViewModel.BackToHomeCommand}" 
                            Style="{ThemeResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" FontSize="24" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Manage watch directories, caching, and playback behavior" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Watch Folders Section -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Watch Folders" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="16" />
                                <TextBlock Text="Directories scanned for MP4, MKV, and AVI gameplay clips" 
                                           Style="{ThemeResource CaptionTextBlockStyle}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Button Grid.Column="1" 
                                    Click="OnAddFolderClick" 
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Add Folder" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListView ItemsSource="{x:Bind ViewModel.WatchFolders, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,4" />
                                    <Setter Property="MinHeight" Value="36" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid Margin="0,2" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2" 
                                                Click="OnRemoveFolderClick" 
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Remove Watch Folder" 
                                                Style="{ThemeResource SubtleButtonStyle}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Cache & Storage Section -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Performance &amp; Storage" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="18" FontWeight="SemiBold" />

                    <!-- Thumbnail Cache Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="20">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Thumbnail Cache" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="15" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Disk storage used:" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.CacheSizeFormatted, Mode=OneWay}" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1" 
                                    Command="{x:Bind ViewModel.ClearCacheCommand}" 
                                    Content="Clear Thumbnails" 
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Clip Metadata Cache Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="20">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Clip Metadata Cache" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="15" />
                                <TextBlock Text="Speeds up library loading and folder switching for large clip collections" 
                                           Style="{ThemeResource CaptionTextBlockStyle}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                    <TextBlock Text="Cache status:" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.ClipCacheSizeFormatted, Mode=OneWay}" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1" 
                                    Command="{x:Bind ViewModel.ClearClipCacheCommand}" 
                                    Content="Clear Metadata" 
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Skeleton Loading Setting Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="20">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Skeleton Loading Placeholders" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="15" />
                                <TextBlock Text="Show animated placeholder cards while scanning directories or loading video clips" 
                                           Style="{ThemeResource CaptionTextBlockStyle}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ToggleSwitch Grid.Column="1" 
                                          IsOn="{x:Bind ViewModel.EnableSkeletonLoading, Mode=TwoWay}" 
                                          OnContent="On" 
                                          OffContent="Off" 
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Hardware Acceleration Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="20">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Hardware-Accelerated Video Decoding" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="15" />
                                <TextBlock Text="Use GPU hardware decoding. Turn off if experiencing color distortion with graphics overlays (like NVIDIA RTX Dynamic Vibrance)." 
                                           Style="{ThemeResource CaptionTextBlockStyle}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <ToggleSwitch Grid.Column="1" 
                                          IsOn="{x:Bind ViewModel.EnableHardwareAcceleration, Mode=TwoWay}" 
                                          OnContent="On" 
                                          OffContent="Off" 
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Playback Options Section -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Playback Options" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="18" FontWeight="SemiBold" />

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="20">
                        <StackPanel Spacing="16">
                            <!-- Default Playback Speed -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Default Playback Speed" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="15" />
                                    <TextBlock Text="Initial speed when playing videos" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ComboBox Grid.Column="1" 
                                          x:Name="DefaultSpeedComboBox"
                                          SelectionChanged="OnDefaultSpeedSelectionChanged"
                                          MinWidth="120"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="0.5x" Tag="0.5" />
                                    <ComboBoxItem Content="0.75x" Tag="0.75" />
                                    <ComboBoxItem Content="1.0x (Normal)" Tag="1.0" />
                                    <ComboBoxItem Content="1.25x" Tag="1.25" />
                                    <ComboBoxItem Content="1.5x" Tag="1.5" />
                                    <ComboBoxItem Content="2.0x" Tag="2.0" />
                                </ComboBox>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2" />

                            <!-- Remember Last Playback Speed -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Remember Last Playback Speed" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="15" />
                                    <TextBlock Text="Keep the adjusted playback speed across clips instead of resetting to default" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ToggleSwitch Grid.Column="1" 
                                              IsOn="{x:Bind ViewModel.RememberPlaybackSpeed, Mode=TwoWay}" 
                                              OnContent="On" 
                                              OffContent="Off" 
                                              VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Appearance Section -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="18" FontWeight="SemiBold" />

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="20">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="App Theme" Style="{ThemeResource SubtitleTextBlockStyle}" FontSize="15" />
                                <TextBlock Text="Select which theme to display, or synchronize with Windows settings" 
                                           Style="{ThemeResource CaptionTextBlockStyle}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ComboBox Grid.Column="1" 
                                      x:Name="ThemeComboBox"
                                      SelectionChanged="OnThemeSelectionChanged"
                                      MinWidth="160"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="Windows default" Tag="Default" />
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- About & Engine Section -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="24">
                    <StackPanel Spacing="14">
                        <Image HorizontalAlignment="Left" 
                               x:Name="SettingsLogoImage"
                               Height="34" 
                               Stretch="Uniform">
                            <Image.Source>
                                <SvgImageSource x:Name="SettingsLogoSvg" UriSource="ms-appx:///Assets/light-banner.svg" RasterizePixelHeight="102" />
                            </Image.Source>
                        </Image>
                        <TextBlock Text="Clip Player &amp; Highlights Library" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   FontSize="13" />
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,2" />
                        <TextBlock Text="Powered by LibVLCSharp &amp; VideoLAN LibVLC 3.0 Native Engine." 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Version 1.0.0 (.NET 8 Windows App SDK)" 
                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" 
                           Margin="4,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
