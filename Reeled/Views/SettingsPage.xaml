<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Reeled.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Reeled.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Category Navigation Rail Button Style with Smooth Transitions -->
        <Style x:Key="SettingsCategoryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="7">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ButtonScale" ScaleX="1.0" ScaleY="1.0" />
                            </Grid.RenderTransform>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition From="Normal" To="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                        <VisualTransition From="PointerOver" To="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Target="HoverBorder.Opacity" Value="0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverBorder.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverBorder.Opacity" Value="0.7" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <!-- Hover background -->
                            <Border x:Name="HoverBorder"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="7"
                                    Opacity="0"
                                    IsHitTestVisible="False" />

                            <!-- Selected background highlight (ThemeResource aware - light in light mode, dark in dark mode) -->
                            <Border x:Name="SelectedBorder"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="7"
                                    Opacity="0"
                                    IsHitTestVisible="False" />

                            <ContentPresenter Content="{TemplateBinding Content}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Directory Anchor Link Button Style with Pointer Cursor & Hover Accent -->
        <Style x:Key="DirectoryAnchorButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" 
                              Background="{TemplateBinding Background}" 
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- Row 0: Sticky Top Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Split Navigation Body -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sticky Header Bar (Increased size, spacious, prominent) -->
        <Grid Grid.Row="0"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              MinHeight="68"
              Padding="36,16,36,16"
              Canvas.ZIndex="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Back to Home Button -->
            <Button Grid.Column="0" 
                    x:Name="BackToHomeButton"
                    Command="{x:Bind ViewModel.BackToHomeCommand}" 
                    Style="{ThemeResource SubtleButtonStyle}"
                    Padding="10"
                    CornerRadius="8"
                    ToolTipService.ToolTip="Back to Library"
                    Margin="0,0,16,0">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>

            <!-- Settings Title with Icon -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE713;" FontSize="22" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="SettingsTitleText"
                           Text="Settings" 
                           Style="{ThemeResource TitleTextBlockStyle}" 
                           FontSize="24" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Main Body: Left Category Sidebar & Centered Settings Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Category Navigation Sidebar Rail -->
                <ColumnDefinition Width="Auto" />
                <!-- Column 1: Centered Settings Content Pane -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Category Navigation Sidebar Rail (Floating left-center with sliding handle pill) -->
            <Grid x:Name="CategoriesNavRoot"
                  Grid.Column="0"
                  Width="230"
                  Margin="28,0,16,0"
                  VerticalAlignment="Center">

                <!-- Sliding Active Handle Indicator Pill (Matching main page sidebar) -->
                <Border x:Name="ActiveIndicatorPill"
                        Width="3"
                        Height="18"
                        CornerRadius="1.5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="IndicatorTranslation" Y="0" />
                            <ScaleTransform x:Name="IndicatorScale" ScaleY="0" CenterY="9" />
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>

                <!-- Category Buttons Stack -->
                <StackPanel x:Name="CategoriesStackPanel" Spacing="4" Margin="10,0,0,0">
                    <!-- 1. Folders -->
                    <Button x:Name="CatFoldersBtn"
                            Click="OnCategoryButtonClick"
                            PointerPressed="OnCategoryPointerPressed"
                            PointerReleased="OnCategoryPointerReleased"
                            PointerCanceled="OnCategoryPointerReleased"
                            Tag="FoldersSection"
                            Style="{StaticResource SettingsCategoryButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="CatFoldersIcon" Grid.Column="0" Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CatFoldersText" Grid.Column="1" Text="Watch Folders" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- 2. Playback -->
                    <Button x:Name="CatPlaybackBtn"
                            Click="OnCategoryButtonClick"
                            PointerPressed="OnCategoryPointerPressed"
                            PointerReleased="OnCategoryPointerReleased"
                            PointerCanceled="OnCategoryPointerReleased"
                            Tag="PlaybackSection"
                            Style="{StaticResource SettingsCategoryButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="CatPlaybackIcon" Grid.Column="0" Glyph="&#xE768;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CatPlaybackText" Grid.Column="1" Text="Playback" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- 3. Appearance -->
                    <Button x:Name="CatAppearanceBtn"
                            Click="OnCategoryButtonClick"
                            PointerPressed="OnCategoryPointerPressed"
                            PointerReleased="OnCategoryPointerReleased"
                            PointerCanceled="OnCategoryPointerReleased"
                            Tag="AppearanceSection"
                            Style="{StaticResource SettingsCategoryButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="CatAppearanceIcon" Grid.Column="0" Glyph="&#xE790;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CatAppearanceText" Grid.Column="1" Text="Appearance" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- 4. Language & Region -->
                    <Button x:Name="CatLanguageBtn"
                            Click="OnCategoryButtonClick"
                            PointerPressed="OnCategoryPointerPressed"
                            PointerReleased="OnCategoryPointerReleased"
                            PointerCanceled="OnCategoryPointerReleased"
                            Tag="LocalizationSection"
                            Style="{StaticResource SettingsCategoryButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="CatLanguageIcon" Grid.Column="0" Glyph="&#xE774;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CatLanguageText" Grid.Column="1" Text="Language &amp; Region" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- 5. Performance & Storage -->
                    <Button x:Name="CatStorageBtn"
                            Click="OnCategoryButtonClick"
                            PointerPressed="OnCategoryPointerPressed"
                            PointerReleased="OnCategoryPointerReleased"
                            PointerCanceled="OnCategoryPointerReleased"
                            Tag="StorageSection"
                            Style="{StaticResource SettingsCategoryButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="CatStorageIcon" Grid.Column="0" Glyph="&#xE74C;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CatStorageText" Grid.Column="1" Text="Storage &amp; Cache" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- 6. Updates -->
                    <Button x:Name="CatUpdatesBtn"
                            Click="OnCategoryButtonClick"
                            PointerPressed="OnCategoryPointerPressed"
                            PointerReleased="OnCategoryPointerReleased"
                            PointerCanceled="OnCategoryPointerReleased"
                            Tag="UpdateSection"
                            Style="{StaticResource SettingsCategoryButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="CatUpdatesIcon" Grid.Column="0" Glyph="&#xE895;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CatUpdatesText" Grid.Column="1" Text="Updates" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="6,6,6,6" />

                    <!-- 7. About -->
                    <Button x:Name="CatAboutBtn"
                            Click="OnCategoryButtonClick"
                            PointerPressed="OnCategoryPointerPressed"
                            PointerReleased="OnCategoryPointerReleased"
                            PointerCanceled="OnCategoryPointerReleased"
                            Tag="AboutSection"
                            Style="{StaticResource SettingsCategoryButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="CatAboutIcon" Grid.Column="0" Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CatAboutText" Grid.Column="1" Text="About Reeled" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Centered Settings Content Scroll Viewer -->
            <ScrollViewer x:Name="SettingsScrollViewer"
                          Grid.Column="1"
                          Padding="32,16,32,0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ViewChanged="OnSettingsScrollViewerViewChanged">
                <StackPanel x:Name="SettingsContentRoot" HorizontalAlignment="Stretch" Margin="0">
                    <StackPanel x:Name="SettingsContentStack" MaxWidth="760" HorizontalAlignment="Center" Spacing="22">

                    <!-- ========================================== -->
                    <!-- 1. Watch Folders Section                   -->
                    <!-- ========================================== -->
                    <StackPanel x:Name="FoldersSection" Spacing="10">
                        <TextBlock x:Name="FoldersSectionTitle"
                                   Text="Watch Folders"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Margin="2,0,0,2" />

                        <!-- Main Folder Management Card (Windows 11 SettingsCard Style) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Card Icon (Clean without background pill) -->
                                <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />

                                <!-- Card Details -->
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="AddMediaFoldersTitle"
                                               Text="Add Media Folders" 
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" 
                                               FontSize="14" />
                                    <TextBlock x:Name="AddMediaFoldersSubtitle"
                                               Text="Directories scanned for MP4, MKV, and AVI gameplay clips" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <!-- Add Folder Action Button -->
                                <Button Grid.Column="2" 
                                        Click="OnAddFolderClick" 
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock x:Name="AddFolderButtonText" Text="Add Folder" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Sub-header for Scanned Directories -->
                        <TextBlock x:Name="ConfiguredDirectoriesHeader"
                                   Text="Configured Library Directories" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   Margin="2,4,0,0" />

                        <!-- Watch Folders Container (Recessed container with empty state or populated list) -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8">
                            <Grid>
                                <!-- Empty State View (Shown when no watch folders configured) -->
                                <StackPanel Visibility="{x:Bind ViewModel.WatchFolders.Count, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" 
                                            Spacing="8" 
                                            Margin="0,22,0,22">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="FoldersEmptyTitleText" Text="No folders added" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="15" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="FoldersEmptySubtitleText" Text="Add folders containing your video clips to start browsing your library." 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                               HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- Populated Directories List -->
                                <ListView ItemsSource="{x:Bind ViewModel.WatchFolders, Mode=OneWay}" 
                                          SelectionMode="None"
                                          Visibility="{x:Bind ViewModel.WatchFolders.Count, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0,2" />
                                            <Setter Property="MinHeight" Value="38" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid Margin="0,1" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Clickable Directory Anchor Link (Navigates to folder on HomePage) -->
                                                <Button Grid.Column="0" 
                                                        Click="OnDirectoryAnchorClick" 
                                                        Tag="{x:Bind}" 
                                                        ToolTipService.ToolTip="Jump to this folder in library" 
                                                        Style="{StaticResource DirectoryAnchorButtonStyle}">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Width="20" Height="20" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    </Grid>
                                                </Button>

                                                <!-- Remove Watch Folder Button -->
                                                <Button Grid.Column="1" 
                                                        Click="OnRemoveFolderClick" 
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="Remove Watch Folder" 
                                                        Style="{ThemeResource SubtleButtonStyle}"
                                                        Padding="8"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="6">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- Inline Status Banner for Folders (Cascading space reservation animation) -->
                        <Border x:Name="FoldersStatusBorder"
                                Height="0"
                                Opacity="0"
                                CornerRadius="6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Margin="0,2,0,0"
                                Padding="12,0"
                                HorizontalAlignment="Stretch">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="FoldersStatusTranslation" Y="-8" />
                            </Border.RenderTransform>
                            <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="FoldersStatusIcon" Grid.Column="0" Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="FoldersStatusText" Grid.Column="1" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- 2. Playback Options Section                -->
                    <!-- ========================================== -->
                    <StackPanel x:Name="PlaybackSection" Spacing="8">
                        <TextBlock x:Name="PlaybackSectionTitle"
                                   Text="Playback Options"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Margin="2,0,0,2" />

                        <!-- Card 1: Default Playback Speed -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Card Icon (Clean without background pill) -->
                                <FontIcon Grid.Column="0" Glyph="&#xEC57;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="DefaultSpeedTitleText" Text="Default Playback Speed" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="14" />
                                    <TextBlock x:Name="DefaultSpeedSubtitleText" Text="Initial rate applied whenever a clip begins playing" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ComboBox Grid.Column="2" 
                                          x:Name="DefaultSpeedComboBox"
                                          SelectionChanged="OnDefaultSpeedSelectionChanged"
                                          MinWidth="140"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="0.5x" Tag="0.5" />
                                    <ComboBoxItem Content="0.75x" Tag="0.75" />
                                    <ComboBoxItem Content="1.0x" Tag="1.0" />
                                    <ComboBoxItem Content="1.25x" Tag="1.25" />
                                    <ComboBoxItem Content="1.5x" Tag="1.5" />
                                    <ComboBoxItem Content="2.0x" Tag="2.0" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Card 2: Remember Last Playback Speed -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Card Icon (Clean without background pill) -->
                                <FontIcon Grid.Column="0" Glyph="&#xE823;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="RememberSpeedTitleText" Text="Remember Adjusted Playback Speed" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="14" />
                                    <TextBlock x:Name="RememberSpeedSubtitleText" Text="Keep the speed chosen in the player across clips instead of resetting" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ToggleSwitch Grid.Column="2" 
                                              IsOn="{x:Bind ViewModel.RememberPlaybackSpeed, Mode=TwoWay}" 
                                              OnContent="" 
                                              OffContent="" 
                                              MinWidth="0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Card 3: Default Playback Volume -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE767;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="DefaultVolumeTitleText" Text="Default playback volume" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="14" />
                                    <TextBlock x:Name="DefaultVolumeSubtitleText" Text="Initial audio volume level applied when opening video clips" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Slider x:Name="DefaultVolumeSlider"
                                            Minimum="0"
                                            Maximum="100"
                                            SmallChange="1"
                                            LargeChange="5"
                                            StepFrequency="1"
                                            Value="{x:Bind ViewModel.Volume, Mode=OneWay}"
                                            ValueChanged="OnDefaultVolumeSliderValueChanged"
                                            Width="130"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.VolumeFormatted, Mode=OneWay}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Width="40"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 4: Start Muted -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE74F;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="StartMutedTitleText" Text="Start muted" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="14" />
                                    <TextBlock x:Name="StartMutedSubtitleText" Text="Automatically mute audio when opening new video clips" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ToggleSwitch Grid.Column="2" 
                                              IsOn="{x:Bind ViewModel.StartMuted, Mode=TwoWay}" 
                                              OnContent="" 
                                              OffContent="" 
                                              MinWidth="0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Card 5: Default Repeat Mode -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE8EE;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="DefaultRepeatTitleText" Text="Default repeat mode" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="14" />
                                    <TextBlock x:Name="DefaultRepeatSubtitleText" Text="Playback behavior when reaching the end of a clip" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ComboBox Grid.Column="2" 
                                          x:Name="DefaultRepeatComboBox"
                                          SelectionChanged="OnDefaultRepeatSelectionChanged"
                                          MinWidth="180"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Card 6: Auto-Hide Controls Timeout -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE916;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="AutoHideTitleText" Text="Auto-hide controls timeout" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="14" />
                                    <TextBlock x:Name="AutoHideSubtitleText" Text="Fade out player controls after a period of mouse inactivity" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ComboBox Grid.Column="2" 
                                          x:Name="AutoHideTimeoutComboBox"
                                          SelectionChanged="OnAutoHideSelectionChanged"
                                          MinWidth="180"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Card 7: On-Screen Display (OSD) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xEA8F;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="OsdTitleText" Text="On-screen display (OSD)" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="14" />
                                    <TextBlock x:Name="OsdSubtitleText" Text="Show visual indicator toasts for volume, speed, and bookmark actions" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ToggleSwitch Grid.Column="2" 
                                              IsOn="{x:Bind ViewModel.EnableOsdNotifications, Mode=TwoWay}" 
                                              OnContent="" 
                                              OffContent="" 
                                              MinWidth="0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- 3. Appearance Section                      -->
                    <!-- ========================================== -->
                    <StackPanel x:Name="AppearanceSection" Spacing="8">
                        <TextBlock x:Name="AppearanceSectionTitle"
                                   Text="Appearance"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Margin="2,0,0,2" />

                        <!-- Card 1: App Theme -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Card Icon (Clean without background pill) -->
                                <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="AppThemeTitleText" Text="App Theme" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="14" />
                                    <TextBlock x:Name="AppThemeSubtitleText" Text="Select theme style or synchronize automatically with Windows" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ComboBox Grid.Column="2" 
                                          x:Name="ThemeComboBox"
                                          SelectionChanged="OnThemeSelectionChanged"
                                          MinWidth="160"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Card 2: Saved Moments Badges -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE8A4;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="MomentsBadgesTitleText" Text="Show saved moments badges" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="14" />
                                    <TextBlock x:Name="MomentsBadgesSubtitleText" Text="Display bookmark counter pill on video thumbnail cards in the library" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ToggleSwitch Grid.Column="2" 
                                              IsOn="{x:Bind ViewModel.ShowMomentsBadges, Mode=TwoWay}" 
                                              OnContent="" 
                                              OffContent="" 
                                              MinWidth="0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- 4. Language & Region Section               -->
                    <!-- ========================================== -->
                    <StackPanel x:Name="LocalizationSection" Spacing="8">
                        <TextBlock x:Name="LocalizationSectionTitle"
                                   Text="Language &amp; Region"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Margin="2,0,0,2" />

                        <!-- Card 1: App Language -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE774;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="AppLanguageTitleText" Text="App language" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="14" />
                                    <TextBlock x:Name="AppLanguageSubtitleText" Text="Select your preferred display language for menus and buttons" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ComboBox Grid.Column="2" 
                                          x:Name="LanguageComboBox"
                                          SelectionChanged="OnLanguageSelectionChanged"
                                          MinWidth="210"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Card 2: Regional Date & Time Format -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE823;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="DateFormatTitleText" Text="Regional date &amp; time format" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="14" />
                                    <TextBlock x:Name="DateFormatSubtitleText" Text="Dates, timestamps, and relative days are formatted to regional standards" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Border Grid.Column="2" 
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.SampleDateFormatPreview, Mode=OneWay}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- 5. Performance & Storage Section           -->
                    <!-- ========================================== -->
                    <StackPanel x:Name="StorageSection" Spacing="8">
                        <TextBlock x:Name="StorageSectionTitle"
                                   Text="Performance &amp; Storage"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Margin="2,0,0,2" />

                        <!-- Card 1: Skeleton Loading -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Card Icon (Clean without background pill) -->
                                <FontIcon Grid.Column="0" Glyph="&#xEE65;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="SkeletonLoadingTitleText" Text="Skeleton Loading Placeholders" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="14" />
                                    <TextBlock x:Name="SkeletonLoadingSubtitleText" Text="Display fluid placeholder cards while scanning folders or loading video items" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ToggleSwitch Grid.Column="2" 
                                              IsOn="{x:Bind ViewModel.EnableSkeletonLoading, Mode=TwoWay}" 
                                              OnContent="" 
                                              OffContent="" 
                                              MinWidth="0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Card 2: Clip Metadata Caching Toggle -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE74C;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="EnableClipCacheTitleText" Text="Clip metadata caching" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="14" />
                                    <TextBlock x:Name="EnableClipCacheSubtitleText" Text="Cache video properties locally to accelerate folder switching and indexing" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ToggleSwitch Grid.Column="2" 
                                              IsOn="{x:Bind ViewModel.EnableClipCache, Mode=TwoWay}" 
                                              OnContent="" 
                                              OffContent="" 
                                              MinWidth="0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Card 3: Thumbnail Cache -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Card Icon (Clean without background pill) -->
                                <FontIcon Grid.Column="0" Glyph="&#xEB9F;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="ThumbnailCacheTitleText" Text="Thumbnail Cache" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="14" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="ThumbnailCacheDiskLabel" Text="Disk storage used:" 
                                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.CacheSizeFormatted, Mode=OneWay}" 
                                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="2" 
                                        x:Name="ClearThumbnailsButton"
                                        Command="{x:Bind ViewModel.ClearCacheCommand}" 
                                        Content="Clear Thumbnails" 
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Card 3: Clip Metadata Cache -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Card Icon (Clean without background pill) -->
                                <FontIcon Grid.Column="0" Glyph="&#xE74C;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="ClipCacheTitleText" Text="Clip Metadata Cache" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="14" />
                                    <TextBlock x:Name="ClipCacheSubtitleText" Text="Speeds up library indexing and instant folder switching" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1,0,0">
                                        <TextBlock x:Name="ClipCacheStatusLabel" Text="Status:" 
                                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ClipCacheSizeFormatted, Mode=OneWay}" 
                                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="2" 
                                        x:Name="ClearClipCacheButton"
                                        Command="{x:Bind ViewModel.ClearClipCacheCommand}" 
                                        Content="Clear Metadata" 
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Card 4: Saved Moments Metadata -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Card Icon -->
                                <FontIcon Grid.Column="0" Glyph="&#xE8A4;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="StorageMomentsTitleText" Text="Saved Moments Metadata" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="14" />
                                    <TextBlock x:Name="StorageMomentsSubtitleText" Text="Clear all saved bookmark moments and highlight markers from your library clips" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1,0,0">
                                        <TextBlock x:Name="StorageMomentsStatusLabel" Text="Status:" 
                                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.MomentsStatsFormatted, Mode=OneWay}" 
                                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="2" 
                                        x:Name="ClearMomentsButton"
                                        Command="{x:Bind ViewModel.ClearMomentsMetadataCommand}" 
                                        Content="Clear Moments" 
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Inline Status Banner for Storage & Cache (Cascading space reservation animation) -->
                        <Border x:Name="StorageStatusBorder"
                                Height="0"
                                Opacity="0"
                                CornerRadius="6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Margin="0,2,0,0"
                                Padding="12,0"
                                HorizontalAlignment="Stretch">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="StorageStatusTranslation" Y="-8" />
                            </Border.RenderTransform>
                            <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="StorageStatusIcon" Grid.Column="0" Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="StorageStatusText" Grid.Column="1" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- 6. Updates Section                         -->
                    <!-- ========================================== -->
                    <StackPanel x:Name="UpdateSection" Spacing="8">
                        <TextBlock x:Name="UpdatesSectionTitle"
                                   Text="Updates"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Margin="2,0,0,2" />

                        <!-- Card 1: Main Update Status Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <FontIcon Grid.Column="0" Glyph="&#xE895;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.UpdateStatusFormatted, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="14" />
                                    <TextBlock Text="{x:Bind ViewModel.LastCheckedFormatted, Mode=OneWay}" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <!-- Check for updates button with loading circle ProgressRing -->
                                <Button Grid.Column="2" 
                                        x:Name="CheckUpdatesButton"
                                        Command="{x:Bind ViewModel.CheckForUpdatesCommand}" 
                                        IsEnabled="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                        VerticalAlignment="Center"
                                        Padding="14,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay}" 
                                                      Visibility="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      Width="14" Height="14" />
                                        <TextBlock x:Name="CheckUpdatesButtonText" Text="Check for updates" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Card 2: Update Available Card (Animated space reservation accordion with QuarticEase) -->
                        <Border x:Name="UpdateAvailableBorder"
                                Height="0"
                                Opacity="0"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1"
                                Padding="18,14"
                                HorizontalAlignment="Stretch">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="UpdateAvailableTranslation" Y="-10" />
                            </Border.RenderTransform>
                            <StackPanel Spacing="12">
                                <!-- Top Row: App Logo + Version (Left) & Patch Notes Link (Right) -->
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Image x:Name="UpdateLogoImage"
                                               Height="26" 
                                               Stretch="Uniform"
                                               VerticalAlignment="Center">
                                            <Image.Source>
                                                <SvgImageSource x:Name="UpdateLogoSvg" UriSource="ms-appx:///Assets/light-banner.svg" RasterizePixelHeight="78" />
                                            </Image.Source>
                                        </Image>
                                        <TextBlock Text="1.1.0" 
                                                   FontSize="15" 
                                                   FontWeight="SemiBold" 
                                                   VerticalAlignment="Center" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Patch Notes Link (Redirects to GitHub release page) -->
                                    <HyperlinkButton Grid.Column="1"
                                                     x:Name="PatchNotesHyperlink"
                                                     Click="OnPatchNotesClick"
                                                     Padding="8,4"
                                                     CornerRadius="6"
                                                     VerticalAlignment="Center"
                                                     ToolTipService.ToolTip="View GitHub release notes">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="PatchNotesText" 
                                                       Text="Release notes" 
                                                       FontSize="12.5" 
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" 
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                </Grid>

                                <!-- Release Notes / Summary -->
                                <TextBlock x:Name="UpdateAvailableNotes"
                                           Text="Includes Ukrainian localization, redesigned settings categories, and performance optimizations." 
                                           Style="{ThemeResource CaptionTextBlockStyle}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />

                                <!-- Action / Progress Transition Host -->
                                <Grid x:Name="UpdateTransitionHost" MinHeight="36">
                                    <!-- Progress section when downloading (Smooth animated entrance) -->
                                    <Border x:Name="UpdateProgressContainer"
                                            Opacity="0"
                                            Visibility="Collapsed"
                                            HorizontalAlignment="Stretch">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="ProgressTranslation" Y="6" />
                                        </Border.RenderTransform>
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <TextBlock Text="{x:Bind ViewModel.DownloadProgressFormatted, Mode=OneWay}" 
                                                           Style="{ThemeResource CaptionTextBlockStyle}" 
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                           HorizontalAlignment="Left" />
                                                <TextBlock Text="{x:Bind ViewModel.DownloadProgressDetailed, Mode=OneWay}" 
                                                           Style="{ThemeResource CaptionTextBlockStyle}" 
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" 
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar x:Name="UpdateDownloadProgressBar"
                                                         Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}" 
                                                         Maximum="100" 
                                                         Height="4" 
                                                         CornerRadius="2" 
                                                         HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Centered Action Buttons (Download & Install / Install and Restart) -->
                                    <Border x:Name="UpdateActionButtonsContainer"
                                            Opacity="1"
                                            Visibility="Visible"
                                            HorizontalAlignment="Center">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="ActionButtonsTranslation" Y="0" />
                                        </Border.RenderTransform>
                                        <Grid HorizontalAlignment="Center">
                                            <Button x:Name="DownloadUpdateButton" 
                                                    Command="{x:Bind ViewModel.DownloadUpdateCommand}"
                                                    Visibility="{x:Bind ViewModel.CanDownloadUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    Content="Download &amp; Install"
                                                    HorizontalAlignment="Center"
                                                    Padding="32,7"
                                                    CornerRadius="6" />

                                            <Button x:Name="InstallUpdateButton" 
                                                    Command="{x:Bind ViewModel.InstallUpdateCommand}"
                                                    Visibility="{x:Bind ViewModel.IsUpdateReadyToInstall, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    Content="Install and Restart"
                                                    HorizontalAlignment="Center"
                                                    Padding="32,7"
                                                    CornerRadius="6" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Auto-check Toggle Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE777;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="24" Height="24" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="AutoCheckUpdatesTitleText" Text="Check for updates automatically" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="14" />
                                    <TextBlock x:Name="AutoCheckUpdatesSubtitleText" Text="Periodically check for new releases in the background" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <ToggleSwitch Grid.Column="2" 
                                              IsOn="{x:Bind ViewModel.AutoCheckUpdates, Mode=TwoWay}" 
                                              OnContent="" 
                                              OffContent="" 
                                              MinWidth="0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Inline Status Banner for Updates (Cascading space reservation animation) -->
                        <Border x:Name="UpdatesStatusBorder"
                                Height="0"
                                Opacity="0"
                                CornerRadius="6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Margin="0,2,0,0"
                                Padding="12,0"
                                HorizontalAlignment="Stretch">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="UpdatesStatusTranslation" Y="-8" />
                            </Border.RenderTransform>
                            <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="UpdatesStatusIcon" Grid.Column="0" Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="UpdatesStatusText" Grid.Column="1" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    <!-- End of UpdateSection -->

                </StackPanel>
                <!-- End of SettingsContentStack (760px) -->

                    <!-- ========================================== -->
                    <!-- 7. Full-Width About Hero Section           -->
                    <!-- ========================================== -->
                    <StackPanel x:Name="AboutSection" HorizontalAlignment="Stretch" Margin="0,32,0,0" Spacing="8">
                        <TextBlock x:Name="AboutSectionTitle"
                                   Text="About Reeled"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Margin="2,0,0,2" />

                        <!-- Full-Width Website-Style Hero Banner Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1,1,1,0" 
                                CornerRadius="12,12,0,0" 
                                Padding="28,24"
                                HorizontalAlignment="Stretch">
                            <StackPanel Spacing="16">
                                <!-- Centered Branding Header & Attribution -->
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <!-- Much Bigger Centered App Logo -->
                                    <Image HorizontalAlignment="Center" 
                                           x:Name="SettingsLogoImage"
                                           Height="80" 
                                           Stretch="Uniform">
                                        <Image.Source>
                                            <SvgImageSource x:Name="SettingsLogoSvg" UriSource="ms-appx:///Assets/light-banner.svg" RasterizePixelHeight="256" />
                                        </Image.Source>
                                    </Image>

                                    <!-- Centered Tagline -->
                                    <TextBlock x:Name="AboutTaglineText"
                                               Text="Modern game clips viewer &amp; player for Windows" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                               FontSize="14" 
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center" />

                                    <!-- Centered Version & Framework Details -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock x:Name="AboutVersionText"
                                                   Text="Version 1.0.0 (.NET 8 Windows App SDK x64)" 
                                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="AboutFrameworkText"
                                                   Text="Built with WinUI 3, Windows App SDK &amp; LibVLC" 
                                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <!-- Author Attribution (No background pill, clean and centered) -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <FontIcon Glyph="&#xEB51;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="AboutCreatedByText"
                                                   Text="Created by k25jura" 
                                                   FontSize="12.5" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Live System & Debug Diagnostics Card -->
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,14"
                                        Margin="0,4,0,0">
                                    <StackPanel Spacing="12">
                                        <!-- Diagnostics Header & Copy Button -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock x:Name="AboutDiagnosticsTitleText"
                                                           Text="System &amp; Debug Diagnostics" 
                                                           Style="{ThemeResource BodyStrongTextBlockStyle}" 
                                                           FontSize="13.5" />
                                                <TextBlock x:Name="AboutDiagnosticsSubtitleText"
                                                           Text="Live runtime environment and library metrics" 
                                                           Style="{ThemeResource CaptionTextBlockStyle}" 
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    x:Name="CopyDiagnosticsButton"
                                                    Command="{x:Bind ViewModel.CopyDiagnosticsCommand}"
                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                    Padding="10,6"
                                                    CornerRadius="6"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="CopyDiagnosticsButtonText" Text="Copy Debug Info" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Inline Status Banner for Diagnostics Copy (Cascading space reservation animation) -->
                                        <Border x:Name="AboutStatusBorder"
                                                Height="0"
                                                Opacity="0"
                                                CornerRadius="6"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Margin="0,2,0,0"
                                                Padding="12,0"
                                                HorizontalAlignment="Stretch">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="AboutStatusTranslation" Y="-8" />
                                            </Border.RenderTransform>
                                            <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon x:Name="AboutStatusIcon" Grid.Column="0" Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="AboutStatusText" Grid.Column="1" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Diagnostics 2x2 Grid -->
                                        <Grid RowSpacing="10" ColumnSpacing="20">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Row 0, Col 0: OS -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                                <TextBlock x:Name="DiagOsLabel" Text="Operating System" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.OsVersionFormatted, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <!-- Row 0, Col 1: Architecture & Runtime -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                                <TextBlock x:Name="DiagArchLabel" Text="Architecture &amp; Runtime" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind ViewModel.ArchitectureFormatted, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind ViewModel.RuntimeFormatted, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Row 1, Col 0: Working Set Memory -->
                                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                                <TextBlock x:Name="DiagMemoryLabel" Text="Working Set Memory" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.MemoryUsageFormatted, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <!-- Row 1, Col 1: Library Stats -->
                                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                                <TextBlock x:Name="DiagLibraryLabel" Text="Library Stats" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.LibraryStatsFormatted, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4,0,2" />

                                <!-- Action Links & License Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Action Links (GitHub, Releases, Issues) -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <HyperlinkButton x:Name="AboutGithubButton"
                                                         Click="OnAboutGithubClick"
                                                         Padding="0">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE71B;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock x:Name="AboutGithubText" Text="GitHub Repository" FontSize="12.5" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </HyperlinkButton>

                                        <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />

                                        <HyperlinkButton x:Name="AboutReleasesButton"
                                                         Click="OnPatchNotesClick"
                                                         Padding="0">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE8A7;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock x:Name="AboutReleasesText" Text="Release Notes" FontSize="12.5" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </HyperlinkButton>

                                        <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />

                                        <HyperlinkButton x:Name="AboutIssuesButton"
                                                         Click="OnAboutIssuesClick"
                                                         Padding="0">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock x:Name="AboutIssuesText" Text="Report an Issue" FontSize="12.5" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </HyperlinkButton>
                                    </StackPanel>

                                    <!-- License Badge / Text -->
                                    <TextBlock Grid.Column="1"
                                               x:Name="AboutLicenseText"
                                               Text="GPL-3.0 Public License • Open Source"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
